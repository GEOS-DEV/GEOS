from geos.ats.test_builder import TestDeck, RestartcheckParameters, generate_geos_tests

restartcheck_params = {}
restartcheck_params["atol"] = 1.0E-6
restartcheck_params["rtol"] = 1.0E-5

decks = [
    TestDeck(name="lockExchange_rho",
             description="1D lock exchange test for compositional Soreide-Whitson EOS",
             partitions=((1, 1, 1), (2, 1, 2)),
             restart_step=20,
             check_step=30,
             restartcheck_params=RestartcheckParameters(atol=1e-4, rtol=1e-3)),
    TestDeck(name="lockExchange_Z",
             description="1D lock exchange test for compositional Soreide-Whitson EOS (Z-formulation)",
             partitions=((1, 1, 1), (2, 1, 2)),
             restart_step=30,
             check_step=40,
             restartcheck_params=RestartcheckParameters(atol=1e-4, rtol=1e-3))
]

generate_geos_tests(decks)
