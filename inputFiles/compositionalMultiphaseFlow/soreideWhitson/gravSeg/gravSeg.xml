		                                         temperatureCoordinates="{ 283.15, 334.15, 342.15, 346.15, 354.15 }"
		                                         waterCompressibility="4.1483E-10"/>
		<TableRelativePermeability name="RELPERM"
		                           phaseNames="{ oil, gas }"
		                           wettingNonWettingRelPermTableNames="{ KR, KR }"/>
	</Constitutive>
	<FieldSpecifications>
		<HydrostaticEquilibrium name="INITIALISATION"
		                        objectPath="ElementRegions"
		                        maxNumberOfEquilibrationIterations="20"
		                        datumElevation="-2000.0"
		                        datumPressure="2e+07"
		                        initialPhaseName="gas"
		                        componentNames="{ CH4, CO2, H2O }"
		                        componentFractionVsElevationTableNames="{ CH4_VD, CO2_VD, H2O_VD }"
		                        temperatureVsElevationTableName="TEMP_VS_DEPTH"/>
	</FieldSpecifications>
	<Outputs>
		<VTK name="VTK.OUTPUT" logLevel="2" />
		<Restart name="restart"/>
	</Outputs>
	<Tasks>
		<CompositionalMultiphaseStatistics name="FLOW.STATISTICS"
		                                   flowSolverName="FLOW.SOLVER"
		                                   logLevel="1"
