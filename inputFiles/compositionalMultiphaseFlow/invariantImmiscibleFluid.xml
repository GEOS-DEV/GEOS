<?xml version="1.0" ?>

<Problem>
  <Solvers
    gravityVector="{ 0.0, 0.0, 0.0 }">
    <CompositionalMultiphaseFVM
      name="FlowSolver"
      discretization="fluidTPFA"
      targetRegions="{ Domain }"
      logLevel="3"
      temperature="300">
      <NonlinearSolverParameters
        newtonTol="1.0e-10"
        newtonMaxIter="10"/>
      <LinearSolverParameters
        directParallel="0"/>
    </CompositionalMultiphaseFVM>
  </Solvers>
  
  <Mesh>
    <InternalMesh
      name="mesh1"
      elementTypes="{ C3D8 }"
      xCoords="{ 0, 10 }"
      yCoords="{ 0, 1 }"
      zCoords="{ 0, 1 }"
      nx="{ 10 }"
      ny="{ 1 }"
      nz="{ 1 }"
      cellBlockNames="{ blocks }"/>
  </Mesh>

  <Geometry>
    <Box
      name="source"
      xMin="{ -0.01, -0.01, -0.01 }"
      xMax="{ 1.01, 1.01, 1.01 }"/>

    <Box
      name="sink"
      xMin="{ 8.99, -0.01, -0.01 }"
      xMax="{ 10.01, 1.01, 1.01 }"/>
  </Geometry>

  <Events
    maxTime="2e3">
    <PeriodicEvent
      name="outputs"
      timeFrequency="100.0"
      target="/Outputs/vtkOutput"/>

    <PeriodicEvent
      name="solverApplications"
      forceDt="1e2"
      target="/Solvers/FlowSolver"/>

    <PeriodicEvent
      name="restarts"
      timeFrequency="1e3"
      targetExactTimestep="0"
      target="/Outputs/restartOutput"/>
  </Events>

  <NumericalMethods>
    <FiniteVolume>
      <TwoPointFluxApproximation
        name="fluidTPFA"/>
    </FiniteVolume>
  </NumericalMethods>

  <ElementRegions>
    <CellElementRegion
      name="Domain"
      cellBlocks="{ blocks }"
      materialList="{ fluid, rock, relperm }"/>
  </ElementRegions>

  <Constitutive>
    <!-- InvariantImmiscibleFluid example -->
    <InvariantImmiscibleFluid
      name="fluid"
      componentNames="{ CH4, H2O }"
      phaseNames="{ gas, water }"
      componentMolarWeight="{ 16.04, 18.02 }"
      densities="{ 0.656, 997.0 }"
      viscosities="{ 1.08e-5, 8.9e-4 }"/>

    <CompressibleSolidConstantPermeability
      name="rock"
      solidModelName="nullSolid"
      porosityModelName="rockPorosity"
      permeabilityModelName="rockPerm"/>

    <NullModel
      name="nullSolid"/>

    <PressurePorosity
      name="rockPorosity"
      defaultReferencePorosity="0.05"
      referencePressure="0.0"
      compressibility="1.0e-9"/>

    <ConstantPermeability
      name="rockPerm"
      permeabilityComponents="{ 2.0e-16, 2.0e-16, 2.0e-16 }"/>

    <BrooksCoreyRelativePermeability
      name="relperm"
      phaseNames="{ gas, water }"
      phaseMinVolumeFraction="{ 0.0, 0.0 }"
      phaseRelPermExponent="{ 1.5, 1.5 }"
      phaseRelPermMaxValue="{ 0.9, 0.9 }"/>
      
  </Constitutive>

  <FieldSpecifications>
    <FieldSpecification
      name="Porosity"
      initialCondition="1"
      setNames="{ all }"
      objectPath="ElementRegions/Domain"
      fieldName="rockPorosity_referencePorosity"
      scale="0.05"/>

    <FieldSpecification
      name="initialPressure"
      initialCondition="1"
      setNames="{ all }"
      objectPath="ElementRegions/Domain"
      fieldName="pressure"
      scale="1.0e6"/>

    <FieldSpecification
      name="initialComposition_CH4"
      initialCondition="1"
      setNames="{ all }"
      objectPath="ElementRegions/Domain"
      fieldName="globalCompFraction"
      component="0"
      scale="0.0"/>
    <FieldSpecification
      name="initialComposition_H2O"
      initialCondition="1"
      setNames="{ all }"
      objectPath="ElementRegions/Domain"
      fieldName="globalCompFraction"
      component="1"
      scale="1.0"/>      
      
    <FieldSpecification
      name="injectionPressure"
      initialCondition="0"
      setNames="{ source }"
      objectPath="ElementRegions/Domain"
      fieldName="pressure"
      scale="1.2e6"/>

    <FieldSpecification
      name="productionPressure"
      initialCondition="0"
      setNames="{ sink }"
      objectPath="ElementRegions/Domain"
      fieldName="pressure"
      scale="1.0e6"/>
  </FieldSpecifications>

  <Outputs>
    <VTK
      name="vtkOutput_InvariantFluid"/>
   <Restart
      name="restartOutput"/>
  </Outputs>

</Problem>