<?xml version="1.0" ?>

<Problem>
  <Included>
    <File name="./buckleyLeverett_base.xml"/>
  </Included>

  <Mesh>
    <InternalMesh
      name="mesh"
      elementTypes="{ C3D8 }"
      xCoords="{ 0, 0.1 }"
      yCoords="{ 0, 0.00202683 }"
      zCoords="{ 0, 1 }"
      nx="{ 100 }"
      ny="{ 1 }"
      nz="{ 1 }"
      cellBlockNames="{ cellBlock }"/>
  </Mesh>

  <Geometry>
    <Box
      name="source"
      xMin="{ 0.0, 0.0, 0.0 }"
      xMax="{ 0.001, 1.0, 1.0 }"/>

    <Box
      name="sink"
      xMin="{ 0.099, 0.0, 0.0 }"
      xMax="{ 0.1, 1.0, 1.0 }"/>
  </Geometry>

  <Events
    maxTime="1.0">
    
    <PeriodicEvent
      name="restarts"
      timeFrequency="0.4"
      targetExactTimestep="0"
      target="/Outputs/restartOutput"
    />

    <PeriodicEvent
      name="solverApplications"
      maxEventDt="0.1"
      target="/Solvers/compflow"/>    
  </Events>
</Problem>
