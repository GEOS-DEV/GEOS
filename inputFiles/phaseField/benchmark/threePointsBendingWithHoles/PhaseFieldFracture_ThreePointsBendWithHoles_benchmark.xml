<?xml version="1.0" ?>

<Problem>
  <Included>
    <File name="./PhaseFieldFracture_ThreePointsBendWithHoles_base.xml"/>
  </Included>

  <Solvers
    gravityVector="{ 0.0, 0.0, 0.0 }">
    <!-- SPHINX_PHASEFIELD_SOLVER -->
    <PhaseFieldFracture
      name="PhaseFieldSolve"
      solidSolverName="SolidMechSolve"
      damageSolverName="DamageSolve"
      logLevel="1"
      targetRegions="{ Region1 }">
      <NonlinearSolverParameters
        couplingType="Sequential"
        lineSearchAction="None"
        subcycling="0"/>
    </PhaseFieldFracture>
    <!-- SPHINX_PHASEFIELD_SOLVER_END -->

    <!-- SPHINX_SOLID_SOLVER -->
    <SolidMechanicsLagrangianFEM
      name="SolidMechSolve"
      logLevel="1"
      discretization="FE1"
      targetRegions="{ Region1 }">
      <NonlinearSolverParameters
        newtonMaxIter="200"
        lineSearchAction="None"
        newtonTol="1.0e-5"/>
      <LinearSolverParameters
        solverType="gmres"
        krylovTol="1e-5"
        preconditionerType="amg"/>
    </SolidMechanicsLagrangianFEM>
    <!-- SPHINX_SOLID_SOLVER_END -->

    <!-- SPHINX_DAMAGE_SOLVER -->
    <PhaseFieldDamageFEM
      name="DamageSolve"
      discretization="FE1"
      timeIntegrationOption="SteadyState"
      irreversibilityFlag="1"
      damageUpperBound="0.95"
      logLevel="1"
      targetRegions="{ Region1 }">
      <NonlinearSolverParameters
        newtonMaxIter="200"
        lineSearchAction="None"
        newtonTol="1.0e-8"/>
      <LinearSolverParameters
        solverType="gmres"
        preconditionerType="amg"/>
    </PhaseFieldDamageFEM>
    <!-- SPHINX_DAMAGE_SOLVER_END -->

    <SurfaceGenerator
      name="SurfaceGen"
      targetRegions="{ Region1 }"
      initialRockToughness="0"
      mpiCommOrder="1"/>
  </Solvers>

  <!-- SPHINX_MESH -->
  <Mesh>
    <VTKMesh
      name="ThreePointsBendWithHoles"
      file="../../../../../GEOSDATA/DataSets/PhaseField/threePointsBendWithHoles/threePointsBendingWithHoles.vtu"
      nodesetNames="{ support_left_line, support_right_line, load_line_full_thickness, starter_notch_shared_face_nodes }"/>
  </Mesh>
  <!-- SPHINX_MESH_END -->

  <!-- SPHINX_EVENTS -->
  <Geometry>
    <!-- Vertical slab between the left support (x = 1) and the starter notch (x = 4), where the shear force equals half of the
         applied load. Integrating the shear stress over it gives the reaction without
         relying on any nodal force field. -->
    <Box
      name="reactionCut"
      xMin="{ 2.0, -0.01, -0.06 }"
      xMax="{ 3.0, 8.01,  0.06 }"/>

  </Geometry>

  <!-- SPHINX_TASKS -->
  <Tasks>
    <PackCollection
      name="deflectionCollection"
      objectPath="nodeManager"
      fieldName="totalDisplacement"
      setNames="{ load_line_full_thickness }"/>

    <PackCollection
      name="cutStressCollection"
      objectPath="ElementRegions/Region1/hexahedra"
      fieldName="averageStress"
      setNames="{ reactionCut }"/>

    <PackCollection
      name="cutVolumeCollection"
      objectPath="ElementRegions/Region1/hexahedra"
      fieldName="elementVolume"
      setNames="{ reactionCut }"
      disableCoordCollection="1"/>
  </Tasks>
  <!-- SPHINX_TASKS_END -->

  <Events
    maxTime="67.23">
    <SoloEvent
      name="preFracture"
      target="/Solvers/SurfaceGen"/>

    <PeriodicEvent
      name="vtkOutput0"
      endTime="65.0"
      cycleFrequency="50"
      target="/Outputs/ThreePointsBendWithHoles_VTKOutput"/>
    
    <PeriodicEvent
      name="vtkOutput1"
      beginTime="65.0"
      endTime="67.2"
      cycleFrequency="20"
      target="/Outputs/ThreePointsBendWithHoles_VTKOutput"/>
    
    <PeriodicEvent
      name="vtkOutput2"
      beginTime="67.2"
      cycleFrequency="2"
      target="/Outputs/ThreePointsBendWithHoles_VTKOutput"/>

    <PeriodicEvent
      name="solverApplication0"
      endTime="65.0"
      maxEventDt="0.1"
      target="/Solvers/PhaseFieldSolve"/>

    <PeriodicEvent
      name="solverApplication1"
      beginTime="65.0"
      maxEventDt="0.001"
      target="/Solvers/PhaseFieldSolve"/>

    <!-- 650 steps at dt <= 0.1 then 2230 at dt <= 0.001: sampling every 25 cycles before
         the switch and every 100 after keeps both branches populated -->
    <PeriodicEvent
      name="deflectionCollection0"
      endTime="65.0"
      cycleFrequency="25"
      target="/Tasks/deflectionCollection"/>

    <PeriodicEvent
      name="deflectionCollection1"
      beginTime="65.0"
      cycleFrequency="100"
      target="/Tasks/deflectionCollection"/>

    <PeriodicEvent
      name="cutStressCollection0"
      endTime="65.0"
      cycleFrequency="25"
      target="/Tasks/cutStressCollection"/>

    <PeriodicEvent
      name="cutStressCollection1"
      beginTime="65.0"
      cycleFrequency="100"
      target="/Tasks/cutStressCollection"/>

    <PeriodicEvent
      name="cutVolumeCollection0"
      endTime="65.0"
      cycleFrequency="25"
      target="/Tasks/cutVolumeCollection"/>

    <PeriodicEvent
      name="cutVolumeCollection1"
      beginTime="65.0"
      cycleFrequency="100"
      target="/Tasks/cutVolumeCollection"/>

    <PeriodicEvent
      name="reactionHistoryOutput0"
      endTime="65.0"
      cycleFrequency="25"
      targetExactTimestep="0"
      target="/Outputs/reactionHistoryOutput"/>

    <PeriodicEvent
      name="reactionHistoryOutput1"
      beginTime="65.0"
      cycleFrequency="100"
      targetExactTimestep="0"
      target="/Outputs/reactionHistoryOutput"/>

    <PeriodicEvent
      name="restarts"
      cycleFrequency="100"
      target="/Outputs/restartOutput"/>
  </Events>
  <!-- SPHINX_EVENTS_END -->

  <Outputs>
    <VTK
      name="ThreePointsBendWithHoles_VTKOutput"
      plotFileRoot="threePointsBendWithHoles"/>

    <TimeHistory
      name="reactionHistoryOutput"
      sources="{ /Tasks/deflectionCollection, /Tasks/cutStressCollection, /Tasks/cutVolumeCollection }"
      filename="threePointsBendWithHoles_reactionCut"/>

    <Restart
      name="restartOutput"/>
  </Outputs>
</Problem>
