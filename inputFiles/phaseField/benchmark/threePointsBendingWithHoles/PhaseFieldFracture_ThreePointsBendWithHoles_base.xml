<?xml version="1.0" ?>

<Problem>
  <!-- SPHINX_BC -->
  <FieldSpecifications>
    <FieldSpecification
      name="loadPointDisplacement"
      fieldName="totalDisplacement"
      component="1"
      objectPath="nodeManager"
      scale="4.0e-3"
      functionName="loadRamp"
      setNames="{ load_line_full_thickness }"/>

    <FieldSpecification
      name="yConstraints"
      fieldName="totalDisplacement"
      component="1"
      objectPath="nodeManager"
      scale="0.0"
      setNames="{ support_left_line, support_right_line }"/>

    <FieldSpecification
      name="xConstraints"
      fieldName="totalDisplacement"
      component="0"
      objectPath="nodeManager"
      scale="0.0"
      setNames="{ support_left_line }"/>

    <FieldSpecification
      name="zConstraints"
      fieldName="totalDisplacement"
      component="2"
      objectPath="nodeManager"
      scale="0.0"
      setNames="{ midPlane }"/>

    <FieldSpecification
      name="contactDamageGuard"
      fieldName="damage"
      objectPath="nodeManager"
      scale="0.0"
      setNames="{ support_left_damage_guard, support_right_damage_guard, load_damage_guard }"/>

    <FieldSpecification
      name="separableFace"
      initialCondition="1"
      setNames="{ starter_notch_shared_face_nodes }"
      objectPath="faceManager"
      fieldName="isFaceSeparable"
      scale="1"/>

    <FieldSpecification
      name="frac"
      initialCondition="1"
      setNames="{ starter_notch_shared_face_nodes }"
      objectPath="faceManager"
      fieldName="ruptureState"
      scale="1"/>
  </FieldSpecifications>
  <!-- SPHINX_BC_END -->

  <!-- SPHINX_GEOMETRY -->
  <Geometry>
    <Box
      name="midPlane"
      xMin="{ -100.0, -100.0, -0.001 }"
      xMax="{ 100.0, 100.0, 0.001 }"/>

    <Box
      name="support_left_damage_guard"
      xMin="{ 0.50, -0.02, -0.051 }"
      xMax="{ 1.50, 0.60, 0.051 }"/>

    <Box
      name="support_right_damage_guard"
      xMin="{ 18.50, -0.02, -0.051 }"
      xMax="{ 19.50, 0.60, 0.051 }"/>

    <Box
      name="load_damage_guard"
      xMin="{ 9.50, 7.40, -0.051 }"
      xMax="{ 10.50, 8.02, 0.051 }"/>
  </Geometry>
  <!-- SPHINX_GEOMETRY_END -->

  <NumericalMethods>
    <FiniteElements>
      <FiniteElementSpace
        name="FE1"
        order="1"/>
    </FiniteElements>
  </NumericalMethods>

  <ElementRegions>
    <CellElementRegion
      name="Region1"
      cellBlocks="{ * }"
      materialList="{ concrete }"/>

    <SurfaceElementRegion
      name="Fracture"
      defaultAperture="1e-6"
      materialList="{ concrete }"/>
  </ElementRegions>

  <!-- SPHINX_MATERIAL -->
  <Constitutive>
    <DamageSpectralElasticIsotropic
      name="concrete"
      defaultDensity="1.0"
      defaultBulkModulus="1.73333333e4"
      defaultShearModulus="8e3"
      lengthScale="0.025"
      degradationLowerLimit="1e-4"
      defaultCriticalFractureEnergy="1.0"
      criticalStrainEnergy="0.0"
      fractureModelType="Brittle"
      localDissipationOption="Quadratic"/>
  </Constitutive>
  <!-- SPHINX_MATERIAL_END -->

  <!-- SPHINX_LOADING -->
  <Functions>
    <TableFunction
      name="loadRamp"
      inputVarNames="{ time }"
      coordinates="{ 0.0, 100 }"
      values="{ 0.0, -100.0 }"/>
  </Functions>
  <!-- SPHINX_LOADING_END -->
</Problem>
