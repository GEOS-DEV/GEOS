<?xml version="1.0" ?>

<Problem>
  <Solvers
    gravityVector="{ 0.0, 0.0, 0.0 }">
    <PhaseFieldFracture
      name="PhaseFieldSolve"
      solidSolverName="SolidMechSolve"
      damageSolverName="DamageSolve"
      logLevel="1"
      targetRegions="{ Region1 }">
      <NonlinearSolverParameters
        couplingType="Sequential"
        lineSearchAction="None"
        subcycling="0"/>
    </PhaseFieldFracture>

    <SolidMechanicsLagrangianFEM
      name="SolidMechSolve"
      logLevel="1"
      discretization="FE1"
      targetRegions="{ Region1 }">
      <NonlinearSolverParameters
        newtonMaxIter="200"
        lineSearchAction="None"
        newtonTol="1.0e-5"/>
      <LinearSolverParameters
        solverType="gmres"
        krylovTol="1e-5"
        preconditionerType="amg"/>
    </SolidMechanicsLagrangianFEM>

    <PhaseFieldDamageFEM
      name="DamageSolve"
      discretization="FE1"
      timeIntegrationOption="SteadyState"
      irreversibilityFlag="1"
      damageUpperBound="0.95"
      logLevel="1"
      targetRegions="{ Region1 }">
      <NonlinearSolverParameters
        newtonMaxIter="200"
        lineSearchAction="None"
        newtonTol="1.0e-8"/>
      <LinearSolverParameters
        solverType="gmres"
        preconditionerType="amg"/>
    </PhaseFieldDamageFEM>
  </Solvers>

  <Mesh>
    <VTKMesh
      name="ThreePointsBending"
      file="mesh/threePointsBendingSingleNotch.vtu"
      nodesetNames="{ support_left_line, support_right_line, load_line_full_thickness, starter_notch_flank_nodes }"/>
  </Mesh>

  <NumericalMethods>
    <FiniteElements>
      <FiniteElementSpace
        name="FE1"
        order="1"/>
    </FiniteElements>
  </NumericalMethods>

  <ElementRegions>
    <CellElementRegion
      name="Region1"
      cellBlocks="{ * }"
      materialList="{ concrete }"/>
  </ElementRegions>

  <Constitutive>
    <DamageSpectralElasticIsotropic
      name="concrete"
      defaultDensity="1.0"
      defaultBulkModulus="1.73333333e4"
      defaultShearModulus="8e3"
      lengthScale="0.03"
      degradationLowerLimit="1e-4"
      defaultCriticalFractureEnergy="0.5"
      criticalStrainEnergy="0.0"
      fractureModelType="Brittle"
      localDissipationOption="Quadratic"/>
  </Constitutive>

  <Functions>
    <TableFunction
      name="loadRamp"
      inputVarNames="{ time }"
      coordinates="{ 0.0, 1000.0 }"
      values="{ 0.0, -1000.0 }"/>
  </Functions>
</Problem>
