<?xml version="1.0" ?>

<Problem>
  <FieldSpecifications>
    <FieldSpecification
      name="loadPointDisplacement"
      fieldName="totalDisplacement"
      component="1"
      objectPath="nodeManager"
      scale="1.0e-4"
      functionName="loadRamp"
      setNames="{ load_line_full_thickness }"/>

    <FieldSpecification
      name="yConstraints"
      fieldName="totalDisplacement"
      component="1"
      objectPath="nodeManager"
      scale="0.0"
      setNames="{ support_left_line, support_right_line }"/>

    <FieldSpecification
      name="xConstraints"
      fieldName="totalDisplacement"
      component="0"
      objectPath="nodeManager"
      scale="0.0"
      setNames="{ support_left_line }"/>

    <FieldSpecification
      name="zConstraints"
      fieldName="totalDisplacement"
      component="2"
      objectPath="nodeManager"
      scale="0.0"
      setNames="{ midPlane }"/>

    <FieldSpecification
      name="contactDamageGuard"
      fieldName="damage"
      objectPath="nodeManager"
      scale="0.0"
      setNames="{ support_left_damage_guard, support_right_damage_guard, load_damage_guard }"/>
  </FieldSpecifications>

  <Geometry>
    <Box
      name="midPlane"
      xMin="{ -100.0, -100.0, -0.001 }"
      xMax="{ 100.0, 100.0, 0.001 }"/>

    <Box
      name="support_left_damage_guard"
      xMin="{ -0.25, -0.02, -0.051 }"
      xMax="{ 0.25, 0.20, 0.051 }"/>

    <Box
      name="support_right_damage_guard"
      xMin="{ 7.75, -0.02, -0.051 }"
      xMax="{ 8.25, 0.20, 0.051 }"/>

    <Box
      name="load_damage_guard"
      xMin="{ 3.75, 1.95, -0.051 }"
      xMax="{ 4.25, 2.02, 0.051 }"/>
  </Geometry>

  <NumericalMethods>
    <FiniteElements>
      <FiniteElementSpace
        name="FE1"
        order="1"/>
    </FiniteElements>
  </NumericalMethods>

  <ElementRegions>
    <CellElementRegion
      name="Region1"
      cellBlocks="{ * }"
      materialList="{ concrete }"/>
  </ElementRegions>

  <Constitutive>
    <DamageSpectralElasticIsotropic
      name="concrete"
      defaultDensity="1.0"
      defaultBulkModulus="1.73333333e4"
      defaultShearModulus="8e3"
      lengthScale="0.03"
      degradationLowerLimit="1e-4"
      defaultCriticalFractureEnergy="0.5"
      criticalStrainEnergy="0.0"
      fractureModelType="Brittle"
      localDissipationOption="Quadratic"/>
  </Constitutive>

  <Functions>
    <TableFunction
      name="loadRamp"
      inputVarNames="{ time }"
      coordinates="{ 0.0, 1000.0 }"
      values="{ 0.0, -1000.0 }"/>
  </Functions>
</Problem>
