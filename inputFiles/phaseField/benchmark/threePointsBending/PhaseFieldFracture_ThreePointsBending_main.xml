<?xml version="1.0" ?>

<Problem>
  <Included>
    <File name="./PhaseFieldFracture_ThreePointsBending_base.xml"/>
  </Included>

  <FieldSpecifications>
    <FieldSpecification
      name="loadPointDisplacement"
      fieldName="totalDisplacement"
      component="1"
      objectPath="nodeManager"
      scale="1.0e-4"
      functionName="loadRamp"
      setNames="{ load_line_full_thickness }"/>

    <FieldSpecification
      name="yConstraints"
      fieldName="totalDisplacement"
      component="1"
      objectPath="nodeManager"
      scale="0.0"
      setNames="{ support_left_line, support_right_line }"/>

    <FieldSpecification
      name="xConstraints"
      fieldName="totalDisplacement"
      component="0"
      objectPath="nodeManager"
      scale="0.0"
      setNames="{ support_left_line }"/>

    <FieldSpecification
      name="zConstraints"
      fieldName="totalDisplacement"
      component="2"
      objectPath="nodeManager"
      scale="0.0"
      setNames="{ midPlane }"/>

    <FieldSpecification
      name="contactDamageGuard"
      fieldName="damage"
      objectPath="nodeManager"
      scale="0.0"
      setNames="{ support_left_damage_guard, support_right_damage_guard, load_damage_guard }"/>
  </FieldSpecifications>

  <Geometry>
    <Box
      name="midPlane"
      xMin="{ -100.0, -100.0, -0.001 }"
      xMax="{ 100.0, 100.0, 0.001 }"/>

    <Box
      name="support_left_damage_guard"
      xMin="{ -0.25, -0.02, -0.051 }"
      xMax="{ 0.25, 0.20, 0.051 }"/>

    <Box
      name="support_right_damage_guard"
      xMin="{ 7.75, -0.02, -0.051 }"
      xMax="{ 8.25, 0.20, 0.051 }"/>

    <Box
      name="load_damage_guard"
      xMin="{ 3.75, 1.95, -0.051 }"
      xMax="{ 4.25, 2.02, 0.051 }"/>
  </Geometry>

  <Events
    maxTime="600.0">
    <PeriodicEvent
      name="vtkOutput0"
      endTime="360.0"
      cycleFrequency="10"
      target="/Outputs/ThreePointsBending_VTKOutput"/>

    <PeriodicEvent
      name="vtkOutput1"
      beginTime="360.0"
      cycleFrequency="100"
      target="/Outputs/ThreePointsBending_VTKOutput"/>

    <PeriodicEvent
      name="solverApplication0"
      endTime="360.0"
      maxEventDt="1.0"
      target="/Solvers/PhaseFieldSolve"/>

    <PeriodicEvent
      name="solverApplication1"
      beginTime="360.0"
      maxEventDt="0.01"
      target="/Solvers/PhaseFieldSolve"/>

    <PeriodicEvent
      name="restarts"
      cycleFrequency="500"
      target="/Outputs/restartOutput"/>
  </Events>

  <Outputs>
    <VTK
      name="ThreePointsBending_VTKOutput"
      plotFileRoot="threePointsBending"/>

    <Restart
      name="restartOutput"/>
  </Outputs>
</Problem>
