<?xml version="1.0" ?>

<Problem>
  <Included>
    <File name="./PhaseFieldFracture_SingleEdgeNotch_base_iterative.xml"/>
  </Included>

  <!-- SPHINX_MESH -->
  <Mesh>
    <InternalMesh
      name="SingleEdgeNotchTension"
      elementTypes="{ C3D8 }"
      xCoords="{ 0.0, 0.45, 0.5, 1.0 }"
      yCoords="{ 0.0, 0.45, 0.5, 0.55, 1.0 }"
      zCoords="{ -0.005, 0.005 }"
      nx="{ 50, 50, 500 }"
      ny="{ 30, 50, 50, 30 }"
      nz="{ 1 }"
      cellBlockNames="{ cb }"/>
  </Mesh>
  <!-- SPHINX_MESH_END -->

  <!-- SPHINX_BC -->
  <FieldSpecifications>
    <FieldSpecification
      name="topTensionDisplacement"
      fieldName="totalDisplacement"
      component="1"
      objectPath="nodeManager"
      scale="1.0e-5"
      functionName="loadRamp"
      setNames="{ ypos }"/>

    <FieldSpecification
      name="bottomYConstraint"
      fieldName="totalDisplacement"
      component="1"
      objectPath="nodeManager"
      scale="0.0"
      setNames="{ yneg }"/>

    <FieldSpecification
      name="bottomXConstraint"
      fieldName="totalDisplacement"
      component="0"
      objectPath="nodeManager"
      scale="0.0"
      setNames="{ yneg }"/>

    <FieldSpecification
      name="zConstraints"
      fieldName="totalDisplacement"
      component="2"
      objectPath="nodeManager"
      scale="0.0"
      setNames="{ all }"/>

    <FieldSpecification
      name="separableFace"
      initialCondition="1"
      setNames="{ initial_crack_nodes }"
      objectPath="faceManager"
      fieldName="isFaceSeparable"
      scale="1"/>

    <FieldSpecification
      name="frac"
      initialCondition="1"
      setNames="{ initial_crack_nodes }"
      objectPath="faceManager"
      fieldName="ruptureState"
      scale="1"/>
  </FieldSpecifications>
  <!-- SPHINX_BC_END -->

  <Geometry>
    <!-- Two nodes on the loaded edge. The imposed displacement is uniform along that
         edge, so probing one point of it is enough, and their reference positions give
         the height and the thickness of the specimen. -->
    <Box
      name="loadedEdgeProbe"
      xMin="{  0.999, 0.999, -0.01 }"
      xMax="{  1.001, 1.001,  0.01 }"/>

    <!-- Top row of elements, used to integrate the reaction force on the loaded
         boundary. An element belongs to a set only if all of its nodes do, so the
         box spans the two node lines of the top row (y = 0.985 and y = 1). -->
    <Box
      name="topRow"
      xMin="{ -0.01, 0.98, -0.01 }"
      xMax="{  1.01, 1.01,  0.01 }"/>

    <!-- SPHINX_GEOMETRY -->
    <Box
      name="initial_crack_nodes"
      xMin="{ -1.0e-7, 0.4999999, -0.0050001 }"
      xMax="{ 0.5000001, 0.5000001, 0.0050001 }"/>
    <!-- SPHINX_GEOMETRY_END -->
  </Geometry>

  <!-- SPHINX_TASKS -->
  <Tasks>
    <PackCollection
      name="topDisplacementCollection"
      objectPath="nodeManager"
      fieldName="totalDisplacement"
      setNames="{ loadedEdgeProbe }"/>

    <PackCollection
      name="topStressCollection"
      objectPath="ElementRegions/Region1/cb"
      fieldName="averageStress"
      setNames="{ topRow }"/>

    <PackCollection
      name="topVolumeCollection"
      objectPath="ElementRegions/Region1/cb"
      fieldName="elementVolume"
      setNames="{ topRow }"
      disableCoordCollection="1"/>
  </Tasks>
  <!-- SPHINX_TASKS_END -->

  <!-- SPHINX_EVENTS -->
  <Events
    maxTime="700.0">
    <SoloEvent
      name="preFracture"
      target="/Solvers/SurfaceGen"/>

    <PeriodicEvent
      name="vtkOutput"
      cycleFrequency="50"
      target="/Outputs/SingleEdgeNotchTension_VTKOutput"/>

    <PeriodicEvent
      name="solverApplication0"
      endTime="545.0"
      maxEventDt="1.0"
      target="/Solvers/PhaseFieldSolve"/>

    <PeriodicEvent
      name="solverApplication1"
      beginTime="545.0"
      maxEventDt="0.1"
      target="/Solvers/PhaseFieldSolve"/>

    <PeriodicEvent
      name="topDisplacementCollection"
      cycleFrequency="50"
      target="/Tasks/topDisplacementCollection"/>

    <PeriodicEvent
      name="topStressCollection"
      cycleFrequency="50"
      target="/Tasks/topStressCollection"/>

    <PeriodicEvent
      name="topVolumeCollection"
      cycleFrequency="50"
      target="/Tasks/topVolumeCollection"/>

    <PeriodicEvent
      name="topBoundaryHistoryOutput"
      cycleFrequency="50"
      targetExactTimestep="0"
      target="/Outputs/topBoundaryHistoryOutput"/>

    <PeriodicEvent
      name="restarts"
      cycleFrequency="500"
      target="/Outputs/restartOutput"/>
  </Events>
  <!-- SPHINX_EVENTS_END -->

  <Outputs>
    <VTK
      name="SingleEdgeNotchTension_VTKOutput"
      plotFileRoot="singleEdgeNotchTension"/>

    <TimeHistory
      name="topBoundaryHistoryOutput"
      sources="{ /Tasks/topDisplacementCollection, /Tasks/topStressCollection, /Tasks/topVolumeCollection }"
      filename="singleEdgeNotchTension_topBoundary"/>

    <Restart
      name="restartOutput"/>
  </Outputs>
</Problem>
