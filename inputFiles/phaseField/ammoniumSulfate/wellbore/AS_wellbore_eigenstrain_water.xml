<?xml version="1.0" ?>

<!-- Water control for AS_wellbore_eigenstrain_caseC.xml: the same deck with no reactive surface area,
     so nothing precipitates and the species are passive tracers. Screenout is read from AS - water.
     The AS composition is kept so the fluid, cooling and injection match the AS run exactly. -->
<Problem>
  <Included>
    <File name="./AS_wellbore_eigenstrain.xml"/>
    <File name="./AS_wellbore_logConc.xml"/>
  </Included>

  <FieldSpecifications>
    <FieldSpecification
      name="surfaceArea_rock"
      initialCondition="1"
      setNames="{ all }"
      objectPath="ElementRegions/Rock"
      fieldName="initialSurfaceArea"
      component="0"
      scale="0.0"/>
  </FieldSpecifications>

  <Events
    maxTime="40.0">
    <PeriodicEvent
      name="solverApplications0"
      endTime="13.0"
      maxEventDt="0.1"
      target="/Solvers/pfSolve"/>

    <PeriodicEvent
      name="solverApplications1"
      beginTime="13.0"
      endTime="25.0"
      maxEventDt="0.005"
      target="/Solvers/pfSolve"/>

    <PeriodicEvent
      name="solverApplications2"
      beginTime="25.0"
      maxEventDt="0.1"
      target="/Solvers/pfSolve"/>

    <PeriodicEvent
      name="vtkOutputEvent"
      cycleFrequency="10"
      target="/Outputs/vtkOutput"/>

    <PeriodicEvent
      name="sourcePressureHistoryCollection"
      cycleFrequency="1"
      target="/Tasks/sourcePressureCollection"/>
    <PeriodicEvent
      name="sourcePressureHistoryOutput"
      cycleFrequency="1"
      target="/Outputs/sourcePressureHistoryOutput"/>

    <PeriodicEvent
      name="restarts"
      cycleFrequency="50"
      target="/Outputs/restartOutput"/>
  </Events>
</Problem>
