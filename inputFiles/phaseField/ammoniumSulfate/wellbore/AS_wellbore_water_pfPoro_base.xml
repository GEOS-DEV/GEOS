<?xml version="1.0" ?>

<Problem>

  <!-- Bounds are +/-0.075 m in x and y, +/-0.5 mm in z: already in metres, so no scale attribute. -->
  <Mesh>
    <VTKMesh
      name="mesh"
      file="./meshes/wellboreFill2DMeterBased.vtu"
      regionAttribute="SOURCE-MATRIX"
      nodesetNames="{ xneg, xpos, yneg, ypos, zneg, zpos }"/>
  </Mesh>

  <NumericalMethods>
    <FiniteElements>
      <FiniteElementSpace
        name="FE1"
        order="1"/>
    </FiniteElements>

    <FiniteVolume>
      <TwoPointFluxApproximation
        name="singlePhaseTPFA"/>
    </FiniteVolume>
  </NumericalMethods>

  <!-- GEOS reads only the first <Constitutive> and <ElementRegions> blocks, so the case decks cannot
       add their own. This block holds both porous families on one set of solid and permeability
       models; each case deck's ElementRegions picks one.
         rockMat, voidMat, water                         monolithic (PorousDamage, BiotPorosity)
         rockMatReactive, voidMatReactive, waterReactive  sequential (PorousReactive, fixed stress)
       PorousDamageSolid has no fixed-stress update, so the sequential case runs on the reactive
       transport path with inert chemistry. -->
  <Constitutive>

    <!-- ================= ROCK ================= -->
    <!-- E = 40 GPa, nu = 0.23 => K = 24.6914e9, G = 16.2602e9.
         BRITTLE / AT1 (Linear dissipation), l = 0.5 mm, Gc = 12.5 J/m2, as in the AS decks: the same
         psi_c = 3 Gc / (16 l) as l = 0.1 mm, Gc = 2.5, at 5x the toughness. The mesh is 0.16 mm at the
         wall and ~0.5 mm at 60 mm, so the band is resolved (h <= l) out to ~50 mm.
         hybridSplit = 1: tension drives the crack through the spectral split, but the stress is degraded
         isotropically, so the mechanics tangent is exact and does not switch as strains change sign. -->
    <DamageSpectralElasticIsotropic
      name="rockSolid"
      defaultDensity="0.0"
      defaultBulkModulus="24.6914e9"
      defaultShearModulus="16.2602e9"
      lengthScale="0.0005"
      defaultCriticalFractureEnergy="12.5"
      criticalStrainEnergy="0.0"
      fractureModelType="Brittle"
      localDissipationOption="Linear"
      degradationLowerLimit="1e-6"
      hybridSplit="1"/>

    <!-- Matrix k = 5e-18 m2. Crack k = k exp(c d) with c = 8, ~1.5e-14 m2 at d = 1: the cubic-law value
         for a ~5 um opening spread over a ~1 mm damage band, as in the AS decks. -->
    <DamagePermeability
      name="rockPerm"
      bulkPermeability="5.0e-18"
      damageDependenceConstant="8.0"/>

    <!-- ================= BOREHOLE (soft "void") =================
         Same catalog type as the rock, only softer. At 1e-4 x rock stiffness the disc acts as a
         hole while keeping the stiffness matrix conditioned - do not push it to 1e-12. Biot b -> 1
         as K -> 0, so the region transmits pore pressure to the wall as a traction and no
         <Traction> BC is needed. The damage pin keeps it intact. -->
    <DamageSpectralElasticIsotropic
      name="voidSolid"
      defaultDensity="0.0"
      defaultBulkModulus="24.6914e6"
      defaultShearModulus="16.2602e6"
      lengthScale="0.0005"
      defaultCriticalFractureEnergy="12.5"
      criticalStrainEnergy="0.0"
      fractureModelType="Brittle"
      localDissipationOption="Linear"
      degradationLowerLimit="1.0"/>

    <DamagePermeability
      name="voidPerm"
      bulkPermeability="1.0e-10"
      damageDependenceConstant="0.0"/>

    <!-- ================= MONOLITHIC FAMILY ================= -->
    <PorousDamageSpectralElasticIsotropic
      name="rockMat"
      solidModelName="rockSolid"
      porosityModelName="rockPorosity"
      permeabilityModelName="rockPerm"/>

    <BiotPorosity
      name="rockPorosity"
      defaultGrainBulkModulus="24.6914e9"
      defaultReferencePorosity="0.05"/>

    <PorousDamageSpectralElasticIsotropic
      name="voidMat"
      solidModelName="voidSolid"
      porosityModelName="voidPorosity"
      permeabilityModelName="voidPerm"/>

    <BiotPorosity
      name="voidPorosity"
      defaultGrainBulkModulus="1e21"
      defaultReferencePorosity="0.9999"/>

    <!-- Plain water: rho = 1000, mu = 0.001. -->
    <CompressibleSinglePhaseFluid
      name="water"
      defaultDensity="1000"
      defaultViscosity="0.001"
      referencePressure="0.0"
      referenceDensity="1000"
      referenceViscosity="0.001"
      compressibility="1e-8"
      viscosibility="0.0"/>

    <!-- ================= SEQUENTIAL FAMILY =================
         Same porosity, grain modulus and fluid as above. The one-mineral entries are only there
         because the AS chemical system needs them; the case deck zeroes the surface area, so no
         mineral ever forms. -->
    <!-- crackFixedStressCompliance: pore compliance of a fully damaged cell for the fixed-stress split,
         scaled by damage. A crack's compliance comes from its opening, ~1e-9 /Pa for a 5 mm crack here;
         too small diverges, too large converges slowly. It vanishes at convergence. -->
    <PorousReactiveDamageSpectralElasticIsotropicDamagePermeability
      name="rockMatReactive"
      solidModelName="rockSolid"
      porosityModelName="rockPorosityReactive"
      permeabilityModelName="rockPerm"
      fluidModelName="waterReactive"
      crackFixedStressCompliance="5e-9"/>

    <BiotReactivePorosity
      name="rockPorosityReactive"
      defaultReferencePorosity="0.05"
      defaultInitialVolumeFractions="{ 0.0 }"
      molarWeights="{ 0.13214 }"
      mineralDensities="{ 1770.0 }"
      defaultGrainBulkModulus="24.6914e9"
      defaultMineralBulkModulus="0.0"/>

    <PorousReactiveDamageSpectralElasticIsotropicDamagePermeability
      name="voidMatReactive"
      solidModelName="voidSolid"
      porosityModelName="voidPorosityReactive"
      permeabilityModelName="voidPerm"
      fluidModelName="waterReactive"/>

    <BiotReactivePorosity
      name="voidPorosityReactive"
      defaultReferencePorosity="0.9999"
      defaultInitialVolumeFractions="{ 0.0 }"
      molarWeights="{ 0.13214 }"
      mineralDensities="{ 1770.0 }"
      defaultGrainBulkModulus="1e21"
      defaultMineralBulkModulus="0.0"/>

    <!-- The default solventMassFraction of 1 is a dilute solution. -->
    <ReactiveCompressibleSinglePhaseFluid
      name="waterReactive"
      defaultDensity="1000"
      defaultViscosity="0.001"
      referencePressure="0.0"
      referenceDensity="1000"
      compressibility="1e-8"
      viscosibility="0.0"
      chemicalSystemType="ammoniumSulfate"/>

  </Constitutive>

  <Geometry>
    <Box
      name="symX"
      xMin="{ -2.0e-5, -0.0751, -0.0006 }"
      xMax="{  2.0e-5,  0.0751,  0.0006 }"/>
    <Box
      name="symY"
      xMin="{ -0.0751, -2.0e-5, -0.0006 }"
      xMax="{  0.0751,  2.0e-5,  0.0006 }"/>

    <Cylinder
      name="boreCore"
      firstFaceCenter="{ 0.0, 0.0, -0.001 }"
      secondFaceCenter="{ 0.0, 0.0, 0.001 }"
      outerRadius="0.0062"/>
  </Geometry>

  <FieldSpecifications>

    <!-- ===== initial stress: zero =====
         The 0.15 m lab block is unconfined, so there is no in-situ stress to initialize. Zero also
         avoids starting mechanics and flow out of balance with no stress-initialization task. The
         outer faces are traction-free to match. -->
    <FieldSpecification
      name="Sh_rock"
      initialCondition="1"
      setNames="{ all }"
      objectPath="ElementRegions/Rock"
      fieldName="rockSolid_stress"
      component="0"
      scale="0.0"/>

    <FieldSpecification
      name="SH_rock"
      initialCondition="1"
      setNames="{ all }"
      objectPath="ElementRegions/Rock"
      fieldName="rockSolid_stress"
      component="1"
      scale="-1e5"/>

    <!-- <Traction
      name="Traction"
      objectPath="faceManager"
      tractionType="normal"
      scale="-1e5"
      setNames="{ ypos, yneg }"/> -->

    <FieldSpecification
      name="Sv_rock"
      initialCondition="1"
      setNames="{ all }"
      objectPath="ElementRegions/Rock"
      fieldName="rockSolid_stress"
      component="2"
      scale="0.0"/>

    <FieldSpecification
      name="S_void"
      initialCondition="1"
      setNames="{ all }"
      objectPath="ElementRegions/Source"
      fieldName="voidSolid_stress"
      component="0"
      scale="0.0"/>

    <!-- ===== damage: borehole core pinned at d = 0; no notch, the crack nucleates at the wall ===== -->
    <FieldSpecification
      name="damagePinBore"
      objectPath="nodeManager"
      fieldName="damage"
      scale="0.0"
      setNames="{ boreCore }"/>

    <!-- ===== displacement: traction-free outer faces, plane strain in z =====
         The sample is unconfined, so the side faces get no constraint at all - an absent
         FieldSpecification IS the traction-free condition. In-plane rigid-body modes are removed
         on the symmetry planes through the borehole axis, which add no confining reaction the way
         outer-face rollers would. This imposes mirror symmetry about both axes, so bi-wing planar
         and symmetric four-fold fractures are admissible and asymmetric ones are not. -->
    <FieldSpecification
      name="xconstraint"
      objectPath="nodeManager"
      fieldName="totalDisplacement"
      component="0"
      scale="0.0"
      setNames="{ symX }"/>

    <FieldSpecification
      name="yconstraint"
      objectPath="nodeManager"
      fieldName="totalDisplacement"
      component="1"
      scale="0.0"
      setNames="{ yneg, ypos }"/>

    <FieldSpecification
      name="zconstraint"
      objectPath="nodeManager"
      fieldName="totalDisplacement"
      component="2"
      scale="0.0"
      setNames="{ zneg, zpos }"/>

    <!-- ===== flow ===== -->
    <FieldSpecification
      name="initialPressure"
      initialCondition="1"
      setNames="{ all }"
      objectPath="ElementRegions"
      fieldName="pressure"
      scale="0.0"/>

    <!-- Outlet; without it pressure just accumulates. On faceManager, not on cells: a cell-based
         version pins pressure in a band of INTERIOR cells and stops them developing their own
         gradient. The sets are the mesh nodesets, which GEOS propagates to faces (a face joins the
         set when all its nodes do). -->
    <FieldSpecification
      name="outerPressure"
      setNames="{ xneg, xpos, yneg, ypos }"
      objectPath="faceManager"
      fieldName="pressure"
      scale="0.0"/>

    <!-- Mass injection; a negative scale is injection. Do NOT add a pressure Dirichlet on this set
         - Dirichlet is applied before SourceFlux and the two together corrupt the mass row.
         5 mL/min into a 50 mm interval, of which this 1 mm slice takes 1/50, at 1000 kg/m3:
         (5e-6/60)*(1/50)*1000 = 1.6667e-6 kg/s. -->
    <SourceFlux
      name="massInjection"
      objectPath="ElementRegions/Source"
      setNames="{ all }"
      scale="-1.6667e-6"/>

  </FieldSpecifications>

  <Tasks>
    <PackCollection
      name="sourcePressureCollection"
      objectPath="ElementRegions/Source/0_hexahedra"
      fieldName="pressure"/>
  </Tasks>

  <Events
    maxTime="40.0">
    <PeriodicEvent
      name="solverApplications0"
      endTime="17.0"
      maxEventDt="0.2"
      target="/Solvers/pfSolve"/>

    <PeriodicEvent
      name="solverApplications1"
      beginTime="17.0"
      endTime="20.7"
      maxEventDt="0.01"
      target="/Solvers/pfSolve"/>

    <PeriodicEvent
      name="solverApplications2"
      beginTime="20.7"
      maxEventDt="0.002"
      target="/Solvers/pfSolve"/>

    <PeriodicEvent
      name="vtkOutput"
      cycleFrequency="5"
      target="/Outputs/vtkOutput"/>

    <PeriodicEvent
      name="sourcePressureHistoryCollection"
      cycleFrequency="1"
      target="/Tasks/sourcePressureCollection"/>
    <PeriodicEvent
      name="sourcePressureHistoryOutput"
      cycleFrequency="1"
      target="/Outputs/sourcePressureHistoryOutput"/>

    <PeriodicEvent
      name="restarts"
      cycleFrequency="200"
      target="/Outputs/restartOutput"/>
  </Events>

  <Outputs>
    <VTK
      name="vtkOutput"
      plotLevel="1"/>

    <TimeHistory
      name="sourcePressureHistoryOutput"
      sources="{ /Tasks/sourcePressureCollection }"
      filename="sourcePressureHistory"/>

    <Restart
      name="restartOutput"/>
  </Outputs>

</Problem>
