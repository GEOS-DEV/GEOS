<?xml version="1.0" ?>

<Problem>
  <Solvers
    gravityVector="{ 0.0, 0.0, 0.0 }">
    <PhaseFieldFracture
      name="PhaseFieldSolve"
      solidSolverName="SolidMechSolve"
      damageSolverName="DamageSolve"
      logLevel="1"
      targetRegions="{ Region1 }">
      <NonlinearSolverParameters
        couplingType="Sequential"
        lineSearchAction="None"
        newtonMaxIter="100"/>
    </PhaseFieldFracture>

    <SolidMechanicsLagrangianFEM
      name="SolidMechSolve"
      logLevel="1"
      discretization="FE1"
      targetRegions="{ Region1 }"
      >
      <NonlinearSolverParameters
        newtonMaxIter="200"
        newtonTol="1.0e-12"/>
      <LinearSolverParameters
        directParallel="0"/>
    </SolidMechanicsLagrangianFEM>

    <PhaseFieldDamageFEM
      name="DamageSolve"
      discretization="FE1"
      timeIntegrationOption="SteadyState"
      fieldName="Damage"
      logLevel="1"
      targetRegions="{ Region1 }">
      <NonlinearSolverParameters
        newtonMaxIter="200"
        newtonTol="1.0e-12"/>
      <LinearSolverParameters
        directParallel="0"/>
    </PhaseFieldDamageFEM>
  </Solvers>

  <Mesh>
    <VTKMesh
      name="Mode2Notched"
      file="notchedMesh.vtk"/>
  </Mesh>

  <Geometry>
    <Box
      name="top"
      xMin="{ -0.01,  0.99, -0.01 }"
      xMax="{  1.01,  1.01,  0.11 }"/>

    <Box
      name="bottom"
      xMin="{ -0.01, -0.01, -0.01 }"
      xMax="{  1.01,  0.01,  0.11 }"/>

    <Box
      name="left"
      xMin="{ -0.01, -0.01, -0.01 }"
      xMax="{  0.01,  1.01,  0.11 }"/>

    <Box
      name="right"
      xMin="{  0.99, -0.01, -0.01 }"
      xMax="{  1.01, 1.01,  0.11 }"/>
  </Geometry>

  <NumericalMethods>
    <FiniteElements>
      <FiniteElementSpace
        name="FE1"
        order="1"/>
    </FiniteElements>
  </NumericalMethods>

  <ElementRegions>
    <CellElementRegion
      name="Region1"
      cellBlocks="{ * }"
      materialList="{ shale }"/>
  </ElementRegions>

  <FieldSpecifications>
    <FieldSpecification
      name="shearLoad"
      fieldName="totalDisplacement"
      component="0"
      objectPath="nodeManager"
      scale="1.00e-3"
      functionName="f_b"
      setNames="{ top }"/>

    <FieldSpecification
      name="fixedY"
      fieldName="totalDisplacement"
      component="1"
      objectPath="nodeManager"
      setNames="{ top, bottom, left, right }"/>

    <FieldSpecification
      name="fixedX"
      fieldName="totalDisplacement"
      component="0"
      objectPath="nodeManager"
      setNames="{ bottom }"/>

    <FieldSpecification
      name="fixedZ"
      fieldName="totalDisplacement"
      component="2"
      objectPath="nodeManager"
      setNames="{ top, bottom, left, right }"/>
  </FieldSpecifications>

  <Functions>
    <TableFunction
      name="f_b"
      inputVarNames="{ time }"
      coordinates="{ 0, 101 }"
      values="{ -1, 100 }"/>
  </Functions>

</Problem>