<?xml version="1.0" ?>

<!--
  Full-duration cooling counterpart of ThermoElasticOedometric_linearTEC_benchmark.xml: the temperature
  decreases from 90 to 0 over [0, 1e5]. Used by thermoElasticOedometricCoolingFigure.py.
-->
<Problem>
  <Solvers
    gravityVector="{ 0.0, 0.0, 0.0 }">
    <SinglePhasePoromechanics
      name="thermoElasticSolver"
      solidSolverName="solidMechSolver"
      flowSolverName="flowSolver"
      logLevel="1"
      isThermal="1"
      targetRegions="{ rock }">
      <NonlinearSolverParameters
        couplingType="FullyImplicit"
        maxAllowedResidualNorm="1e19"
        newtonMaxIter="100"/>
      <LinearSolverParameters
        directParallel="0"/>
    </SinglePhasePoromechanics>

    <SolidMechanicsLagrangianFEM
      name="solidMechSolver"
      timeIntegrationOption="QuasiStatic"
      logLevel="1"
      discretization="FE1"
      targetRegions="{ rock }"/>

    <SinglePhaseFVM
      name="flowSolver"
      logLevel="1"
      discretization="tpfaFlow"
      temperature="90"
      isThermal="1"
      targetRegions="{ rock }">
      <NonlinearSolverParameters
        normType="L2"/>
    </SinglePhaseFVM>
  </Solvers>

  <Mesh>
    <InternalMesh
      name="mesh1"
      elementTypes="{ C3D8 }"
      xCoords="{ 0, 0.1 }"
      yCoords="{ 0, 0.1 }"
      zCoords="{ 0, 0.1 }"
      nx="{ 2 }"
      ny="{ 2 }"
      nz="{ 2 }"
      cellBlockNames="{ rock }"/>
  </Mesh>

  <ElementRegions>
    <CellElementRegion
      name="rock"
      cellBlocks="{ rock }"
      materialList="{ fluid, rock_linearTEC, rockThermalCond }"/>
  </ElementRegions>

  <NumericalMethods>
    <FiniteElements>
      <FiniteElementSpace name="FE1" order="1"/>
    </FiniteElements>
    <FiniteVolume>
      <TwoPointFluxApproximation name="tpfaFlow"/>
    </FiniteVolume>
  </NumericalMethods>

  <Constitutive>
    <PorousElasticIsotropic
      name="rock_linearTEC"
      solidModelName="rockSolid_linearTEC"
      porosityModelName="rockPorosity"
      permeabilityModelName="rockPerm"
      solidInternalEnergyModelName="rockInternalEnergy"
      solidThermalExpansionModelName="rockTEC_linear"/>

    <BiotPorosity
      name="rockPorosity"
      defaultReferencePorosity="1e-6"
      defaultGrainBulkModulus="1.0e11"/>

    <SolidInternalEnergy
      name="rockInternalEnergy"
      referenceVolumetricHeatCapacity="4.56e6"
      referenceTemperature="0"
      referenceInternalEnergy="0"/>

    <ConstantPermeability
      name="rockPerm"
      permeabilityComponents="{ 1.0e-100, 1.0e-100, 1.0e-100 }"/>

    <SinglePhaseThermalConductivity
      name="rockThermalCond"
      defaultThermalConductivityComponents="{ 1.66, 1.66, 1.66 }"/>

    <ThermalCompressibleSinglePhaseFluid
      name="fluid"
      defaultDensity="1000"
      defaultViscosity="1e-3"
      referencePressure="0.0"
      referenceTemperature="20.0"
      compressibility="5e-10"
      thermalExpansionCoeff="1e-10"
      viscosibility="0.0"
      specificHeatCapacity="1"
      referenceInternalEnergy="1"/>

    <ElasticIsotropic
      name="rockSolid_linearTEC"
      defaultDensity="2700"
      defaultBulkModulus="9.12345679e9"
      defaultShearModulus="6.00813e9"/>

    <SolidThermalExpansion
      name="rockTEC_linear"
      referenceDrainedLinearTEC="0.2e-5"
      dDrainedLinearTEC_dTemperature="0.0164e-5"
      referenceTemperature="0"/>
  </Constitutive>

  <FieldSpecifications>
    <FieldSpecification
      name="constraint_x"
      objectPath="nodeManager"
      fieldName="totalDisplacement"
      component="0"
      scale="0.0"
      setNames="{ xneg, xpos }"/>

    <FieldSpecification
      name="constraint_y"
      objectPath="nodeManager"
      fieldName="totalDisplacement"
      component="1"
      scale="0.0"
      setNames="{ yneg, ypos }"/>

    <FieldSpecification
      name="zConstraint"
      objectPath="nodeManager"
      fieldName="totalDisplacement"
      component="2"
      scale="0.0"
      setNames="{ zneg }"/>

    <FieldSpecification
      name="initialSigma_x_rock"
      initialCondition="1"
      setNames="{ all }"
      objectPath="ElementRegions/rock/rock"
      fieldName="rockSolid_linearTEC_stress"
      component="0"
      scale="0"/>
    <FieldSpecification
      name="initialSigma_y_rock"
      initialCondition="1"
      setNames="{ all }"
      objectPath="ElementRegions/rock/rock"
      fieldName="rockSolid_linearTEC_stress"
      component="1"
      scale="0"/>
    <FieldSpecification
      name="initialSigma_z_rock"
      initialCondition="1"
      setNames="{ all }"
      objectPath="ElementRegions/rock/rock"
      fieldName="rockSolid_linearTEC_stress"
      component="2"
      scale="0"/>

    <FieldSpecification
      name="zeroPressure"
      setNames="{ all }"
      objectPath="ElementRegions"
      fieldName="pressure"
      scale="0e6"/>

    <FieldSpecification
      name="initialTemperature"
      initialCondition="1"
      setNames="{ all }"
      objectPath="ElementRegions"
      fieldName="temperature"
      scale="90"/>

    <FieldSpecification
      name="appliedTemperature"
      setNames="{ all }"
      objectPath="ElementRegions"
      fieldName="temperature"
      scale="1"
      functionName="temperatureTable"/>
  </FieldSpecifications>

  <Functions>
    <TableFunction
      name="temperatureTable"
      inputVarNames="{ time }"
      coordinates="{ 0.0, 1.0e5 }"
      values="{ 90, 0 }"/>
  </Functions>

  <Tasks>
    <PackCollection
      name="temperatureCollection_rock"
      objectPath="ElementRegions/rock/rock"
      fieldName="temperature"/>

    <PackCollection
      name="stressCollection_rock"
      objectPath="ElementRegions/rock/rock"
      fieldName="rockSolid_linearTEC_stress"/>
  </Tasks>

  <Outputs>
    <TimeHistory
      name="temperatureHistoryOutput_rock"
      sources="{ /Tasks/temperatureCollection_rock }"
      filename="coolingTemperatureHistory_rock"/>

    <TimeHistory
      name="stressHistoryOutput_rock"
      sources="{ /Tasks/stressCollection_rock }"
      filename="coolingStressHistory_rock"/>

    <VTK name="vtkOutput"/>
    <Restart name="restartOutput"/>
  </Outputs>

  <Events maxTime="1e5">
    <PeriodicEvent
      name="stressHistoryCollection_rock"
      endTime="1e5"
      forceDt="1e4"
      target="/Tasks/stressCollection_rock"/>
    <PeriodicEvent
      name="stressTimeHistoryOutput_rock"
      endTime="1e5"
      forceDt="1e4"
      target="/Outputs/stressHistoryOutput_rock"/>
    <PeriodicEvent
      name="temperatureHistoryCollection_rock"
      endTime="1e5"
      forceDt="1e4"
      target="/Tasks/temperatureCollection_rock"/>
    <PeriodicEvent
      name="temperatureTimeHistoryOutput_rock"
      endTime="1e5"
      forceDt="1e4"
      target="/Outputs/temperatureHistoryOutput_rock"/>
    <PeriodicEvent
      name="outputs"
      timeFrequency="1e4"
      target="/Outputs/vtkOutput"/>
    <PeriodicEvent
      name="solverApplications"
      maxEventDt="1e3"
      target="/Solvers/thermoElasticSolver"/>
  </Events>
</Problem>
