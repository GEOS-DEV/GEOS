<?xml version="1.0" ?>

<!-- Cooling of a laterally confined column by conduction, with a tabulated, temperature-dependent solid thermal
     expansion coefficient. The column (along x) starts at 90 and its end x = 0 is held at 0; the other end is
     insulated and free to move. The fluid and the solid have the same volumetric heat capacity, so that the
     energy balance does not depend on porosity and the temperature is the classical series solution of the heat
     equation. The lateral stress at each point is then -E / ( 1 - nu ) times the integral of alpha from 90 to the
     local temperature, which gives a reference for a mesh-convergence study (see the validation example). -->
<Problem>
  <Solvers
    gravityVector="{ 0.0, 0.0, 0.0 }">
    <SinglePhasePoromechanics
      name="thermoPoroSolver"
      solidSolverName="solidMechSolver"
      flowSolverName="flowSolver"
      logLevel="1"
      isThermal="1"
      targetRegions="{ column }">
      <NonlinearSolverParameters
        couplingType="FullyImplicit"
        newtonTol="1.0e-12"
        newtonMaxIter="20"/>
      <LinearSolverParameters
        directParallel="0"/>
    </SinglePhasePoromechanics>

    <SolidMechanicsLagrangianFEM
      name="solidMechSolver"
      timeIntegrationOption="QuasiStatic"
      logLevel="1"
      discretization="FE1"
      targetRegions="{ column }"/>

    <SinglePhaseFVM
      name="flowSolver"
      logLevel="1"
      discretization="tpfaFlow"
      temperature="90"
      isThermal="1"
      targetRegions="{ column }"/>
  </Solvers>

  <NumericalMethods>
    <FiniteElements>
      <FiniteElementSpace
        name="FE1"
        order="1"/>
    </FiniteElements>

    <FiniteVolume>
      <TwoPointFluxApproximation
        name="tpfaFlow"/>
    </FiniteVolume>
  </NumericalMethods>

  <ElementRegions>
    <CellElementRegion
      name="column"
      cellBlocks="{ column }"
      materialList="{ fluid, rock, rockThermalCond }"/>
  </ElementRegions>

  <Constitutive>
    <PorousElasticIsotropic
      name="rock"
      solidModelName="rockSolid"
      porosityModelName="rockPorosity"
      permeabilityModelName="rockPerm"
      solidInternalEnergyModelName="rockInternalEnergy"
      solidThermalExpansionModelName="rockTEC"/>

    <ElasticIsotropic
      name="rockSolid"
      defaultDensity="2700"
      defaultBulkModulus="9.12345679e9"
      defaultShearModulus="6.00813e9"/>

    <BiotPorosity
      name="rockPorosity"
      defaultReferencePorosity="0.2"
      defaultGrainBulkModulus="1.0e11"/>

    <SolidThermalExpansion
      name="rockTEC"
      drainedLinearTECTableName="tecTable"/>

    <!-- SPHINX_ColumnHeatCapacities -->
    <!-- same volumetric heat capacity, 1e6, for the solid and the fluid ( 1000 * 1000 ) -->
    <SolidInternalEnergy
      name="rockInternalEnergy"
      referenceVolumetricHeatCapacity="1.0e6"
      referenceTemperature="0"
      referenceInternalEnergy="0"/>

    <ThermalCompressibleSinglePhaseFluid
      name="fluid"
      defaultDensity="1000"
      defaultViscosity="1e-3"
      referencePressure="0.0"
      referenceTemperature="0.0"
      compressibility="0.0"
      thermalExpansionCoeff="0.0"
      viscosibility="0.0"
      specificHeatCapacity="1000"
      referenceInternalEnergy="1.0e-3"/>

    <SinglePhaseThermalConductivity
      name="rockThermalCond"
      defaultThermalConductivityComponents="{ 1.0, 1.0, 1.0 }"/>
    <!-- SPHINX_ColumnHeatCapacitiesEnd -->

    <ConstantPermeability
      name="rockPerm"
      permeabilityComponents="{ 1.0e-18, 1.0e-18, 1.0e-18 }"/>
  </Constitutive>

  <FieldSpecifications>
    <!-- uniaxial strain along x: fixed at x = 0, free at x = L, confined in y and z -->
    <FieldSpecification
      name="constraint_x"
      objectPath="nodeManager"
      fieldName="totalDisplacement"
      component="0"
      scale="0.0"
      setNames="{ xneg }"/>

    <FieldSpecification
      name="constraint_y"
      objectPath="nodeManager"
      fieldName="totalDisplacement"
      component="1"
      scale="0.0"
      setNames="{ yneg, ypos }"/>

    <FieldSpecification
      name="constraint_z"
      objectPath="nodeManager"
      fieldName="totalDisplacement"
      component="2"
      scale="0.0"
      setNames="{ zneg, zpos }"/>

    <FieldSpecification
      name="initialSigma_x"
      initialCondition="1"
      setNames="{ all }"
      objectPath="ElementRegions/column/column"
      fieldName="rockSolid_stress"
      component="0"
      scale="0"/>
    <FieldSpecification
      name="initialSigma_y"
      initialCondition="1"
      setNames="{ all }"
      objectPath="ElementRegions/column/column"
      fieldName="rockSolid_stress"
      component="1"
      scale="0"/>
    <FieldSpecification
      name="initialSigma_z"
      initialCondition="1"
      setNames="{ all }"
      objectPath="ElementRegions/column/column"
      fieldName="rockSolid_stress"
      component="2"
      scale="0"/>

    <!-- drained: the pressure is held at zero everywhere, so no fluid flows -->
    <FieldSpecification
      name="initialPressure"
      initialCondition="1"
      setNames="{ all }"
      objectPath="ElementRegions"
      fieldName="pressure"
      scale="0"/>
    <FieldSpecification
      name="fixedPressure"
      setNames="{ all }"
      objectPath="ElementRegions"
      fieldName="pressure"
      scale="0"/>

    <FieldSpecification
      name="initialTemperature"
      initialCondition="1"
      setNames="{ all }"
      objectPath="ElementRegions"
      fieldName="temperature"
      scale="90"/>
    <!-- a face condition needs both the pressure and the temperature -->
    <FieldSpecification
      name="coldEndPressure"
      setNames="{ xneg }"
      objectPath="faceManager"
      fieldName="pressure"
      scale="0"/>
    <FieldSpecification
      name="coldEnd"
      setNames="{ xneg }"
      objectPath="faceManager"
      fieldName="temperature"
      scale="0"/>
  </FieldSpecifications>

  <Functions>
    <!-- the kinked table of the drained oedometric tests; the column crosses all three kinks -->
    <TableFunction
      name="tecTable"
      inputVarNames="{ temperature }"
      coordinates="{ 0.0, 20.0, 50.0, 70.0 }"
      values="{ 0.2e-5, 0.5e-5, 0.6e-5, 1.6e-5 }"/>
  </Functions>

  <Tasks>
    <PackCollection
      name="temperatureCollection"
      objectPath="ElementRegions/column/column"
      fieldName="temperature"/>
    <PackCollection
      name="stressCollection"
      objectPath="ElementRegions/column/column"
      fieldName="rockSolid_stress"/>
    <PackCollection
      name="displacementCollection"
      objectPath="nodeManager"
      fieldName="totalDisplacement"/>
  </Tasks>

  <Outputs>
    <TimeHistory
      name="historyOutput"
      sources="{ /Tasks/temperatureCollection, /Tasks/stressCollection }"
      filename="columnHistory"/>
    <TimeHistory
      name="displacementHistoryOutput"
      sources="{ /Tasks/displacementCollection }"
      filename="columnDisplacementHistory"/>

    <Restart
      name="restartOutput"/>
  </Outputs>
</Problem>
