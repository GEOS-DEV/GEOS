<?xml version="1.0" ?>

<!-- Adaptive mixed MFD on a subset of the regions of the hybrid mesh: the solver targets the hexahedra only, so the
     interface with the pyramids is a no-flow boundary of the target regions. Pressure is imposed on the faces x = 0 and
     x = 1; the exact solution is linear in x on the hexahedra. Gravity is off. -->

<Problem>

  <Mesh>
    <VTKMesh
      name="hybridMesh"
      file="hybrid_mesh_l_0.vtu"
      partitionRefinement="0"
      useGlobalIds="0"/>
  </Mesh>

  <Geometry>
    <Box
      name="inlet"
      xMin="{ -0.01, -0.01, -0.01 }"
      xMax="{  0.01,  1.01,  2.01 }"/>
    <Box
      name="outlet"
      xMin="{ 0.99, -0.01, -0.01 }"
      xMax="{ 1.01,  1.01,  2.01 }"/>
  </Geometry>

  <Solvers
    gravityVector="{ 0.0, 0.0, 0.0 }">
    <SinglePhaseMixedMFD
      name="mixedMFDFlow"
      logLevel="1"
      discretization="mixedMFD"
      targetRegions="{ hexahedra }">
      <NonlinearSolverParameters
        newtonTol="1.0e-6"
        newtonMaxIter="8"/>
      <LinearSolverParameters
        directParallel="0"/>
    </SinglePhaseMixedMFD>
  </Solvers>

  <NumericalMethods>
    <MixedMimetic>
      <MixedMimeticDiscretization
        name="mixedMFD"
        innerProductType="RT"
        adaptiveConsistency="1"
        consistencyTolerance="0.1"
        nominalGradient="{ 1.0, 1.0, 1.0 }"/>
    </MixedMimetic>
  </NumericalMethods>

  <!-- the cell blocks of a VTK mesh without a region attribute are named by element type -->
  <ElementRegions>
    <CellElementRegion
      name="hexahedra"
      cellBlocks="{ hexahedra }"
      materialList="{ fluid, rock }"/>
    <CellElementRegion
      name="others"
      cellBlocks="{ pyramids, tetrahedra }"
      materialList="{ fluid, rock }"/>
  </ElementRegions>

  <Constitutive>
    <CompressibleSinglePhaseFluid
      name="fluid"
      defaultDensity="1000.0"
      referenceDensity="1000.0"
      defaultViscosity="0.001"
      referenceViscosity="0.001"
      referencePressure="2.0e7"
      compressibility="0.0"
      viscosibility="0.0"/>

    <CompressibleSolidConstantPermeability
      name="rock"
      solidModelName="nullSolid"
      porosityModelName="rockPorosity"
      permeabilityModelName="rockPerm"/>

    <NullModel
      name="nullSolid"/>

    <PressurePorosity
      name="rockPorosity"
      defaultReferencePorosity="0.2"
      referencePressure="2.0e7"
      compressibility="0.0"/>

    <ConstantPermeability
      name="rockPerm"
      permeabilityComponents="{ 1.0e-14, 1.0e-14, 1.0e-14 }"/>
  </Constitutive>

  <FieldSpecifications>
    <FieldSpecification
      name="initialPressure"
      initialCondition="1"
      setNames="{ all }"
      objectPath="ElementRegions/hexahedra"
      fieldName="pressure"
      scale="2.0e7"/>

    <FieldSpecification
      name="inletPressure"
      setNames="{ inlet }"
      objectPath="faceManager"
      fieldName="bcPressure"
      scale="2.0e7"/>

    <FieldSpecification
      name="outletPressure"
      setNames="{ outlet }"
      objectPath="faceManager"
      fieldName="bcPressure"
      scale="1.0e7"/>
  </FieldSpecifications>

  <!-- one step: the problem is steady and linear -->
  <Events
    maxTime="1.0e3">
    <PeriodicEvent
      name="outputs"
      timeFrequency="1.0e3"
      target="/Outputs/vtkOutput"/>

    <PeriodicEvent
      name="solverApplications"
      forceDt="1.0e3"
      target="/Solvers/mixedMFDFlow"/>

    <PeriodicEvent
      name="restarts"
      timeFrequency="1.0e3"
      targetExactTimestep="0"
      target="/Outputs/restartOutput"/>
  </Events>

  <Outputs>
    <VTK
      name="vtkOutput"
      fieldNames="{ pressure, mfdFlag }"/>

    <Restart
      name="restartOutput"/>
  </Outputs>

</Problem>
