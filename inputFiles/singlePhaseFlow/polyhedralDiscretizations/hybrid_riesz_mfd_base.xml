<?xml version="1.0" ?>
<!-- shared setup of the hybrid (hex + pyramid + tet) mesh family; the per-level files add the mesh -->
<Problem>


  <Solvers>

    <SinglePhaseMixedMFD
      name="mfdFlow"
      logLevel="1"
      discretization="mfdDiscretization"
      targetRegions="{ domain }">
      <NonlinearSolverParameters
        newtonTol="1.0e-3"
        newtonMaxIter="10"/>
      <LinearSolverParameters
        solverType="fgmres"
        preconditionerType="riesz"
        krylovTol="1.0e-5"
        logLevel="1"/>
    </SinglePhaseMixedMFD>

  </Solvers>

  <NumericalMethods>
    <MixedMimetic>
      <!-- residualTolerance: 1.0e+20 full TPFA, 1.0e-20 full MFD, 1.0 mixed -->
      <MixedMimeticDiscretization
        name="mfdDiscretization"
        innerProductType="RT"
        adaptive="1"
        residualTolerance="1.0e-30"
        nominalGradient="{ 1.0, 1.0, 1.0 }"/>
    </MixedMimetic>
  </NumericalMethods>


  <!-- box [0,1] x [0,1] x [0,2]: inlet on the west face x = 0, outlet on the east face x = 1 -->
  <Geometry>
    <Box
      name="inlet"
      xMin="{ -0.01, -0.01, -0.01 }"
      xMax="{  0.01,  1.01,  2.01 }"/>
    <Box
      name="outlet"
      xMin="{ 0.99, -0.01, -0.01 }"
      xMax="{ 1.01,  1.01,  2.01 }"/>
  </Geometry>

  <ElementRegions>
    <CellElementRegion
      name="domain"
      cellBlocks="{ * }"
      materialList="{ fluid, rock }"/>
  </ElementRegions>

  <Constitutive>
    <CompressibleSinglePhaseFluid
      name="fluid"
      defaultDensity="1000.0"
      referenceDensity="1000.0"
      defaultViscosity="0.001"
      referenceViscosity="0.001"
      referencePressure="2.0e7"
      compressibility="0.0"
      viscosibility="0.0"/>

    <CompressibleSolidConstantPermeability
      name="rock"
      solidModelName="nullSolid"
      porosityModelName="rockPorosity"
      permeabilityModelName="rockPerm"/>

    <NullModel name="nullSolid"/>

    <PressurePorosity
      name="rockPorosity"
      defaultReferencePorosity="0.2"
      referencePressure="2.0e7"
      compressibility="0.0"/>

    <ConstantPermeability
      name="rockPerm"
      permeabilityComponents="{ 1.0e-14, 1.0e-14, 1.0e-15 }"/>
  </Constitutive>

  <FieldSpecifications>
    <FieldSpecification
      name="initialPressure"
      initialCondition="1"
      setNames="{ all }"
      objectPath="ElementRegions"
      fieldName="pressure"
      scale="2.0e7"/>

    <FieldSpecification
      name="inletPressure"
      setNames="{ inlet }"
      objectPath="faceManager"
      fieldName="bcPressure"
      scale="2.0e7"/>
    <FieldSpecification
      name="outletPressure"
      setNames="{ outlet }"
      objectPath="faceManager"
      fieldName="bcPressure"
      scale="1.0e7"/>
  </FieldSpecifications>

  <!-- one step, long against the diffusion time of the box so the solve is elliptic-dominated -->
  <Events maxTime="1.0e3">
    <PeriodicEvent
      name="solverApplications"
      forceDt="1.0e3"
      target="/Solvers/mfdFlow"/>
    <PeriodicEvent
      name="outputs"
      timeFrequency="1.0e3"
      target="/Outputs/vtkOutput"/>
  </Events>

  <Outputs>
    <VTK
      name="vtkOutput"
      plotFileRoot="hybridRiesz"
      fieldNames="{ stencilFlag, consistencyIndicator, pressure }"/>
  </Outputs>

</Problem>
