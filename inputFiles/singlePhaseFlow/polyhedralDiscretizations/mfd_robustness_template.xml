<?xml version="1.0" ?>
<!-- Template for mfd_robustness.py: the tokens between at-signs are replaced by the script.
     Box [0,1] x [0,1] x [0,2] split into two cell-block families A and B (four layers along z, or two bands along x),
     incompressible single-phase flow, constant volumetric mass source, p = 0 on the faces x = 0 and x = 1,
     no-flow elsewhere. With a homogeneous permeability k the exact solution is the quadratic
       p(x) = p0 + q mu / (2 rho k) x (1 - x),  q = injected mass rate per unit volume,
     independent of y and z. p0 is a reference level: the solver's residual norm is relative to
     the pressure of the previous state, so a zero reference pressure makes it meaningless.
     Optionally the inner product is prescribed instead of classified: the cells with y below a cut get
     prescribedMfdFlag = 1 (consistent MFD product) and the others 0 (diagonal TPFA product), so the cut
     sets the percentage of MFD cells, 100 % being full MFD. -->
<Problem>

  <Mesh>
    <InternalMesh
      name="mesh"
      elementTypes="{ @elementType@ }"
      xCoords="{ @xCoords@ }"
      yCoords="{ 0, 1 }"
      zCoords="{ @zCoords@ }"
      nx="{ @nx@ }"
      ny="{ @ny@ }"
      nz="{ @nz@ }"
      cellBlockNames="{ @cellBlockNames@ }"/>
  </Mesh>

  <Geometry>
    <Box name="west" xMin="{ -0.001, -0.001, -0.001 }" xMax="{ 0.001, 1.001, 2.001 }"/>
    <Box name="east" xMin="{ 0.999, -0.001, -0.001 }" xMax="{ 1.001, 1.001, 2.001 }"/>
@prescriptionBoxes@  </Geometry>

  <Solvers gravityVector="{ 0.0, 0.0, 0.0 }">
    <SinglePhaseMixedMFD
      name="flow"
      logLevel="1"
      discretization="mfd"
      targetRegions="{ layerA, layerB }">
      <NonlinearSolverParameters newtonTol="1.0e-5" newtonMaxIter="5"/>
      <LinearSolverParameters solverType="gmres" preconditionerType="mgr" krylovTol="1.0e-6" krylovMaxIter="500" logLevel="1"/>
    </SinglePhaseMixedMFD>
  </Solvers>

  <NumericalMethods>
    <MixedMimetic>
      <MixedMimeticDiscretization
        name="mfd"
        innerProductType="RT"
        adaptiveConsistency="1"
        consistencyTolerance="@consistencyTolerance@"
        degeneracyTolerance="0.1"
        nominalGradient="{ 1.0, 1.0, 1.0 }"/>
    </MixedMimetic>
  </NumericalMethods>

  <ElementRegions>
    <CellElementRegion name="layerA" cellBlocks="{ @blocksA@ }" materialList="{ fluid, rockA }"/>
    <CellElementRegion name="layerB" cellBlocks="{ @blocksB@ }" materialList="{ fluid, rockB }"/>
  </ElementRegions>

  <Constitutive>
    <CompressibleSinglePhaseFluid
      name="fluid"
      defaultDensity="1000.0" referenceDensity="1000.0"
      defaultViscosity="0.001" referenceViscosity="0.001"
      referencePressure="0.0" compressibility="0.0" viscosibility="0.0"/>
    <CompressibleSolidConstantPermeability name="rockA" solidModelName="nullSolid" porosityModelName="porosity" permeabilityModelName="permA"/>
    <CompressibleSolidConstantPermeability name="rockB" solidModelName="nullSolid" porosityModelName="porosity" permeabilityModelName="permB"/>
    <NullModel name="nullSolid"/>
    <PressurePorosity name="porosity" defaultReferencePorosity="0.2" referencePressure="0.0" compressibility="0.0"/>
    <ConstantPermeability name="permA" permeabilityComponents="{ @permA@, @permA@, @permA@ }"/>
    <ConstantPermeability name="permB" permeabilityComponents="{ @permB@, @permB@, @permB@ }"/>
  </Constitutive>

  <FieldSpecifications>
    <FieldSpecification name="initialPressure" initialCondition="1" setNames="{ all }" objectPath="ElementRegions" fieldName="pressure" scale="@p0@"/>
    <FieldSpecification name="westPressure" setNames="{ west }" objectPath="faceManager" fieldName="bcPressure" scale="@p0@"/>
    <FieldSpecification name="eastPressure" setNames="{ east }" objectPath="faceManager" fieldName="bcPressure" scale="@p0@"/>
    <!-- total mass rate over the set, shared equally by its cells; negative = injection -->
    <SourceFlux name="source" setNames="{ all }" objectPath="ElementRegions" scale="@sourceRate@"/>
@prescription@  </FieldSpecifications>

  <Events maxTime="1.0">
    <PeriodicEvent name="solve" forceDt="1.0" target="/Solvers/flow"/>
    <PeriodicEvent name="output" timeFrequency="1.0" target="/Outputs/vtk"/>
  </Events>

  <Outputs>
    <VTK name="vtk" plotFileRoot="robustness" format="ascii" onlyPlotSpecifiedFieldNames="1" fieldNames="{ pressure, elementCenter }"/>
  </Outputs>

</Problem>
