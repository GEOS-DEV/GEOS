<?xml version="1.0" ?>

<!-- Ra = 50, first ten steps of lapwoodConvection_Ra50.xml: the disturbance grows by exp( n t ) = 1.55 -->

<Problem>
  <Included>
    <File name="./lapwoodConvection_base.xml"/>
  </Included>

  <!-- k = Ra / 7.848e12 -->
  <FieldSpecifications>
    <FieldSpecification
      name="permX"
      initialCondition="1"
      component="0"
      setNames="{ all }"
      objectPath="ElementRegions"
      fieldName="rockPerm_permeability"
      scale="6.37105e-12"/>

    <FieldSpecification
      name="permY"
      initialCondition="1"
      component="1"
      setNames="{ all }"
      objectPath="ElementRegions"
      fieldName="rockPerm_permeability"
      scale="6.37105e-12"/>

    <FieldSpecification
      name="permZ"
      initialCondition="1"
      component="2"
      setNames="{ all }"
      objectPath="ElementRegions"
      fieldName="rockPerm_permeability"
      scale="6.37105e-12"/>
  </FieldSpecifications>

  <!-- ten steps, restart after five -->
  <Events
    maxTime="1.0e9">
    <PeriodicEvent
      name="solverApplications"
      forceDt="1.0e8"
      target="/Solvers/flow"/>

    <PeriodicEvent
      name="probeCollection"
      timeFrequency="1.0e8"
      target="/Tasks/probeTemperature"/>

    <PeriodicEvent
      name="probeOutput"
      timeFrequency="1.0e9"
      targetExactTimestep="0"
      target="/Outputs/timeHistoryOutput"/>

    <PeriodicEvent
      name="outputs"
      timeFrequency="1.0e9"
      target="/Outputs/vtkOutput"/>

    <PeriodicEvent
      name="restarts"
      timeFrequency="5.0e8"
      targetExactTimestep="0"
      target="/Outputs/restartOutput"/>
  </Events>
</Problem>
