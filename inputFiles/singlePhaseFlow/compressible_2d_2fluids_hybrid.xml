<?xml version="1.0" ?>

<Problem>

  <Included>
    <File name="./compressible_2d_2fluids_hybrid_base.xml"/>
  </Included>

  <Solvers
    gravityVector="{ 0.0, 0.0, -9.81 }">
    <SinglePhaseHybridFVM
      name="flowSolver"
      discretization="singlePhaseHybridMimetic"
      targetRegions="{ Region1, Region2 }">
      <NonlinearSolverParameters
        newtonTol="1.0e-6"
        newtonMaxIter="8"/>
      <LinearSolverParameters
        directParallel="0"/>
    </SinglePhaseHybridFVM>
  </Solvers>

</Problem>
