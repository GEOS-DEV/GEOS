  <NumericalMethods>
  <FiniteVolume> 
      <TwoPointFluxApproximation
        name="singlePhaseTPFA"/>
  </FiniteVolume>
  </NumericalMethods>

  <Solvers
    gravityVector="{ 0.0, 0.0, -9.81 }">
    <SinglePhaseFVM
      name="flowSolver"
      discretization="singlePhaseTPFA"      
      targetRegions="{ Region1, Region2 }">
      <NonlinearSolverParameters
        newtonTol="1.0e-8"
        newtonMaxIter="20"/>
      <LinearSolverParameters
        solverType="gmres"
          preconditionerType="amg" 
          krylovTol="1.0e-10"/>
    </SinglePhaseFVM>        
  </Solvers>

  <Mesh>
    <InternalMesh
      name="mesh1"
      elementTypes="{ C3D8 }"
      xCoords="{ 0, 5, 10 }"
      yCoords="{ 0, 3 }"
      zCoords="{ 0, 1 }"
      nx="{ 50, 50 }"
      ny="{ 30 }"
      nz="{ 1 }"
      cellBlockNames="{ cb-0_0_0, cb-1_0_0 }"/>
  </Mesh>

  <Geometry>
    <Box
      name="source"
      xMin="{ -0.01, 0.99, -0.01 }"
      xMax="{ 1.01, 2.01, 1.01 }"/>

    <Box
      name="sink"
      xMin="{ 8.99, 0.99, -0.01 }"
      xMax="{ 10.01, 2.01, 1.01 }"/>

  </Geometry>

  <Events
    maxTime="2e3">
    <PeriodicEvent
      name="outputs"
      timeFrequency="100.0"
      target="/Outputs/vtkOutputSimpleMFD"/>

    <PeriodicEvent
      name="solverApplications"
      forceDt="1e2"
      target="/Solvers/flowSolver"/>
  </Events>

  <ElementRegions>
    <CellElementRegion
      name="Region1"
      cellBlocks="{ cb-0_0_0 }"
      materialList="{ fluid1, rock1 }"/>

    <CellElementRegion
      name="Region2"
      cellBlocks="{ cb-1_0_0 }"
      materialList="{ fluid2, rock2 }"/>
  </ElementRegions>

  <Constitutive>
    <CompressibleSinglePhaseFluid
      name="fluid1"
      defaultDensity="1000"
      defaultViscosity="0.001"
      referencePressure="0.0"
      compressibility="1.0e-18"
      viscosibility="0.0"/>

    <CompressibleSinglePhaseFluid
      name="fluid2"
      defaultDensity="1000"
      defaultViscosity="0.001"
      referencePressure="0.0"
      compressibility="1.0e-18"
      viscosibility="0.0"/>

    <CompressibleSolidConstantPermeability
      name="rock1"
      solidModelName="nullSolid"
      porosityModelName="rockPorosity"
      permeabilityModelName="rockPerm1"/>

    <CompressibleSolidConstantPermeability
      name="rock2"
      solidModelName="nullSolid"
      porosityModelName="rockPorosity"
      permeabilityModelName="rockPerm2"/>      

    <NullModel
      name="nullSolid"/>

    <PressurePorosity
      name="rockPorosity"
      defaultReferencePorosity="0.05"
      referencePressure="0.0"
      compressibility="1.0e-18"/>

    <ConstantPermeability
      name="rockPerm1"
      permeabilityComponents="{ 2.0e-20, 2.0e-20, 2.0e-20 }"/>

    <ConstantPermeability
      name="rockPerm2"
      permeabilityComponents="{ 2.0e-10, 2.0e-10, 2.0e-10 }"/>

  </Constitutive>

  <FieldSpecifications>
    <FieldSpecification
      name="Porosity"
      initialCondition="1"
      setNames="{ all }"
      objectPath="ElementRegions/Region1/cb-0_0_0"
      fieldName="rockPorosity_referencePorosity"
      scale="0.05"/>

    <FieldSpecification
      name="initialPressure"
      initialCondition="1"
      setNames="{ all }"
      objectPath="ElementRegions"
      fieldName="pressure"
      scale="5e6"/>

    <!-- Note that with the HybridFVM solver, it is not possible to -->
    <!-- set a transMultiplier to 0, since it makes the system singular -->
    <!-- This happens because then one of the face constraints becomes 0 = 0...  -->
<!--     <FieldSpecification
      name="impermeableBarrierTransMult"
      initialCondition="1"
      setNames="{ impermeableBarrier1, impermeableBarrier2 }"
      objectPath="faceManager"
      fieldName="permeabilityTransMultiplier"
      scale="1.0"/>

    <FieldSpecification
      name="lowPermBarrierTransMult"
      initialCondition="1"
      objectPath="faceManager"
      fieldName="permeabilityTransMultiplier"
      scale="1.0"
      setNames="{ lowPermBarrier }"/> -->

    <FieldSpecification
      name="sourceTerm"
      objectPath="faceManager"
      fieldName="pressure"
      scale="5e7"
      setNames="{ source }"/>

    <FieldSpecification
      name="sinkTerm"
      objectPath="ElementRegions"
      fieldName="pressure"
      scale="5e6"
      setNames="{ sink }"/>
  </FieldSpecifications>

  <Outputs>
    <VTK
      name="vtkOutputSimpleMFD"
      fieldNames="{ initialPressure, skeletonChannel_density }"/>
    </Outputs>
</Problem>
