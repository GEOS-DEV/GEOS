<?xml version="1.0" ?>

<Problem>
  <Included>
    <File name="./MoMaS_base.xml" />
    <File name="./MoMaS_initialAggregate.xml" />
    <!-- <File name="./MoMaS_logConc.xml" /> -->
  </Included>

  <Mesh>
    <InternalMesh
      name="mesh1"
      elementTypes="{ C3D8 }"
      xCoords="{ 0, 1 }"
      yCoords="{ 0, 1 }"
      zCoords="{ 0, 1 }"
      nx="{ 1 }"
      ny="{ 1 }"
      nz="{ 1 }"
      cellBlockNames="{ block1 }"/>
  </Mesh>

  <Geometry>
    <Box
      name="source"
      xMin="{ -0.1, -0.01, -0.01 }"
      xMax="{ 1.01, 1.01, 1.01 }"/>

    <Box
      name="sink"
      xMin="{ 1.99, -0.01, -0.01 }"
      xMax="{ 3.01, 1.01, 1.01 }"/>
  </Geometry>

  <Events
    maxTime="1">
    <PeriodicEvent
      name="outputs"
      cycleFrequency="1"
      target="/Outputs/vtkOutput"/>

    <PeriodicEvent
      name="logPrimarySpeciesMediumAHistoryCollection"
      cycleFrequency="1"
      target="/Tasks/logPrimarySpeciesMediumACollection"/>
    <PeriodicEvent
      name="logPrimarySpeciesMediumATimeHistoryOutput"
      cycleFrequency="1"
      target="/Outputs/logPrimarySpeciesMediumAHistoryOutput"/>

    <PeriodicEvent
      name="solverApplications"
      forceDt="1"
      target="/Solvers/SinglePhaseReactiveFlow"/>
  </Events>

</Problem>
