<?xml version="1.0" ?>

<Problem>
  <Included>
    <File name="./thermalCompressibleWell_base.xml" />
  </Included>

  <Solvers>
    <SinglePhaseReservoir
      name="coupledFlowAndWells"
      flowSolverName="singlePhaseFlow"
      wellSolverName="singlePhaseWell"
      logLevel="1"
      initialDt="1e3"
      targetRegions="{ region , wellRegion2 }">
      <NonlinearSolverParameters
        newtonTol="1.0e-3"
        maxTimeStepCuts="10"
        lineSearchAction="None"
        timeStepIncreaseIterLimit="0.3"
        timeStepDecreaseIterLimit="0.6"
        maxSubSteps="20"
        newtonMaxIter="15"/>
      <LinearSolverParameters
        solverType="fgmres"
        krylovMaxIter="100"
        krylovTol="1e-6"
        logLevel="1"/>
    </SinglePhaseReservoir>

    <SinglePhaseFVM
      name="singlePhaseFlow"
      logLevel="1"
      discretization="tpfaFlow"
      temperature="353.0"
      isThermal="1"
      targetRegions="{ region }"/>

    <WellManager
      name="singlePhaseWell"
      logLevel="1"
      isThermal="1"
      targetRegions="{ wellRegion2 }">
      <SinglePhaseWell
        name="wellControls2"
        type="injector"
        control="BHP"
        enableCrossflow="0"
        useSurfaceConditions="1"
        surfacePressure="1.45e7"
        surfaceTemperature="300.15">
        <MaximumBHPConstraint
          name="maxbhp"
          targetBHP="1.45e7"
          referenceElevation="-0.01"/>
        <InjectionVolumeRateConstraint
          name="maxvolrateinj"
          volumeRate="15"
          injectionStream="{ 1.0, 0.0 }"
          injectionTemperature="323"/>
      </SinglePhaseWell>
    </WellManager>
  </Solvers>

  <Mesh>
    <InternalMesh
      name="mesh1"
      elementTypes="{ C3D8 }"
      xCoords="{ 0, 100 }"
      yCoords="{ 0, 100 }"
      zCoords="{ 0, 100 }"
      nx="{ 10 }"
      ny="{ 10 }"
      nz="{ 10 }"
      cellBlockNames="{ cb }">
      <InternalWell
        name="well_injector1"
        wellRegionName="wellRegion2"
        wellControlsName="wellControls2"
        polylineNodeCoords="{ { 5.0,5.0, .99 },
                              { 5.0, 5.0, .01 } }"
        polylineSegmentConn="{ { 0, 1 } }"
        radius="0.1"
        numElementsPerSegment="2">
        <Perforation
          name="injector1_perf1"
          distanceFromHead="0.5"/>
      </InternalWell>
    </InternalMesh>
  </Mesh>

  <Events
    maxTime="1.5e7">
    <PeriodicEvent
      name="outputs"
      timeFrequency="2.5e6"
      target="/Outputs/vtkOutput"/>

    <PeriodicEvent
      name="solverApplications"
      maxEventDt="2.5e6"
      target="/Solvers/coupledFlowAndWells"/>

    <PeriodicEvent
      name="restarts"
      timeFrequency="7.5e6"
      target="/Outputs/restartOutput"/>
  </Events>

</Problem>
