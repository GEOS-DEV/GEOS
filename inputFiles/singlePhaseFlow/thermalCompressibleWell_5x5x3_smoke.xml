<?xml version="1.0" ?>

<Problem>
  <Included>
    <File name="./thermalCompressibleWell_5x5x3_iterative.xml" />
  </Included>

  <Mesh>
    <InternalMesh
      name="mesh1"
      elementTypes="{ C3D8 }"
      xCoords="{ 0, 100 }"
      yCoords="{ 0, 100 }"
      zCoords="{ 0, 100 }"
      nx="{ 5 }"
      ny="{ 5 }"
      nz="{ 3 }"
      cellBlockNames="{ cb }">
      <InternalWell
        name="well_prod1"
        wellRegionName="wellRegion1"
        wellControlsName="wellControls1"
        polylineNodeCoords="{ { 1.0,1.0, .99 },
                              { 1.0, 1.0, .01 } }"
        polylineSegmentConn="{ { 0, 1 } }"
        radius="0.1"
        numElementsPerSegment="2">
        <Perforation
          name="prod_perf1"
          transmissibility="1e-10"
          distanceFromHead="0.25"/>
        <Perforation
          name="prod_perf2"
          transmissibility="1e-10"
          distanceFromHead="0.5"/>  
      </InternalWell>        
      <InternalWell
        name="well_injector1"
        wellRegionName="wellRegion2"
        wellControlsName="wellControls2"
        polylineNodeCoords="{ { 90.0,90.0, .99 },
                              { 90.0, 90.0, .01 } }"
        polylineSegmentConn="{ { 0, 1 } }"
        radius="0.1"
        numElementsPerSegment="2">
        <Perforation
          name="injector1_perf1"
          transmissibility="1e-10"
          distanceFromHead="0.25"/>
        <Perforation
          name="injector1_perf2"
          transmissibility="1e-10"
          distanceFromHead="0.5"/>  
      </InternalWell>
    </InternalMesh>
  </Mesh>

  <Events
    maxTime="1.5e7">
    <PeriodicEvent
      name="outputs"
      timeFrequency="2.5e6"
      target="/Outputs/vtkOutput"/>

    <PeriodicEvent
      name="solverApplications"
      maxEventDt="2.5e6"
      target="/Solvers/coupledFlowAndWells"/>

    <PeriodicEvent
      name="restarts"
      timeFrequency="7.5e6"
      target="/Outputs/restartOutput"/>
  </Events>

</Problem>
