<?xml version="1.0" ?>

<!--
  Gravity loading of a polyhedral field model, displacement based finite elements.

  Boundary conditions
    lateral boundary : horizontal displacement restrained, vertical free
    bottom (z=-2400) : vertical displacement restrained, horizontal free
    top (z=0)        : free surface, sigma.n = 0, which is the natural condition
    body force       : self weight through gravityVector and the material density

  The node sets come from the two dimensional cells of the mesh: GEOS imports them as
  surfaces and names each set after its region attribute. Surface 12 is the flat bottom at
  z = -2400, surface 2 is the flat top at z = 0, surfaces 4, 5, 8 and 13 are internal
  horizons and 6, 7 are the two faults; the remaining ones are the lateral boundary.

  The mesh is industrial_3_mechanics.vtu, which is industrial_3_with_node_sets.vtu with the
  twelve cell arrays that contain NaN removed: porosity, permeability, initialPressure,
  temperature and the eight ECLIPSE style arrays, none of which this problem reads. They are
  only partly defined, and in parallel the redistribution asks VTK for their range, which
  raises a floating point exception. Serial never redistributes, so it never sees them.
-->
<Problem>

  <Solvers
    gravityVector="{ 0.0, 0.0, -9.8 }">
    <SolidMechanicsLagrangianFEM
      name="gravitySolver"
      discretization="FE1"
      targetRegions="{ Domain }"
      logLevel="1">
      <NonlinearSolverParameters
        newtonTol="1.0e-3"
        newtonMaxIter="5"/>
      <LinearSolverParameters
        solverType="gmres"
        preconditionerType="amg"
        krylovTol="1.0e-5"
        logLevel="1"/>
    </SolidMechanicsLagrangianFEM>
  </Solvers>

  <NumericalMethods>
    <FiniteElements>
      <FiniteElementSpace
        name="FE1"
        order="1"/>
    </FiniteElements>
  </NumericalMethods>

  <Mesh>
    <VTKMesh
      name="mesh1"
      logLevel="1"
      regionAttribute="region"
      file="./Aramis_tetdom_populated_v2.vtu"
      partitionMethod="parmetis"
      partitionRefinement="1"/>
  </Mesh>

  <ElementRegions>
    <CellElementRegion
      name="Domain"
      cellBlocks="{ * }"
      materialList="{ rock }"/>
  </ElementRegions>

  <Constitutive>
    <ElasticIsotropic
      name="rock"
      defaultDensity="2400"
      defaultBulkModulus="5.5556e9"
      defaultShearModulus="4.16667e9"/>
  </Constitutive>

  <FieldSpecifications>

    <!-- x = xmin and x = xmax: normal displacement ux = 0 -->
    <FieldSpecification
      name="lateralX"
      objectPath="nodeManager"
      fieldName="totalDisplacement"
      component="0"
      scale="0.0"
      setNames="{ 7, 22 }"/>

    <!-- y = ymin and y = ymax: normal displacement uy = 0 -->
    <FieldSpecification
      name="lateralY"
      objectPath="nodeManager"
      fieldName="totalDisplacement"
      component="1"
      scale="0.0"
      setNames="{ 15, 31 }"/>

    <!-- z = zmin: normal displacement uz = 0 -->
    <FieldSpecification
      name="bottomZ"
      objectPath="nodeManager"
      fieldName="totalDisplacement"
      component="2"
      scale="0.0"
      setNames="{ 27 }"/>

  </FieldSpecifications>

  <Events
    maxTime="1.0">
    <PeriodicEvent
      name="solverApplications"
      forceDt="1.0"
      target="/Solvers/gravitySolver"/>

    <PeriodicEvent
      name="outputs"
      timeFrequency="1.0"
      target="/Outputs/vtkOutput"/>
  </Events>

  <Outputs>
    <VTK
      name="vtkOutput"/>
  </Outputs>

</Problem>
