<?xml version="1.0" ?>

<!--
  Gravity loading of a polyhedral field model, displacement based finite elements,
  on the industrial_3 mesh. Companion of industrial3Gravity_mixedVEM.xml.

  Boundary conditions
    lateral boundary : horizontal displacement restrained, vertical free
    bottom (z=-2400) : vertical displacement restrained, horizontal free
    top (z=0)        : free surface, sigma.n = 0, which is the natural condition
    body force       : self weight through gravityVector and the material density

  This mesh carries two dimensional cells, so the boundary is named rather than selected
  geometrically: GEOS imports them as surfaces and names each set after its region attribute.
  Surface 12 is the flat bottom at z = -2400, surface 2 is the flat top at z = 0, surfaces
  4, 5, 8 and 13 are internal horizons, 6 and 7 are the two faults, and 1, 3, 9, 10, 11, 14
  and 15 are the lateral boundary. That classification was checked against the mesh.

  The lateral boundary is oblique, its normals running at angles such as (0.55, 0.83, 0), so
  restraining the two Cartesian horizontal components is not the same as restraining the
  normal. Both horizontal components are restrained on every lateral surface, which is what
  the mixed companion does as well, so the two forms solve the same statement.

  Size. 516,027 cells, 223,807 nodes, so 3 x 223,807 = 671,421 unknowns.

  Parallel. Twelve cell arrays of this mesh contain NaN: porosity, permeability,
  initialPressure, temperature, PORO, PERMX, PERMY, PERMZ, NTG, PORO_NET, PERMX_NET and
  PERMY_NET. None is read by this problem, but in parallel the redistribution asks VTK for
  their range, which raises a floating point exception. Serial never redistributes and never
  sees them. Strip those arrays from the file before running on more than one rank.
-->
<Problem>

  <Solvers
    gravityVector="{ 0.0, 0.0, -9.8 }">
    <SolidMechanicsLagrangianFEM
      name="gravitySolver"
      discretization="FE1"
      targetRegions="{ Domain }"
      logLevel="1">
      <NonlinearSolverParameters
        newtonTol="1.0e-3"
        newtonMaxIter="5"/>
      <LinearSolverParameters
        solverType="gmres"
        preconditionerType="amg"
        krylovTol="1.0e-5"
        logLevel="1"/>
    </SolidMechanicsLagrangianFEM>
  </Solvers>

  <NumericalMethods>
    <FiniteElements>
      <FiniteElementSpace
        name="FE1"
        order="1"/>
    </FiniteElements>
  </NumericalMethods>

  <Mesh>
    <VTKMesh
      name="mesh1"
      logLevel="1"
      regionAttribute="region"
      file="./industrial_3.vtu"
      partitionMethod="parmetis"
      partitionRefinement="1"/>
  </Mesh>

  <ElementRegions>
    <CellElementRegion
      name="Domain"
      cellBlocks="{ * }"
      materialList="{ rock }"/>
  </ElementRegions>

  <Constitutive>
    <ElasticIsotropic
      name="rock"
      defaultDensity="2400"
      defaultBulkModulus="5.5556e9"
      defaultShearModulus="4.16667e9"/>
  </Constitutive>

  <FieldSpecifications>

    <!-- lateral boundary: ux = 0 -->
    <FieldSpecification
      name="lateralX"
      objectPath="nodeManager"
      fieldName="totalDisplacement"
      component="0"
      scale="0.0"
      setNames="{ 1, 3, 9, 10, 11, 14, 15 }"/>

    <!-- lateral boundary: uy = 0 -->
    <FieldSpecification
      name="lateralY"
      objectPath="nodeManager"
      fieldName="totalDisplacement"
      component="1"
      scale="0.0"
      setNames="{ 1, 3, 9, 10, 11, 14, 15 }"/>

    <!-- z = -2400: uz = 0 -->
    <FieldSpecification
      name="bottomZ"
      objectPath="nodeManager"
      fieldName="totalDisplacement"
      component="2"
      scale="0.0"
      setNames="{ 12 }"/>

  </FieldSpecifications>

  <Events
    maxTime="1.0">
    <PeriodicEvent
      name="solverApplications"
      forceDt="1.0"
      target="/Solvers/gravitySolver"/>

    <PeriodicEvent
      name="outputs"
      timeFrequency="1.0"
      target="/Outputs/vtkOutput"/>
  </Events>

  <Outputs>
    <VTK
      name="vtkOutput"/>
  </Outputs>

</Problem>
