<?xml version="1.0" ?>

<!-- Lowest-order mixed virtual element method, hybridized form. The element unknowns are
     condensed out and the symmetric positive definite interface problem is solved for the
     displacement trace, then the stress and displacement are recovered cell by cell. -->
<Problem>

  <Included>
    <File name="./hybridMeshGravity_base.xml"/>
  </Included>

  <Solvers
    gravityVector="{ 0.0, 0.0, -9.81 }">
    <SolidMechanicsMixedVEM
      name="gravitySolver"
      discretization="mixedVEM1"
      targetRegions="{ Domain }"
      logLevel="1">
      <LinearSolverParameters
        solverType="cg"
        preconditionerType="amg"
        krylovTol="1.0e-6"/>
    </SolidMechanicsMixedVEM>
  </Solvers>

  <NumericalMethods>
    <MixedVEM>
      <MixedVEMDiscretization
        name="mixedVEM1"
        hybridization="1"/>
    </MixedVEM>
  </NumericalMethods>

  <FieldSpecifications>
    <FieldSpecification
      name="lateralX"
      objectPath="faceManager"
      fieldName="displacementTrace"
      component="0"
      scale="0.0"
      setNames="{ xneg, xpos }"/>

    <FieldSpecification
      name="lateralY"
      objectPath="faceManager"
      fieldName="displacementTrace"
      component="1"
      scale="0.0"
      setNames="{ yneg, ypos }"/>

    <FieldSpecification
      name="bottomZ"
      objectPath="faceManager"
      fieldName="displacementTrace"
      component="2"
      scale="0.0"
      setNames="{ zneg }"/>
  </FieldSpecifications>

</Problem>
