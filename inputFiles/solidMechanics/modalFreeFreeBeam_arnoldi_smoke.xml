<?xml version="1.0" ?>

<Problem>

  <Included>
    <File name="./modalFreeFreeBeam_base.xml"/>
  </Included>

  <!-- The shift is a negative frequency: the shifted matrix K + alpha M is positive definite although
       the beam is a free body. The linear solver tolerance is two orders below the eigensolver tolerance. -->
  <Solvers
    gravityVector="{ 0.0, 0.0, 0.0 }">
    <SolidMechanicsLagrangianFEM
      name="modal"
      discretization="FE1"
      targetRegions="{ Region }"
      timeIntegrationOption="Modal"
      modalSolverType="arnoldi"
      modalNumModes="10"
      modalShiftFrequency="-5.0"
      modalTolerance="1.0e-8">
      <LinearSolverParameters
        solverType="cg"
        preconditionerType="amg"
        krylovTol="1.0e-10"
        krylovMaxIter="2000"/>
    </SolidMechanicsLagrangianFEM>
  </Solvers>

</Problem>
