<?xml version="1.0" ?>

<Problem>
  <Included>
    <File name="./fractureMatrixFlow_edfm_base_ComputePSP.xml" />
  </Included>

  <Mesh>
    <InternalMesh
      name="mesh1"
      elementTypes="{ C3D8 }"
      xCoords="{ 0, 1 }"
      yCoords="{ 0, 1 }"
      zCoords="{ 0, 1 }"
      nx="{ 11 }"
      ny="{ 11 }"
      nz="{ 11 }"
      cellBlockNames="{ cb1 }"/>
  </Mesh>

  <Geometry>
    <Box
      name="source"
      xMin="{ -0.01, -0.01, -0.01 }"
      xMax="{ 1.1, 0.1, 1.01 }"/>

    <Box
      name="sink"
      xMin="{ -0.01, 0.9, -0.01 }"
      xMax="{ 1.01, 1.01, 1.01 }"/>

    <Rectangle
      name="FracturePlane"
      normal="{ 1, 0, 0 }"
      origin="{ 0.5, 0.5, 0.5 }"
      lengthVector="{ 0, 1, 0 }"
      widthVector="{ 0, 0, 1 }"
      dimensions="{ 0.5, 1 }"/>
  </Geometry>

  <!-- NEW -->
  <Tasks>
    <PackCollection
      name="pressureCollection"
      objectPath="ElementRegions/Fracture/embeddedSurfaceSubRegion"
      fieldName="pressure"/> 
    <PackCollection
      name="apertureCollection"
      objectPath="ElementRegions/Fracture/embeddedSurfaceSubRegion"
      fieldName="hydraulicAperture"/>           
  </Tasks>
  
  <Events
    maxTime="2e3"
    logLevel="3">
    <SoloEvent
      name="preFracture"
      target="/Solvers/SurfaceGenerator"/>

    <PeriodicEvent
      name="solverApplications"
      forceDt="1e3"
      target="/Solvers/SinglePhaseFlow"/>

    <PeriodicEvent
      name="outputs"
      target="/Outputs/vtkOutput"/>

    <PeriodicEvent
      name="restarts"
      timeFrequency="1e3"
      target="/Outputs/sidreRestart"/>
	  
	<!-- NEW -->
    <PeriodicEvent
      name="pressureHistoryCollection"
      target="/Tasks/pressureCollection" />
    <PeriodicEvent
      name="pressureHistoryOutput"
      targetExactTimestep="0"
      target="/Outputs/pressureHistoryOutput"/> 
    <PeriodicEvent
      name="apertureHistoryCollection"
      target="/Tasks/apertureCollection" />
    <PeriodicEvent
      name="apertureHistoryOutput"
      targetExactTimestep="0"
      target="/Outputs/apertureHistoryOutput"/> 
  </Events>

  <Outputs>
    <VTK
      name="vtkOutput"
      plotFileRoot="fracMatFlow_edfm_horizontal"
      plotLevel="2"
      format="ascii"/>

    <Restart
      name="sidreRestart"/>
	  
	<!-- NEW -->
    <TimeHistory
      name="pressureHistoryOutput"
      sources="{/Tasks/pressureCollection}"
      filename="fracPressure_history" />
    <TimeHistory
      name="apertureHistoryOutput"
      sources="{/Tasks/apertureCollection}"
      filename="fracAperture_history" />
  </Outputs>
</Problem>
