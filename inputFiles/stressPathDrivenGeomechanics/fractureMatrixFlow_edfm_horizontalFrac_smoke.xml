<?xml version="1.0" ?>

<Problem>
  <Included>
    <File name="./fractureMatrixFlow_edfm_base.xml" />
  </Included>

  <Mesh>
    <InternalMesh
      name="mesh1"
      elementTypes="{ C3D8 }"
      xCoords="{ -1.5, 1.5 }"
      yCoords="{ 0, 11 }"
      zCoords="{ 0, 1 }"
      nx="{ 3 }"
      ny="{ 11 }"
      nz="{ 1 }"
      cellBlockNames="{ cb1 }"/>
  </Mesh>

  <Geometry>
    <Box
      name="source"
      xMin="{ -1.01, -0.01, -0.01 }"
      xMax="{ 1.01, 1.1, 1.01 }"/>

    <Box
      name="sink"
      xMin="{ -1.01, 9.9, -0.01 }"
      xMax="{ 1.01, 11.01, 1.01 }"/>

    <Rectangle
      name="FracturePlane"
      normal="{ 1, 0, 0 }"
      origin="{ 0.0, 0.5, 0.5 }"
      lengthVector="{ 0, 1, 0 }"
      widthVector="{ 0, 0, 1 }"
      dimensions="{ 30, 1 }"/>
  </Geometry>

  <Events
    maxTime="1e4"
    logLevel="3">
    <SoloEvent
      name="preFracture"
      target="/Solvers/SurfaceGenerator"/>

    <PeriodicEvent
      name="solverApplications"
      forceDt="1e2"
      target="/Solvers/SinglePhaseFlow"/>

    <PeriodicEvent
      name="outputs"
      target="/Outputs/vtkOutput"/>

  </Events>

  <Outputs>
    <VTK
      name="vtkOutput"
      plotFileRoot="fracMatFlow_edfm_horizontal"
      plotLevel="2"
      format="ascii"/>

    <Restart
      name="sidreRestart"/>
  </Outputs>
</Problem>
