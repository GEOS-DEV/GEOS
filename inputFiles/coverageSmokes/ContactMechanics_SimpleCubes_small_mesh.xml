<?xml version="1.0" ?>

<Problem>
  <Solvers gravityVector="{ 0.0, 0.0, 0.0 }">
    <SolidMechanicsLagrangeContact
      name="lagrangiancontact"
      stabilizationName="TPFAstabilization"
      discretization="FE1"
      targetRegions="{ Region, Fracture }"
      logLevel="1">
      <NonlinearSolverParameters
        newtonTol="1.0e-4"
        logLevel="2"
        newtonMaxIter="20"
        lineSearchAction="Require"
        lineSearchStartingIteration="2"
        lineSearchMaxCuts="2"
        lineSearchInterpolationType="Parabolic"/>
      <LinearSolverParameters directParallel="0"/>
    </SolidMechanicsLagrangeContact>
  </Solvers>

  <Mesh>
    <InternalMesh
      name="mesh1"
      elementTypes="{ C3D8 }"
      xCoords="{ -4, 4 }"
      yCoords="{ 0, 20 }"
      zCoords="{ 0, 20 }"
      nx="{ 4 }"
      ny="{ 10 }"
      nz="{ 10 }"
      cellBlockNames="{ cb1 }"/>
  </Mesh>

  <Events maxTime="10.0">
    <PeriodicEvent
      name="solverApplications"
      beginTime="0.0"
      endTime="5.0"
      forceDt="2.0"
      target="/Solvers/lagrangiancontact"/>
    <PeriodicEvent
      name="solverApplicationsLoadReversal"
      beginTime="5.0"
      endTime="7.0"
      forceDt="1.0"
      target="/Solvers/lagrangiancontact"/>
    <PeriodicEvent
      name="solverApplicationsOpenTail"
      beginTime="7.0"
      endTime="10.0"
      forceDt="3.0"
      target="/Solvers/lagrangiancontact"/>
    <PeriodicEvent
      name="restarts"
      timeFrequency="10.0"
      targetExactTimestep="0"
      target="/Outputs/restartOutput"/>
    <PeriodicEvent
      name="outputs"
      timeFrequency="10.0"
      targetExactTimestep="0"
      target="/Outputs/siloOutput"/>
  </Events>
</Problem>
