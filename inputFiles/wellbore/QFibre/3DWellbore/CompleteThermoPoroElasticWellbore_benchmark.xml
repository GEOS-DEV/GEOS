<?xml version="1.0" ?>

<Problem>
  <Included>
    <File name="./CompleteThermoPoroElasticWellbore_base.xml" />
  </Included>

  <!-- SPHINX_WellboreMesh -->
  <Mesh>
    <VTKMesh 
      name="mesh"
      regionAttribute="CASING-CEMENT-SEAL-RESERVOIR"
      file="../meshes/completeWellbore_Dseal=4m_Dres=1m_Ncirc=80_Nr=80_Ndseal=40_Ndres=10_intNodeset.vtu"
      nodesetNames="{ xneg, xpos, yneg, ypos, zneg, zpos, well_face_seal, well_face_reservoir }"/>
  </Mesh>
  <!-- SPHINX_WellboreMeshEnd -->

  <Geometry>
    <Cylinder
      name="reservoir_innerFace"
      firstFaceCenter="{ 0.0, 0.0,  1.01 }"
      secondFaceCenter="{ 0.0, 0.0, -0.01}"
      outerRadius="0.101"
      innerRadius="0.099"
    />
  </Geometry>

  <Events
    minTime="-1e10"
    maxTime="1e5">

    <PeriodicEvent
      name="stressHistoryCollection_casing"
      endTime="1e5"
      forceDt="1e4"
      target="/Tasks/stressCollection_casing"/>
    <PeriodicEvent
      name="stressHistoryCollection_cement"
      endTime="1e5"
      forceDt="1e4"
      target="/Tasks/stressCollection_cement"/>
    <PeriodicEvent
      name="stressHistoryCollection_seal"
      endTime="1e5"
      forceDt="1e4"
      target="/Tasks/stressCollection_seal"/>
    <PeriodicEvent
      name="stressHistoryCollection_reservoir"
      endTime="1e5"
      forceDt="1e4"
      target="/Tasks/stressCollection_reservoir"/>
    <PeriodicEvent
      name="stressTimeHistoryOutput_casing"
      endTime="1e5"
      forceDt="1e4"
      target="/Outputs/stressHistoryOutput_casing"/>
    <PeriodicEvent
      name="stressTimeHistoryOutput_cement"
      endTime="1e5"
      forceDt="1e4"
      target="/Outputs/stressHistoryOutput_cement"/>
    <PeriodicEvent
      name="stressTimeHistoryOutput_seal"
      endTime="1e5"
      forceDt="1e4"
      target="/Outputs/stressHistoryOutput_seal"/>
    <PeriodicEvent
      name="stressTimeHistoryOutput_reservoir"
      endTime="1e5"
      forceDt="1e4"
      target="/Outputs/stressHistoryOutput_reservoir"/>

    <PeriodicEvent
      name="strainHistoryCollection_casing"
      endTime="1e5"
      forceDt="1e4"
      target="/Tasks/strainCollection_casing"/>
    <PeriodicEvent
      name="strainHistoryCollection_cement"
      endTime="1e5"
      forceDt="1e4"
      target="/Tasks/strainCollection_cement"/>
    <PeriodicEvent
      name="strainHistoryCollection_seal"
      endTime="1e5"
      forceDt="1e4"
      target="/Tasks/strainCollection_seal"/>
    <PeriodicEvent
      name="strainHistoryCollection_reservoir"
      endTime="1e5"
      forceDt="1e4"
      target="/Tasks/strainCollection_reservoir"/>
    <PeriodicEvent
      name="strainTimeHistoryOutput_casing"
      endTime="1e5"
      forceDt="1e4"
      target="/Outputs/strainHistoryOutput_casing"/>
    <PeriodicEvent
      name="strainTimeHistoryOutput_cement"
      endTime="1e5"
      forceDt="1e4"
      target="/Outputs/strainHistoryOutput_cement"/>
    <PeriodicEvent
      name="strainTimeHistoryOutput_seal"
