    <PeriodicEvent
      name="strainTimeHistoryOutput_reservoir"
      endTime="1e5"
      forceDt="1e4"
      target="/Outputs/strainHistoryOutput_reservoir"/>

    <PeriodicEvent
      name="temperatureHistoryCollection_casing"
      endTime="1e5"
      forceDt="1e4"
      target="/Tasks/temperatureCollection_casing"/>
    <PeriodicEvent
      name="temperatureHistoryCollection_cement"
      endTime="1e5"
      forceDt="1e4"
      target="/Tasks/temperatureCollection_cement"/>
    <PeriodicEvent
