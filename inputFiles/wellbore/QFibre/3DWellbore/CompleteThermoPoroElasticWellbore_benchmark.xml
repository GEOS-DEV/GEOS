      endTime="1e5"
      forceDt="1e4"
      target="/Outputs/pressureHistoryOutput_reservoir"/>

    <PeriodicEvent
      name="outputs"
      cycleFrequency="2"
      target="/Outputs/vtkOutput"/>
    
    <SoloEvent 
      beginTime="-1e10" 
      name="singlephasePoromechanicsPreEquilibrationStep"
      target="/Tasks/singlephasePoromechanicsPreEquilibrationStep"
      targetTime="-1e10" />

    <PeriodicEvent
      name="solverApplications"
      maxEventDt="1e3"
      target="/Solvers/thermoPoroElasticSolver"/>

    <PeriodicEvent
      name="restarts"
      cycleFrequency="50"
      target="/Outputs/restartOutput"/>
  </Events>

