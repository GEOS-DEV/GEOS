<?xml version="1.0" ?>

<Problem>
  <Included>
    <File name="./UncasedThermoPoroElasticWellbore_base.xml" />
  </Included>

  <!-- SPHINX_WellboreMesh -->
  <Mesh>
    <VTKMesh 
      name="mesh"
      file="../meshes/uncasedWellbore_L=20m_Ncirc=200_Nr=200_intNodeset.vtu"
      nodesetNames="{ xneg, xpos, yneg, ypos, zneg, zpos, well_face }"/>
  </Mesh>
  <!-- SPHINX_WellboreMeshEnd -->

  <Events
    minTime="-1e10"
    maxTime="4e7">

    <PeriodicEvent
      name="bulkModHistoryCollection_rock"
      beginTime="0.0"
      endTime="4e7"
      forceDt="8e5"
      target="/Tasks/bulkModCollection_rock"/>
    <PeriodicEvent
      name="bulkModTimeHistoryOutput_rock"
      beginTime="0.0"
      endTime="4e7"
      forceDt="8e5"
      target="/Outputs/bulkModHistoryOutput_rock"/>
    
    <PeriodicEvent
      name="stressHistoryCollection_rock"
      beginTime="0.0"
      endTime="4e7"
      forceDt="8e5"
      target="/Tasks/stressCollection_rock"/>
    <PeriodicEvent
      name="stressTimeHistoryOutput_rock"
      beginTime="0.0"
      endTime="4e7"
      forceDt="8e5"
      target="/Outputs/stressHistoryOutput_rock"/>

    <PeriodicEvent
      name="temperatureHistoryCollection_rock"
      beginTime="0.0"
      endTime="4e7"
      forceDt="8e5"
      target="/Tasks/temperatureCollection_rock"/>
    <PeriodicEvent
      name="temperatureTimeHistoryOutput_rock"
      beginTime="0.0"
      endTime="4e7"
      forceDt="8e5"
      target="/Outputs/temperatureHistoryOutput_rock"/>

    <PeriodicEvent
      name="pressureHistoryCollection_rock"
      beginTime="0.0"
      endTime="4e7"
      forceDt="8e5"
      target="/Tasks/pressureCollection_rock"/>
    <PeriodicEvent
      name="pressureTimeHistoryOutput_rock"
      beginTime="0.0"
      endTime="4e7"
      forceDt="8e5"
      target="/Outputs/pressureHistoryOutput_rock"/>

    <PeriodicEvent
      name="outputs"
      beginTime="0.0"
      cycleFrequency="4"
      target="/Outputs/vtkOutput"/>

    <SoloEvent 
      beginTime="-1e10" 
      name="singlephasePoromechanicsPreEquilibrationStep"
      target="/Tasks/singlephasePoromechanicsPreEquilibrationStep"
      forceDt="1e10" />

    <PeriodicEvent
      name="solverApplications1"
      beginTime="0.0"
      endTime="0.1"
      forceDt="0.1"
      target="/Solvers/thermoPoroElasticSolver"/>

    <PeriodicEvent
      name="solverApplications2"
      beginTime="0.1"
      maxEventDt="1e5"
      target="/Solvers/thermoPoroElasticSolver"/>

    <PeriodicEvent
      name="restarts"
      cycleFrequency="100"
      target="/Outputs/restartOutput"/>
  </Events>

</Problem>
