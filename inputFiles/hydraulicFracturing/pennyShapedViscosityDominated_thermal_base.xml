<?xml version="1.0" ?>

<!-- Thermal variant of pennyShapedViscosityDominated_base.xml, with a rock-only (non poroelastic)
     matrix. Flow and heat transport are solved in the fracture only, so the matrix carries no
     temperature degree of freedom. The thermal stress on the fracture faces is therefore computed
     from the prescribed matrixTemperature: cold injected fluid lowers the normal stress. -->
<Problem>
  <ElementRegions>
    <!-- the matrix is not part of the flow problem, so it only needs the solid model -->
    <CellElementRegion
      name="Domain"
      cellBlocks="{ * }"
      materialList="{ rock }"/>

    <SurfaceElementRegion
      name="Fracture"
      defaultAperture="0.02e-3"
      materialList="{ water, fractureFilling, fractureContact, hApertureModel, thermalCond }"/>
  </ElementRegions>

  <Constitutive>
    <ThermalCompressibleSinglePhaseFluid
      name="water"
      defaultDensity="1000"
      defaultViscosity="0.001"
      referenceViscosity="1.0e-3"
      referencePressure="0.0"
      referenceTemperature="0.0"
      compressibility="5e-10"
      thermalExpansionCoeff="0.0"
      viscosibility="0.0"
      specificHeatCapacity="4.2e3"
      referenceInternalEnergy="0.001"/>

    <ElasticIsotropic
      name="rock"
      defaultDensity="2700"
      defaultBulkModulus="20.0e9"
      defaultShearModulus="12.0e9"
      defaultDrainedLinearTEC="1.0e-7"/>

    <CompressibleSolidParallelPlatesPermeability
      name="fractureFilling"
      solidModelName="nullSolid"
      porosityModelName="fracturePorosity"
      permeabilityModelName="fracturePerm"
      solidInternalEnergyModelName="rockInternalEnergy"/>

    <NullModel
      name="nullSolid"/>

    <PressurePorosity
      name="fracturePorosity"
      defaultReferencePorosity="1.00"
      referencePressure="0.0"
      compressibility="0.0"/>

    <ParallelPlatesPermeability
      name="fracturePerm"/>

    <SolidInternalEnergy
      name="rockInternalEnergy"
      referenceVolumetricHeatCapacity="2.16e6"
      referenceTemperature="0.0"
      referenceInternalEnergy="0.0"/>

    <SinglePhaseThermalConductivity
      name="thermalCond"
      defaultThermalConductivityComponents="{ 3.0, 3.0, 3.0 }"/>

    <FrictionlessContact
      name="fractureContact"/>

    <HydraulicApertureTable
      name="hApertureModel"
      apertureTableName="apertureTable"/>
  </Constitutive>

  <NumericalMethods>
    <FiniteElements>
      <FiniteElementSpace
        name="FE1"
        order="1"/>
    </FiniteElements>

    <FiniteVolume>
      <TwoPointFluxApproximation
        name="singlePhaseTPFA"
        meanPermCoefficient="0.8"/>
    </FiniteVolume>
  </NumericalMethods>

  <FieldSpecifications>
    <FieldSpecification
      name="waterDensity"
      initialCondition="1"
      setNames="{ all }"
      objectPath="ElementRegions/Fracture"
      fieldName="water_density"
      scale="1000"/>

    <FieldSpecification
      name="separableFace"
      initialCondition="1"
      setNames="{ core }"
      objectPath="faceManager"
      fieldName="isFaceSeparable"
      scale="1"/>

    <FieldSpecification
      name="frac"
      initialCondition="1"
      setNames="{ fracture }"
      objectPath="faceManager"
      fieldName="ruptureState"
      scale="1"/>

    <FieldSpecification
      name="initialTemperatureFracture"
      initialCondition="1"
      setNames="{ all }"
      objectPath="ElementRegions/Fracture"
      fieldName="temperature"
      scale="350.0"/>

    <!-- Cold injected fluid -->
    <FieldSpecification
      name="sourceTemperature"
      objectPath="ElementRegions/Fracture"
      fieldName="temperature"
      scale="1.0"
      functionName="injectionTemperature"
      setNames="{ source }"/>

    <FieldSpecification
      name="xconstraint"
      objectPath="nodeManager"
      fieldName="totalDisplacement"
      component="0"
      scale="0.0"
      setNames="{ xneg, xpos }"/>

    <FieldSpecification
      name="yconstraint"
      objectPath="nodeManager"
      fieldName="totalDisplacement"
      component="1"
      scale="0.0"
      setNames="{ yneg, ypos }"/>

    <FieldSpecification
      name="zconstraint"
      objectPath="nodeManager"
      fieldName="totalDisplacement"
      component="2"
      scale="0.0"
      setNames="{ zneg, zpos }"/>

    <SourceFlux
      name="sourceTerm"
      objectPath="ElementRegions/Fracture"
      scale="-6.625"
      setNames="{ source }"/>
  </FieldSpecifications>

  <Functions>
    <TableFunction
      name="apertureTable"
      coordinates="{ -0.01, -1.0e-3, 0.0 }"
      values="{ 0.005e-3, 0.01e-3, 0.02e-3 }"/>
  </Functions>

  <Tasks>
    <PackCollection
      name="pressureCollection"
      objectPath="ElementRegions/Fracture/FractureSubRegion"
      fieldName="pressure"/>

    <PackCollection
      name="temperatureCollection"
      objectPath="ElementRegions/Fracture/FractureSubRegion"
      fieldName="temperature"/>

    <PackCollection
      name="apertureCollection"
      objectPath="ElementRegions/Fracture/FractureSubRegion"
      fieldName="elementAperture"/>

    <PackCollection
      name="hydraulicApertureCollection"
      objectPath="ElementRegions/Fracture/FractureSubRegion"
      fieldName="hydraulicAperture"/>
  </Tasks>

  <Outputs>
    <VTK
      name="vtkOutput"
      plotFileRoot="pennyShapedViscosityDominated_thermal"
      plotLevel="3"/>

    <TimeHistory
      name="timeHistoryOutput"
      sources="{/Tasks/pressureCollection, /Tasks/temperatureCollection, /Tasks/apertureCollection, /Tasks/hydraulicApertureCollection}"
      filename="pennyShapedViscosityDominated_thermal_output"/>

    <Restart
      name="restartOutput"/>
  </Outputs>
</Problem>
