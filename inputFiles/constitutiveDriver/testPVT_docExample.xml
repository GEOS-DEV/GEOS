<?xml version="1.0" ?>

<!-- Simple PVTDriver example with sphinx markup for use on our doc pages -->
<Problem>
  <!-- SPHINX_PVTDRIVER_CONSTITUTIVE_START -->
  <Constitutive>
    <CO2BrinePhillipsFluid
      name="co2Mixture"
      phaseNames="{ gas, water }"
      componentNames="{ co2, water }"
      componentMolarWeight="{ 44e-3, 18e-3 }"
      pressureCoordinates="{1e6, 5e7}"
      pressureInterval="1e6"
      temperatureCoordinates="{340, 350}"
      temperatureInterval="10"
      salinity="0.0" />
  </Constitutive>

  <!-- SPHINX_PVTDRIVER_CONSTITUTIVE_END -->
  <!-- SPHINX_PVTDRIVER_FUNCTIONS_START -->
  <Functions>
    <TableFunction
      name="pressureFunction"
      inputVarNames="{ time }"
      coordinates="{ 0.0, 1.0 }"
      values="{ 1e6, 50e6 }"/>

    <TableFunction
      name="temperatureFunction"
      inputVarNames="{ time }"
      coordinates="{ 0.0, 1.0 }"
      values="{ 350, 350 }"/>
  </Functions>

  <!-- SPHINX_PVTDRIVER_FUNCTIONS_END -->
  <!-- SPHINX_PVTDRIVER_TASKS_START -->
  <Tasks>
    <PVTDriver
      name="testCO2"
      fluid="co2Mixture"
      feedComposition="{ 1.0, 0.0 }"
      pressureControl="pressureFunction"
      temperatureControl="temperatureFunction"
      steps="49"
      output="pvtOutput.txt"
      logLevel="1"/>
  </Tasks>
  <!-- SPHINX_PVTDRIVER_TASKS_END -->

  <Outputs>
    <Restart
      name="restartOutput"/>
  </Outputs>

  <Events
    maxTime="1">

    <!-- SPHINX_PVTDRIVER_EVENTS_START -->
    <SoloEvent
      name="eventA"
      target="/Tasks/testCO2"/>
    <!-- SPHINX_PVTDRIVER_EVENTS_END -->

    <PeriodicEvent
      name="restarts"
      timeFrequency="1"
      targetExactTimestep="0"
      target="/Outputs/restartOutput"/>        
  </Events>

</Problem>
