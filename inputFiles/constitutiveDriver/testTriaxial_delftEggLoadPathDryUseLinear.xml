<?xml version="1.0" ?>

<Problem>
  <Tasks>
    <TriaxialDriver
      name="triaxialDriver"
      material="DE"
      mode="mixedControl"
      axialControl="strainFunction"
      radialControl="stressFunction"
      initialStress="-1.0"
      steps="50"
      logLevel="1"
      output="testTriaxial_delftEggLoadPathDryUseLinear.txt" />
  </Tasks>
  
  <Outputs>
    <Restart
      name="restartOutput"/>
  </Outputs>

  <Events
    maxTime="1">
    <SoloEvent
      name="triaxialDriver"
      target="/Tasks/triaxialDriver"/>

    <PeriodicEvent
      name="restarts"
      timeFrequency="1"
      targetExactTimestep="0"
      target="/Outputs/restartOutput"/>      
  </Events>

  <Constitutive>
    <DelftEgg
      name="DE"
      defaultDensity="2700"
      defaultBulkModulus="500.0"
      defaultShearModulus="200.0"
      defaultPreConsolidationPressure="-3.1"
      defaultShapeParameter="1.8"
      defaultCslSlope="1.2"
      defaultVirginCompressionIndex="0.003"
      defaultRecompressionIndex="0.002"/>
  </Constitutive>

  <Functions>
    <TableFunction
      name="strainFunction"
      inputVarNames="{ time }"
      coordinates="{ 0.0, 1.0 }"
      values="{ 0, -0.008 }"/>

    <TableFunction
      name="stressFunction"
      inputVarNames="{ time }"
      coordinates="{ 0.0, 1.0 }"
      values="{ -1.0, -1.0 }"/>
  </Functions>
</Problem>
