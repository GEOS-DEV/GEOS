<?xml version="1.0" ?>

<Problem>
  <Tasks>
    <TriaxialDriver
      name="triaxialDriver"
      material="DE"
      mode="mixedControl"
      axialControl="strainFunction"
      radialControl="stressFunction"
      initialStress="-4.6e6"
      steps="50"
      logLevel="1"
      output="testTriaxial_delftEggCase2.txt" />
  </Tasks>
  
  <Outputs>
    <Restart
      name="restartOutput"/>
  </Outputs>

  <Events
    maxTime="1">
    <SoloEvent
      name="triaxialDriver"
      target="/Tasks/triaxialDriver"/>

    <PeriodicEvent
      name="restarts"
      timeFrequency="1"
      targetExactTimestep="0"
      target="/Outputs/restartOutput"/>      
  </Events>

  <Constitutive>
    <DelftEgg
      name="DE"
      defaultDensity="2700"
      defaultBulkModulus="10.15e9"
      defaultShearModulus="5.54e9"
      defaultPreConsolidationPressure="-34.0e6"
      defaultShapeParameter="9.5"
      defaultCslSlope="1.2"
      defaultVirginCompressionIndex="0.008"
      defaultRecompressionIndex="0.001"/>
  </Constitutive>

  <Functions>
    <TableFunction
      name="strainFunction"
      inputVarNames="{ time }"
      coordinates="{ 0.0, 1.0 }"
      values="{ 0, -0.004 }"/>

    <TableFunction
      name="stressFunction"
      inputVarNames="{ time }"
      coordinates="{ 0.0, 1.0 }"
      values="{ -4.6e6, -4.6e6 }"/>
  </Functions>
</Problem>
