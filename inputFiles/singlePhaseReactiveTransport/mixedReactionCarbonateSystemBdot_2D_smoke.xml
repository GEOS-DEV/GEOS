<?xml version="1.0" ?>

<Problem>
  <Included>
    <File name="./mixedReactionCarbonateSystemBdot_2D_base.xml" />
    <File name="./mixedReactionCarbonateSystem_initialAggregate.xml" />
    <File name="./mixedReactionCarbonateSystem_initialPrimaryConc.xml" />
    <File name="./mixedReactionCarbonateSystem_logConc.xml" />
  </Included>

  <Mesh>
    <InternalMesh
      name="mesh1"
      elementTypes="{ C3D8 }"
      xCoords="{ 0, 1, 10 }"
      yCoords="{ 0, 0.01, 10 }"
      zCoords="{ 0, 1 }"
      nx="{ 5, 45}"
      ny="{ 1, 49 }"
      nz="{ 1 }"
      cellBlockNames="{ block1 }"/>
  </Mesh>

  <Geometry>
    <Box
      name="source"
      xMin="{ -0.001, -0.001, -0.01 }"
      xMax="{ 1.001, 0.011, 1.01 }"/>
  </Geometry>

  <Events
    maxTime="40">
    <PeriodicEvent
      name="outputs"
      timeFrequency="5"
      target="/Outputs/vtkOutput"/>

    <PeriodicEvent
      name="solverApplications"
      maxEventDt="1.0"
      target="/Solvers/SinglePhaseReactiveFlow"/>

    <PeriodicEvent
      name="restarts"
      timeFrequency="20"
      target="/Outputs/restartOutput"/>
  </Events>

</Problem>
