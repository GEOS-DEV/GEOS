<?xml version="1.0" ?>
<Problem>
  <Mesh>
    <VTKMesh name="mesh1" file="../meshes/fractured_mesh_tet_non_trivial.vtu" nodesetNames="{ ruptureState }"/>
  </Mesh>
  <Geometry>

    <!-- X faces -->
    <Box name="xnegFace"
         xMin="{ -0.09827148, -0.10466309, -8000.7 }"
         xMax="{  0.10172852,  5738.97,    -1472.18 }"/>

    <Box name="xposFace"
         xMin="{  4388.0,     -0.10466309, -8000.7 }"
         xMax="{  4388.2,      5738.97,    -1472.18 }"/>

    <!-- Y faces -->
    <Box name="ynegFace"
         xMin="{ -0.09827148, -0.10466309, -8000.7 }"
         xMax="{  4388.2,      0.09533691, -1472.18 }"/>

    <Box name="yposFace"
         xMin="{ -0.09827148,  5738.77,    -8000.7 }"
         xMax="{  4388.2,      5738.97,    -1472.18 }"/>

    <!-- Z faces -->
    <Box name="znegFace"
         xMin="{ -0.09827148, -0.10466309, -8000.7 }"
         xMax="{  4388.2,      5738.97,    -8000.5 }"/>

    <Box name="zposFace"
         xMin="{ -0.09827148, -0.10466309, -1472.38 }"
         xMax="{  4388.2,      5738.97,    -1472.18 }"/>

    <!-- Full domain -->
    <Box name="fracture"
         xMin="{ -0.09827148, -0.10466309, -8000.7 }"
         xMax="{  4388.2,      5738.97,    -1472.18 }"/>
  </Geometry>
  <Solvers gravityVector="{0.0, 0.0, 0.0}">
    <SolidMechanicsAugmentedLagrangianContact name="mechSolver" discretization="FE1" targetRegions="{ Region, Fracture }" logLevel="1">
      <NonlinearSolverParameters newtonTol="1.0e-2" newtonMaxIter="20" logLevel="1"/>
      <LinearSolverParameters solverType="gmres" preconditionerType="amg" krylovTol="1.0e-7" logLevel="1"/>
    </SolidMechanicsAugmentedLagrangianContact>
    <SurfaceGenerator name="SurfaceGen" targetRegions="{ Region, Fracture }" fractureRegion="Fracture" initialRockToughness="1.0e60"/>
  </Solvers>
  <NumericalMethods>
    <FiniteElements>
      <FiniteElementSpace name="FE1" order="1"/>
    </FiniteElements>
  </NumericalMethods>
  <ElementRegions>
    <CellElementRegion name="Region" cellBlocks="{ * }" materialList="{ rock }"/>
    <SurfaceElementRegion name="Fracture" defaultAperture="1.0e-4" faceBlock="faceElementSubRegion" materialList="{ fractureContact }"/>
  </ElementRegions>
  <Constitutive>
    <ElasticIsotropic name="rock" defaultDensity="2500" defaultYoungModulus="10e9" defaultPoissonRatio="0.2"/>
    <Coulomb name="fractureContact" cohesion="0.0" frictionCoefficient="0.0"/>
  </Constitutive>
  <FieldSpecifications>
    <FieldSpecification name="separableFace" fieldName="isFaceSeparable" initialCondition="1" setNames="{ ruptureState }" objectPath="faceManager" scale="1" />
    <FieldSpecification name="frac" initialCondition="1" setNames="{ ruptureState }" objectPath="faceManager" fieldName="ruptureState" scale="1" />
    <!-- Tensile BCs: Pulling outwards on all faces -->
    <FieldSpecification name="xneg_disp" component="0" setNames="{ xnegFace }" objectPath="nodeManager" fieldName="totalDisplacement" scale="-1.0e-4"/>
    <FieldSpecification name="xpos_disp" component="0" setNames="{ xposFace }" objectPath="nodeManager" fieldName="totalDisplacement" scale="1.0e-4"/>
    <FieldSpecification name="yneg_disp" component="1" setNames="{ ynegFace }" objectPath="nodeManager" fieldName="totalDisplacement" scale="-1.0e-4"/>
    <FieldSpecification name="ypos_disp" component="1" setNames="{ yposFace }" objectPath="nodeManager" fieldName="totalDisplacement" scale="1.0e-4"/>
    <FieldSpecification name="zneg_disp" component="2" setNames="{ znegFace }" objectPath="nodeManager" fieldName="totalDisplacement" scale="-1.0e-4"/>
    <FieldSpecification name="zpos_disp" component="2" setNames="{ zposFace }" objectPath="nodeManager" fieldName="totalDisplacement" scale="1.0e-4"/>
  </FieldSpecifications>
  <Outputs>
    <VTK name="vtkOutput" />
  </Outputs>
  <Events maxTime="1.0">
    <SoloEvent name="preFracture" target="/Solvers/SurfaceGen"/>
    <PeriodicEvent name="outputs" timeFrequency="1.0" target="/Outputs/vtkOutput"/>
    <PeriodicEvent name="solverApplications" target="/Solvers/mechSolver" forceDt="1.0"/>
  </Events>
</Problem>
