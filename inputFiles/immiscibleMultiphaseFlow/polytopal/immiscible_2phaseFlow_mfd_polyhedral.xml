<?xml version="1.0"?>

<!-- ------------------------------------------------------------------
 Simple 1D two‑phase immiscible flow example using the
 ImmiscibleMultiphaseFlowMFD solver with a hybrid mimetic (polytopal)
 discretization. The problem drives flow from a left high‑pressure
 box region to a right low‑pressure box region.
------------------------------------------------------------------- -->
<Problem>
  <Solvers gravityVector="{ 0.0, 0.0, -10.0 }">
    <ImmiscibleMultiphaseFlowMFD
      name="FlowSolverMFD"
      discretization="immiscibleHybridMimetic"
      targetRegions="{ Domain }"
      logLevel="2"
      dependentPhaseIndex="1">
      <NonlinearSolverParameters 
        newtonTol="1e-4"
        lineSearchAction="None"
        maxTimeStepCuts="100"
        maxSubSteps="100"
        newtonMaxIter="10"/>
      <LinearSolverParameters 
        directParallel="0"
        reuseFactorization="0"/>
    </ImmiscibleMultiphaseFlowMFD>
  </Solvers>

  <Mesh>
    <VTKMesh
      name="mesh"
      logLevel="5"  
      partitionRefinement="0"
      useGlobalIds="0"
      file="polyhedral_extruded_layers_rot_coarse.vtk"/>
  </Mesh>

  <Geometry>      
    <Box name="top_BC" 
      xMin="{ -0.0001, -0.0001, 0.9999 }" 
      xMax="{ 1.0001, 1.0001, 1.0001 }"/>   
  </Geometry>

  <Events maxTime="25920000">
    <PeriodicEvent name="outputs" timeFrequency="86400" target="/Outputs/vtkOutput"/>
    <PeriodicEvent name="solverApps" forceDt="86400" target="/Solvers/FlowSolverMFD"/>
  </Events>

  <NumericalMethods>
    <FiniteVolume>
      <!-- Hybrid mimetic discretization; choose innerProductType (TPFA, quasiTPFA, quasiRT, simple) -->
      <HybridMimeticDiscretization name="immiscibleHybridMimetic" innerProductType="simple"/>
    </FiniteVolume>
  </NumericalMethods>

  <ElementRegions>
    <CellElementRegion name="Domain" cellBlocks="{ *  }" materialList="{ fluid, rock, relperm }"/>
  </ElementRegions>

  <Functions>
    <!-- Constant property tables (single entry) -->
    <TableFunction name="densityWater"   coordinates="{ 0.0 }" values="{ 1000.0 }"/>
    <TableFunction name="densityGas"     coordinates="{ 0.0 }" values="{ 500.0 }"/>
    <TableFunction name="viscosityWater" coordinates="{ 0.0 }" values="{ 1.0e-3 }"/>
    <TableFunction name="viscosityGas"   coordinates="{ 0.0 }" values="{ 1.0e-3 }"/>

    <!-- Linear relative permeability tables -->
    <TableFunction
      name="waterRelativePermeabilityTable"
      coordinates="{ 0.0, 1.0 }"
      values="{ 0.0, 1.0 }"/>
    <TableFunction
      name="gasRelativePermeabilityTable"
      coordinates="{ 0.0, 1.0 }"
      values="{ 0.0, 1.0 }"/>
  </Functions>

  <Constitutive>
    <TwoPhaseImmiscibleFluid
      name="fluid"
      phaseNames="{ water, gas }"
      densityTableNames="{ densityWater, densityGas }"
      viscosityTableNames="{ viscosityWater, viscosityGas }"/>

    <CompressibleSolidConstantPermeability
      name="rock"
      solidModelName="nullSolid"
      porosityModelName="rockPorosity"
      permeabilityModelName="rockPerm"/>

    <NullModel name="nullSolid"/>

    <PressurePorosity name="rockPorosity" defaultReferencePorosity="0.25" referencePressure="0" compressibility="0.0"/>

    <ConstantPermeability name="rockPerm" permeabilityComponents="{ 2.5e-15, 2.5e-15, 2.5e-15 }"/>

    <BrooksCoreyRelativePermeability
      name="relperm"
      phaseNames="{ gas, water }"
      phaseMinVolumeFraction="{ 0.0, 0.0 }"
      phaseRelPermExponent="{ 1.0, 1.0 }"
      phaseRelPermMaxValue="{ 1.0, 1.0 }"/>

  </Constitutive>

  <FieldSpecifications>
    <FieldSpecification name="Porosity" initialCondition="1" setNames="{ all }"
      objectPath="ElementRegions/Domain" fieldName="rockPorosity_referencePorosity" scale="0.25"/>

    <FieldSpecification name="initialPressure" initialCondition="1" setNames="{ all }"
      objectPath="ElementRegions/Domain" fieldName="pressure" scale="1.0e7"/>
    <FieldSpecification name="initialfacePressure" initialCondition="1" setNames="{ all }"
      objectPath="faceManager" fieldName="facePressure" scale="1.0e7"/>      

    <!-- Initial saturations (phaseVolumeFraction component index: 0=water, 1=gas) -->
    <FieldSpecification name="initSatWater" initialCondition="1" setNames="{ all }"
      objectPath="ElementRegions/Domain" fieldName="phaseVolumeFraction" component="0" scale="0.5"/>
    <FieldSpecification name="initSatGas" initialCondition="1" setNames="{ all }"
      objectPath="ElementRegions/Domain" fieldName="phaseVolumeFraction" component="1" scale="0.5"/>

    <!-- Pressure BC regions -->
    <FieldSpecification name="topPressure" objectPath="faceManager"
      fieldName="bcPressure" scale="1.0e7" setNames="{ top_BC }"/>

  </FieldSpecifications>

  <Outputs>
    <VTK name="vtkOutput"/>
  </Outputs>
</Problem>


