<?xml version="1.0"?>

<!-- ------------------------------------------------------------------
 Simple 1D two‑phase immiscible flow example using the
 ImmiscibleMultiphaseFlowMFD solver with a hybrid mimetic (polytopal)
 discretization. The problem drives flow from a left high‑pressure
 box region to a right low‑pressure box region.
------------------------------------------------------------------- -->
<Problem>
  <Solvers gravityVector="{ 0.0, 0.0, 0.0 }">
    <ImmiscibleMultiphaseFlowMFD
      name="FlowSolverMFD"
      discretization="immiscibleHybridMimetic"
      targetRegions="{ Domain }"
      logLevel="2"
      dependentPhaseIndex="1">
      <NonlinearSolverParameters newtonTol="1.0e-2" newtonMaxIter="3"/>
      <LinearSolverParameters directParallel="0"/>
    </ImmiscibleMultiphaseFlowMFD>
  </Solvers>

  <Mesh>
    <!-- 1D line extruded to thin 1x1 cross section -->
    <InternalMesh name="mesh1"
                  elementTypes="{ C3D8 }"
                  xCoords="{ 0, 3 }"
                  yCoords="{ 0, 1 }"
                  zCoords="{ 0, 1 }"
                  nx="{ 3 }" ny="{ 1 }" nz="{ 1 }"
                  cellBlockNames="{ block1 }"/>
  </Mesh>

  <Geometry>
    <Box name="source" 
      xMin="{ -0.01, -0.01, -0.01 }" 
      xMax="{ 1.01, 1.01, 1.01 }"/>
    <Box name="sink"   
      xMin="{ 1.99, -0.01, -0.01 }" 
      xMax="{ 3.01, 1.01, 1.01 }"/>
    <Box name="west_BC"   
      xMin="{ -0.01, -0.01, -0.01 }" 
      xMax="{ +0.01, 1.01, 1.01 }"/>      
    <Box name="east_BC" 
      xMin="{ 2.99, -0.01, -0.01 }" 
      xMax="{ 3.01, 1.01, 1.01 }"/>
  </Geometry>

  <Events maxTime="1">
    <PeriodicEvent name="outputs" timeFrequency="1" target="/Outputs/vtkOutput"/>
    <PeriodicEvent name="solverApps" forceDt="1" target="/Solvers/FlowSolverMFD"/>
  </Events>

  <NumericalMethods>
    <FiniteVolume>
      <!-- Hybrid mimetic discretization; choose innerProductType (tpfa, quasiTPFA, quasiRT, simple) -->
      <HybridMimeticDiscretization name="immiscibleHybridMimetic" innerProductType="TPFA"/>
    </FiniteVolume>
  </NumericalMethods>

  <ElementRegions>
    <CellElementRegion name="Domain" cellBlocks="{ block1 }" materialList="{ fluid, rock, relperm }"/>
  </ElementRegions>

  <Functions>
    <!-- Constant property tables (single entry) -->
    <TableFunction name="densityWater"   coordinates="{ 0 }" values="{ 1000.0 }"/>
    <TableFunction name="densityGas"     coordinates="{ 0 }" values="{ 1000.0 }"/>
    <TableFunction name="viscosityWater" coordinates="{ 0 }" values="{ 1.0e-3 }"/>
    <TableFunction name="viscosityGas"   coordinates="{ 0 }" values="{ 1.0e-3 }"/>

    <!-- Linear relative permeability tables -->
    <TableFunction
      name="waterRelativePermeabilityTable"
      coordinates="{ 0.0, 1.0 }"
      values="{ 0.0, 1.0 }"/>
    <TableFunction
      name="gasRelativePermeabilityTable"
      coordinates="{ 0.0, 1.0 }"
      values="{ 0.0, 1.0 }"/>
  </Functions>

  <Constitutive>
    <TwoPhaseImmiscibleFluid
      name="fluid"
      phaseNames="{ water, gas }"
      densityTableNames="{ densityWater, densityGas }"
      viscosityTableNames="{ viscosityWater, viscosityGas }"/>

    <CompressibleSolidConstantPermeability
      name="rock"
      solidModelName="nullSolid"
      porosityModelName="rockPorosity"
      permeabilityModelName="rockPerm"/>

    <NullModel name="nullSolid"/>

    <PressurePorosity name="rockPorosity" defaultReferencePorosity="0.0" referencePressure="0" compressibility="0.0"/>

    <ConstantPermeability name="rockPerm" permeabilityComponents="{ 1.0e-14, 1.0e-14, 1.0e-14 }"/>

    <TableRelativePermeability
      name="relperm"
      phaseNames="{ water, gas }"
      wettingNonWettingRelPermTableNames="{ waterRelativePermeabilityTable, gasRelativePermeabilityTable }"/>
  </Constitutive>

  <FieldSpecifications>
    <FieldSpecification name="Porosity" initialCondition="1" setNames="{ all }"
      objectPath="ElementRegions/Domain/block1" fieldName="rockPorosity_referencePorosity" scale="0.05"/>

    <FieldSpecification name="initialPressure" initialCondition="1" setNames="{ all }"
      objectPath="ElementRegions/Domain/block1" fieldName="pressure" scale="1.0e7"/>
    <FieldSpecification name="initialfacePressure" initialCondition="1" setNames="{ all }"
      objectPath="faceManager" fieldName="facePressure" scale="1.0e7"/>      

    <!-- Initial saturations (phaseVolumeFraction component index: 0=water, 1=gas) -->
    <FieldSpecification name="initSatWater" initialCondition="1" setNames="{ all }"
      objectPath="ElementRegions/Domain/block1" fieldName="phaseVolumeFraction" component="0" scale="0.5"/>
    <FieldSpecification name="initSatGas" initialCondition="1" setNames="{ all }"
      objectPath="ElementRegions/Domain/block1" fieldName="phaseVolumeFraction" component="1" scale="0.5"/>

    <!-- Pressure BC regions -->
    <FieldSpecification name="westPressure" objectPath="faceManager"
      fieldName="bcPressure" scale="2.0e7" setNames="{ west_BC }"/>
    <FieldSpecification name="eastPressure" objectPath="faceManager"
      fieldName="bcPressure" scale="1.0e7" setNames="{ east_BC }"/>
  </FieldSpecifications>

    <!-- Phase source/sink: inject independent phase (component=1), produce dependent phase (component=0) -->
<!--     <SourceFlux name="independentPhaseSource"
      objectPath="ElementRegions/Domain/block1"
      setNames="{ source }"
      component="0"
      scale="-7.0e-5"/> -->

<!--     <SourceFlux name="dependentPhaseSink"
      objectPath="ElementRegions/Domain/block1"
      setNames="{ sink }"
      component="0"
      scale="7.0e-5"/>   -->

  <Outputs>
    <VTK name="vtkOutput"/>
  </Outputs>
</Problem>
