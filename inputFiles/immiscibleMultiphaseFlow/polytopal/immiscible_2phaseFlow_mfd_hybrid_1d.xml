<?xml version="1.0"?>

<Problem>
  <Solvers gravityVector="{ 0.0, 0.0, -9.81 }">
    <ImmiscibleMultiphaseFlowMFD
      name="FlowSolverMFD"
      discretization="immiscibleHybridMimetic"
      targetRegions="{ Domain }"
      logLevel="2"
      dependentPhaseIndex="0">
      <NonlinearSolverParameters newtonTol="1e-6" newtonMaxIter="8"/>
      <LinearSolverParameters directParallel="0"/>
    </ImmiscibleMultiphaseFlowMFD>
  </Solvers>

  <Mesh>
    <!-- 1D line extruded to thin 1x1 cross section -->
    <InternalMesh name="mesh1"
                  elementTypes="{ C3D8 }"
                  xCoords="{ 0, 2 }"
                  yCoords="{ 0, 1 }"
                  zCoords="{ 0, 1 }"
                  nx="{ 2 }" ny="{ 1 }" nz="{ 1 }"
                  cellBlockNames="{ block1 }"/>
  </Mesh>

  <Geometry>
    <Box name="source" 
      xMin="{ -0.01, -0.01, -0.01 }" 
      xMax="{ 1.01, 1.01, 1.01 }"/>
    <Box name="sink"   
      xMin="{ 0.99, -0.01, -0.01 }" 
      xMax="{ 2.01, 1.01, 1.01 }"/>
  </Geometry>

  <Events maxTime="1">
    <PeriodicEvent 
      name="outputs" 
      timeFrequency="1" 
      target="/Outputs/vtkOutput"/>
    <PeriodicEvent 
      name="solverApps" 
      forceDt="1" 
      target="/Solvers/FlowSolverMFD"/>
  </Events>

  <NumericalMethods>
    <FiniteVolume>
      <!-- Hybrid mimetic discretization; choose innerProductType (tpfa, quasiTPFA, quasiRT, simple) -->
      <HybridMimeticDiscretization name="immiscibleHybridMimetic" innerProductType="quasiTPFA"/>
    </FiniteVolume>
  </NumericalMethods>

  <ElementRegions>
    <CellElementRegion name="Domain" cellBlocks="{ block1 }" materialList="{ fluid, rock, relperm }"/>
  </ElementRegions>

  <Functions>
    <!-- Constant property tables (single entry) -->
    <TableFunction name="densityWater"   coordinates="{ 0 }" values="{ 1000 }"/>
    <TableFunction name="densityGas"     coordinates="{ 0 }" values="{ 1.0 }"/>
    <TableFunction name="viscosityWater" coordinates="{ 0 }" values="{ 1.0e-3 }"/>
    <TableFunction name="viscosityGas"   coordinates="{ 0 }" values="{ 1.0e-3 }"/>
  </Functions>

  <Constitutive>
    <TwoPhaseImmiscibleFluid
      name="fluid"
      phaseNames="{ water, gas }"
      densityTableNames="{ densityWater, densityGas }"
      viscosityTableNames="{ viscosityWater, viscosityGas }"/>

    <CompressibleSolidConstantPermeability
      name="rock"
      solidModelName="nullSolid"
      porosityModelName="rockPorosity"
      permeabilityModelName="rockPerm"/>

    <NullModel name="nullSolid"/>

    <PressurePorosity name="rockPorosity" defaultReferencePorosity="0.05" referencePressure="0" compressibility="1.0e-9"/>

    <ConstantPermeability name="rockPerm" permeabilityComponents="{ 1.0e-13, 1.0e-13, 1.0e-13 }"/>

    <BrooksCoreyRelativePermeability
      name="relperm"
      phaseNames="{ gas, water }"
      phaseMinVolumeFraction="{ 0.0, 0.0 }"
      phaseRelPermExponent="{ 1.5, 1.5 }"
      phaseRelPermMaxValue="{ 0.9, 0.9 }"/>
  </Constitutive>

  <FieldSpecifications>
    <FieldSpecification name="Porosity" initialCondition="1" setNames="{ all }"
      objectPath="ElementRegions/Domain/block1" fieldName="rockPorosity_referencePorosity" scale="0.05"/>

    <FieldSpecification 
      name="initialPressure" 
      initialCondition="1" 
      setNames="{ all }"
      objectPath="ElementRegions/Domain/block1" 
      fieldName="pressure" 
      scale="1.0e7"/>

    <!-- Initial saturations (phaseVolumeFraction component index: 0=water, 1=gas) -->
    <FieldSpecification 
      name="initSatWater" 
      initialCondition="1" 
      setNames="{ all }"
      objectPath="ElementRegions/Domain/block1" 
      fieldName="phaseVolumeFraction" 
      component="0" 
      scale="1"/>
    <FieldSpecification 
      name="initSatGas" 
      initialCondition="1" 
      setNames="{ all }"
      objectPath="ElementRegions/Domain/block1" 
      fieldName="phaseVolumeFraction" 
      component="1" 
      scale="0"/>

    <!-- Pressure BC regions -->
    <FieldSpecification 
      name="sourcePressure" 
      objectPath="ElementRegions/Domain/block1"
      fieldName="pressure" 
      scale="2.0e7" 
      setNames="{ source }"/>
    <FieldSpecification 
      name="sinkPressure" 
      objectPath="ElementRegions/Domain/block1"
      fieldName="pressure" 
      scale="1.0e7" 
      setNames="{ sink }"/>
  </FieldSpecifications>

  <Outputs>
    <VTK name="vtkOutput"/>
  </Outputs>
</Problem>
