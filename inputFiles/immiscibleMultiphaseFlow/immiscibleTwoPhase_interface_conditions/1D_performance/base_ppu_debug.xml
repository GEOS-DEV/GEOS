<?xml version="1.0" ?>

<Problem>
  <!-- SPHINX_SOLVER -->
  <Solvers
   gravityVector="{ 0.0, 0.0, 9.81 }">
    <ImmiscibleMultiphaseFlow
      name="FlowSolver"
      logLevel="0"
      discretization="TPFA"
      temperature="300"
      initialDt="0.00001"
      targetRegions="{ region_left, region_right }">
      <NonlinearSolverParameters
        newtonTol="1.0e-6"
        newtonMaxIter="20"
        maxTimeStepCuts="20"
	     maxSubSteps="2000"
       lineSearchAction="None"
       timeStepIncreaseIterLimit="0.5"
       timeStepDecreaseIterLimit="0.6"/>
<!--      <LinearSolverParameters
        solverType="direct"
        directParallel="0"  
        logLevel="0"/> -->
      <LinearSolverParameters
        solverType="fgmres"
        preconditionerType="mgr"
        krylovTol="1e-6"
        krylovMaxIter="100"
        logLevel="0" />
    </ImmiscibleMultiphaseFlow>  
  </Solvers>
  <!-- SPHINX_SOLVER_END -->
 
  <!-- SPHINX_NUMERICAL -->
  <NumericalMethods>
    <FiniteVolume>
      <TwoPointFluxApproximation
        name="TPFA"/>
    </FiniteVolume>
  </NumericalMethods>
  <!-- SPHINX_NUMERICAL_END -->

  <!-- SPHINX_ELEMENTREGIONS -->
  <ElementRegions>
    <CellElementRegion
      name="region_left"
      cellBlocks="{ cb_left }"
      materialList="{ fluid_left, rock, relperm_left, capPressure_left }"/>

    <CellElementRegion
      name="region_right"
      cellBlocks="{ cb_right }"
      materialList="{ fluid_right, rock, relperm_right, capPressure_right }"/>      

  </ElementRegions>
  <!-- SPHINX_ELEMENTREGIONS_END -->

  <!-- SPHINX_MATERIAL -->
  <Functions>
    <TableFunction
      name="densityTablePhase1"
      coordinates="{ 0.0}"
      values="{ 900 }" />
    <TableFunction
      name="densityTablePhase2"
      coordinates="{ 0.0 }"
      values="{ 400 }" />
    <TableFunction
      name="viscosityTablePhase1"
      coordinates="{ 0.0}"
      values="{ 0.001 }" />                  
    <TableFunction
      name="viscosityTablePhase2"
      coordinates="{ 0.0 }"
      values="{ 0.001 }" />
    <TableFunction
      name="saturationTable1"
      inputVarNames="{ elementCenter }"
      coordinateFiles="{ x.txt, y.txt, z.txt }"
      voxelFile="initialSaturation1.txt"
      interpolation="nearest" />
    <TableFunction
      name="saturationTable2"
      inputVarNames="{ elementCenter }"
      coordinateFiles="{ x.txt, y.txt, z.txt }"
      voxelFile="initialSaturation2.txt"
      interpolation="nearest" />
    <TableFunction
      name="pressureTable"
      inputVarNames="{ elementCenter }"
      coordinateFiles="{ x.txt, y.txt, z.txt }"
      voxelFile="initialPressure.txt"
      interpolation="nearest" />
    <TableFunction 
      name="permxFunc"
      inputVarNames="{elementCenter}"
      coordinateFiles="{x.txt,y.txt,z.txt}"
      voxelFile="permx.geos"
      interpolation="nearest" />
    <TableFunction 
      name="permyFunc"
      inputVarNames="{elementCenter}"
      coordinateFiles="{x.txt,y.txt,z.txt}"
      voxelFile="permy.geos"
      interpolation="nearest" />
    <TableFunction 
      name="permzFunc"
      inputVarNames="{elementCenter}"
      coordinateFiles="{x.txt,y.txt,z.txt}"
      voxelFile="permz.geos"
      interpolation="nearest" />
    <TableFunction
      name="drainageWaterRelativePermeabilityTable"
      coordinateFiles="{ consistentHystCurves/drainagePhaseVolFraction_water.txt }"
      voxelFile="consistentHystCurves/drainageRelPerm_water.txt"/>
    <TableFunction
      name="drainageGasRelativePermeabilityTable"
      coordinateFiles="{ consistentHystCurves/drainagePhaseVolFraction_gas_sorted.txt }"
      voxelFile="consistentHystCurves/drainageRelPerm_gas_sorted.txt"/>
    <TableFunction
      name="imbibitionWaterRelativePermeabilityTable"
      coordinateFiles="{ consistentHystCurves/imbibitionPhaseVolFraction_water.txt }"
      voxelFile="consistentHystCurves/imbibitionRelPerm_water.txt"/>
    <TableFunction
      name="imbibitionGasRelativePermeabilityTable"
      coordinateFiles="{ consistentHystCurves/imbibitionPhaseVolFraction_gas_sorted.txt }"
      voxelFile="consistentHystCurves/imbibitionRelPerm_gas_sorted.txt"/>
     
    <TableFunction
      name="drainageWaterGasCapPresTable_left"
      coordinateFiles="{ consistentHystCurves/drainagePhaseVolFraction_water.txt }"
      voxelFile="consistentHystCurves/drainageCapPres_Land_left.txt"/>
    <TableFunction
      name="imbibitionWaterGasCapPresTable_left"
      coordinateFiles="{ consistentHystCurves/imbibitionPhaseVolFraction_water.txt }"
      voxelFile="consistentHystCurves/imbibitionCapPres_Land_left.txt"/>


    <TableFunction
      name="drainageWaterGasCapPresTable_right"
      coordinateFiles="{ consistentHystCurves/drainagePhaseVolFraction_water.txt }"
      voxelFile="consistentHystCurves/drainageCapPres_Land_right.txt"/>
    <TableFunction
      name="imbibitionWaterGasCapPresTable_right"
      coordinateFiles="{ consistentHystCurves/imbibitionPhaseVolFraction_water.txt }"
      voxelFile="consistentHystCurves/imbibitionCapPres_Land_right.txt"/>



 </Functions>

  <Constitutive>
    <CompressibleSolidConstantPermeability
      name="rock"
      solidModelName="nullSolid"
      porosityModelName="rockPorosity"
      permeabilityModelName="rockPerm"/>

    <NullModel
      name="nullSolid"/>

    <PressurePorosity
      name="rockPorosity"
      defaultReferencePorosity="0.25"
      referencePressure="1e7"
      compressibility="1.0e-15"/>

    <ConstantPermeability
      name="rockPerm"
      permeabilityComponents="{ 1.0e-14, 1.0e-14, 1.0e-14}"/>   

    <TableRelativePermeability
      name="relperm_left"
      phaseNames="{ water, gas }"
      wettingNonWettingRelPermTableNames="{ drainageWaterRelativePermeabilityTable,
                                          drainageGasRelativePermeabilityTable }"/>

    <TableRelativePermeability
      name="relperm_right"
      phaseNames="{ water, gas }"
      wettingNonWettingRelPermTableNames="{ drainageWaterRelativePermeabilityTable,
                                          drainageGasRelativePermeabilityTable }"/>



<!--    <BrooksCoreyRelativePermeability
      name="relperm_left"
      phaseNames="{ water, gas }"
      phaseMinVolumeFraction="{ 0.0, 0.0 }"
      phaseRelPermExponent="{ 2.0, 2.0 }"
      phaseRelPermMaxValue="{ 1.0, 1.0 }"/>

    <BrooksCoreyRelativePermeability
      name="relperm_right"
      phaseNames="{ water, gas }"
      phaseMinVolumeFraction="{ 0.0, 0.0 }"
      phaseRelPermExponent="{ 2.0, 2.0 }"
      phaseRelPermMaxValue="{ 1.0, 1.0 }"/> 

   <TableRelativePermeabilityHysteresis
      name="relperm_left"
      phaseNames="{ water, gas }"
      drainageWettingNonWettingRelPermTableNames="{ drainageWaterRelativePermeabilityTable, drainageGasRelativePermeabilityTable }"
      imbibitionNonWettingRelPermTableName="imbibitionGasRelativePermeabilityTable"      
      imbibitionWettingRelPermTableName="imbibitionWaterRelativePermeabilityTable"/>

    <TableRelativePermeabilityHysteresis
      name="relperm_right"
      phaseNames="{ water, gas }"
      drainageWettingNonWettingRelPermTableNames="{ drainageWaterRelativePermeabilityTable, drainageGasRelativePermeabilityTable }"
      imbibitionNonWettingRelPermTableName="imbibitionGasRelativePermeabilityTable"      
      imbibitionWettingRelPermTableName="imbibitionWaterRelativePermeabilityTable"/>

    <JFunctionCapillaryPressure
      name="capPressure_left"
      phaseNames="{ water, gas }" 
      wettingNonWettingJFunctionTableName="jFunctionTable"
      wettingNonWettingSurfaceTension="6.12e-3"
      permeabilityDirection="XY"/>

    <JFunctionCapillaryPressure
      name="capPressure_right"
      phaseNames="{ water, gas }" 
      wettingNonWettingJFunctionTableName="jFunctionTable"
      wettingNonWettingSurfaceTension="6.12e-3"
      permeabilityDirection="XY"/>  

<BrooksCoreyCapillaryPressure
      name="capPressure_left"
      phaseNames="{ water, gas }"
      phaseMinVolumeFraction="{ 0.22, 0.3 }"
      phaseCapPressureExponentInv="{ 4 , 1 }"
      phaseEntryPressure="{ 4e3, 0 }"
      capPressureEpsilon="1e-8" />

<BrooksCoreyCapillaryPressure
      name="capPressure_right"
      phaseNames="{ water, gas }"
      phaseMinVolumeFraction="{ 0.22, 0.3 }"
      phaseCapPressureExponentInv="{ 4 , 1 }"
      phaseEntryPressure="{ 2e3, 0 }"
      capPressureEpsilon="1e-8" /> 

 <TableCapillaryPressureHysteresis
    name="capPressure_left"
    phaseNames="{ water, gas }"
    drainageWettingNonWettingCapPressureTableName="drainageWaterGasCapPresTable_left"
    imbibitionWettingNonWettingCapPressureTableName="imbibitionWaterGasCapPresTable_left"
    jerauldParameterA="1.0"
    jerauldParameterB="1.0"
    killoughCurvatureParameterPc="0.1"/>

 <TableCapillaryPressureHysteresis
    name="capPressure_right"
    phaseNames="{ water, gas }"
    drainageWettingNonWettingCapPressureTableName="drainageWaterGasCapPresTable_right"
    imbibitionWettingNonWettingCapPressureTableName="imbibitionWaterGasCapPresTable_right"
    jerauldParameterA="1.0"
    jerauldParameterB="1.0"
    killoughCurvatureParameterPc="0.1"/>
-->

    <TableCapillaryPressure
      name="capPressure_left"
      phaseNames="{ water, gas }"
      wettingNonWettingCapPressureTableName="drainageWaterGasCapPresTable_left" />
    <TableCapillaryPressure
      name="capPressure_right"
      phaseNames="{ water, gas }"
      wettingNonWettingCapPressureTableName="drainageWaterGasCapPresTable_right" />

    <TwoPhaseImmiscibleFluid
      name="fluid_left"
      phaseNames="{ water, gas }"
      densityTableNames="{densityTablePhase1, densityTablePhase2}"    
      viscosityTableNames="{viscosityTablePhase1, viscosityTablePhase2}" />

    <TwoPhaseImmiscibleFluid
      name="fluid_right"
      phaseNames="{ water, gas }"
      densityTableNames="{densityTablePhase1, densityTablePhase2}"    
      viscosityTableNames="{viscosityTablePhase1, viscosityTablePhase2}" />

  </Constitutive>
  <!-- SPHINX_MATERIAL_END -->

  <!-- SPHINX_BC --> 
  <FieldSpecifications>
    <FieldSpecification
      name="Porosity"
      initialCondition="1"
      setNames="{ all }"
      objectPath="ElementRegions/region_*"
      fieldName="rockPorosity_referencePorosity"
      scale="0.25" />

    <FieldSpecification
      name="initialPressure"
      initialCondition="1"
      setNames="{ all }"
      objectPath="ElementRegions/region_*"
      fieldName="pressure"
      scale="1.0"
      functionName="pressureTable" />

    <FieldSpecification
      name="initialSaturation1"
      initialCondition="1"
      setNames="{ all }"
      objectPath="ElementRegions/region_*"
      fieldName="phaseVolumeFraction"
      component="0"
      scale="1.0"
      functionName="saturationTable1" />

    <FieldSpecification
      name="initialSaturation2"
      initialCondition="1"
      setNames="{ all }"
      objectPath="ElementRegions/region_*"
      fieldName="phaseVolumeFraction"
      component="1"
      scale="1.0"
      functionName="saturationTable2" />

   <FieldSpecification
      name="permx"
      component="0"
      initialCondition="1"
      setNames="{ all }"
      objectPath="ElementRegions/region_*"
      fieldName="rockPerm_permeability"
      functionName="permxFunc"
      scale="1.0e-14"/>

    <FieldSpecification
      name="permy"
      component="1"
      initialCondition="1"
      setNames="{ all }"
      objectPath="ElementRegions/region_*"
      fieldName="rockPerm_permeability"
      functionName="permyFunc"
      scale="1.0e-14"/>

    <FieldSpecification
      name="permz"
      component="2"
      initialCondition="1"
      setNames="{ all }"
      objectPath="ElementRegions/region_*"
      fieldName="rockPerm_permeability"
      functionName="permzFunc"
      scale="1.0e-14"/>

  </FieldSpecifications>
  <!-- SPHINX_BC_END -->

  <!-- SPHINX_OUTPUT -->  
<!--<Outputs>
  <VTK
    name="vtkOutput"
    childDirectory="vtk"
    fieldNames="{
      phaseVolFraction,
      capPressure_left_phaseCapPressure,
      relperm_left_phaseRelPerm
    }" />-->

<Outputs>
  <VTK
    name="vtkOutput"
    childDirectory="vtk"
    fieldNames="{
      phaseVolFraction,
      capPressure_right_phaseCapPressure,
      capPressure_right_mode,
      relperm_right_phaseRelPerm,
      capPressure_left_phaseCapPressure,
      capPressure_left_mode,
      relperm_left_phaseRelPerm
    }" />

    <Restart
      name="restartOutput"/>
</Outputs>


