<?xml version="1.0" ?>

<Problem>

  <Solvers
    gravityVector="{ 0.0, 0.0, -9.81 }">
    <ImmiscibleMultiphaseFlow
      name="FlowSolver"
      logLevel="1"
      discretization="TPFA"
      targetRegions="{ reservoir }"      
      temperature="300"
      initialDt="8.64e7"
      scalingType="Global"
      scalingFactorType="TrustRegion"
      allowOutOfBoundPressure="1"
      allowLocalPresChopping="0"
      allowOutOfBoundSaturation="1"
      allowLocalSatChopping="0"      
      trustRegionMaxIter="5"
      trustRegionMinPotentialDiff="1.0"
      trustRegionKinkFactorDelta="1.05"
      trustRegionMinDerivative="1e-5"
      trustRegionRelResidualThreshold="0.000000"
      trustRegionAbsResidualThreshold="1e-2"
      trustRegionMinKinkFactor="0.1"
      trustRegionMinInfFactor="0.1"
      minScalingFactor="0.05"> <!-- trustRegionMinNewtonIter="4" -->

      <NonlinearSolverParameters
        newtonTol="1.0e-3"
        newtonMaxIter="300"
        maxTimeStepCuts="1"
        lineSearchAction="None"
        lineSearchMaxCuts="2"/>
      <LinearSolverParameters
        solverType="direct"
        directParallel="0"/>
    </ImmiscibleMultiphaseFlow>
  </Solvers>
  <!-- initialDt="0.001" -->
  <!-- newtonTol="1.0e-6" -->
  <!-- newtonMaxIter="40" -->
  <!-- maxTimeStepCuts="10" -->  

  <Mesh>
    <InternalMesh
      name="mesh"
      elementTypes="{ C3D8 }"
      xCoords="{ 0, 182.88 }"
      yCoords="{ 0, 3.048 }"
      zCoords="{ 0, 182.88 }"
      nx="{ 60 }"
      ny="{ 1 }"
      nz="{ 60 }"
      cellBlockNames="{ block }"/>
  </Mesh>

  <Geometry>
    <Box
      name="source"
      xMin="{ 149.00, -0.01, 27.00 }"
      xMax="{ 153.00,  3.05, 31.00 }"/>
    <Box
      name="sink"
      xMin="{ 27.00, -0.01, 149.00 }"
      xMax="{ 31.00,  3.05, 153.00 }"/>  
  </Geometry>

  <Events
    maxTime="8.64e7">

   <PeriodicEvent
      name="outputs"
      timeFrequency="9e8"
      targetExactTimestep="1"
      target="/Outputs/vtkOutput_direct"/>
      <!-- timeFrequency="2e6" -->
    
    <PeriodicEvent
      name="solverApplications"
      forceDt="8.64e7"  
      target="/Solvers/FlowSolver"/>
  </Events>
  <!-- maxEventDt="2e6" -->
  <!-- forceDt="1.728e5" -->

  <NumericalMethods>
    <FiniteVolume>
      <TwoPointFluxApproximation
        name="TPFA"/>
    </FiniteVolume>
  </NumericalMethods>

  <ElementRegions>
    <CellElementRegion
      name="reservoir"
      cellBlocks="{ * }"
      materialList="{ fluid, rock, relperm }"/>
  </ElementRegions>

  <Constitutive>
    <TwoPhaseImmiscibleFluid
      name="fluid"
      phaseNames="{ oil, water }"
      densityTableNames="{densityTableOil, densityTableWater}"    
      viscosityTableNames="{viscosityTableOil, viscosityTableWater}" />

    <CompressibleSolidConstantPermeability
      name="rock"
      solidModelName="nullSolid"
      porosityModelName="rockPorosity"
      permeabilityModelName="rockPerm"/>

    <NullModel
      name="nullSolid"/>

    <PressurePorosity
      name="rockPorosity"
      defaultReferencePorosity="0.25"
      referencePressure="2.896e7"
      compressibility="1.45e-8"/>

    <BrooksCoreyRelativePermeability
      name="relperm"
      phaseNames="{ oil, water }"
      phaseMinVolumeFraction="{ 0.0, 0.0 }"
      phaseRelPermExponent="{ 2.0, 2.0 }"
      phaseRelPermMaxValue="{ 1.0, 1.0 }"/>

    <ConstantPermeability
      name="rockPerm"
      permeabilityComponents="{ 1.0e-14, 1.0e-14, 1.0e-14 }"/>
  </Constitutive>

  <FieldSpecifications>
    <FieldSpecification
      name="permx"
      component="0"
      initialCondition="1"
      setNames="{ all }"
      objectPath="ElementRegions/reservoir/block"
      fieldName="rockPerm_permeability"
      functionName="permxFunc"
      scale="9.869233e-16"/>
    <FieldSpecification
      name="permy"
      component="1"
      initialCondition="1"
      setNames="{ all }"
      objectPath="ElementRegions/reservoir/block"
      fieldName="rockPerm_permeability"
      functionName="permyFunc"
      scale="9.869233e-16"/>
    <FieldSpecification
      name="permz"
      component="2"
      initialCondition="1"
      setNames="{ all }"
      objectPath="ElementRegions/reservoir/block"
      fieldName="rockPerm_permeability"
      functionName="permzFunc"
      scale="9.869233e-16"/>

    <FieldSpecification
      name="referencePorosity"
      initialCondition="1"
      setNames="{ all }"
      objectPath="ElementRegions/reservoir/block"
      fieldName="rockPorosity_referencePorosity"
      functionName="poroFunc"
      scale="1.0"/>

    <FieldSpecification
      name="initialPressure"
      initialCondition="1"
      setNames="{ all }"
      objectPath="ElementRegions/reservoir/block"
      fieldName="pressure"
      scale="2.896e+7"/>

    <FieldSpecification
      name="initialSaturation_oil"
      initialCondition="1"
      setNames="{ all }"
      objectPath="ElementRegions/reservoir/block"
      fieldName="phaseVolumeFraction"
      component="0"
      scale="0.9999"/>

    <FieldSpecification
      name="initialSaturation_water"
      initialCondition="1"
      setNames="{ all }"
      objectPath="ElementRegions/reservoir/block"
      fieldName="phaseVolumeFraction"
      component="1"
      scale="0.0001"/>
    
    <SourceFlux
      name="sourceTerm"
      objectPath="ElementRegions/reservoir/block"
      scale="-0.1148"
      component="1"
      setNames="{ source }"/>      

    <FieldSpecification
      name="sinkPressure"
      setNames="{ sink }"         
      objectPath="ElementRegions/reservoir/block"
      fieldName="pressure"
      scale="2.758e+7"/>
   <FieldSpecification
      name="sinkOil"
      setNames="{ sink }"
      objectPath="ElementRegions/reservoir/block"
      fieldName="phaseVolumeFraction"
      component="0"
      scale="0.9999"/>
    <FieldSpecification
      name="sinkWater"
      setNames="{ sink }"
      objectPath="ElementRegions/reservoir/block"
      fieldName="phaseVolumeFraction"
      component="1"
      scale="0.0001"/>
  </FieldSpecifications>
 
  <Functions>
    <TableFunction 
      name="permxFunc"
      inputVarNames="{elementCenter}"
      coordinateFiles="{xlin.geos,ylin.geos,zlin.geos}"
      voxelFile="permx.geos"
      interpolation="linear" />
    <TableFunction 
      name="permyFunc"
      inputVarNames="{elementCenter}"
      coordinateFiles="{xlin.geos,ylin.geos,zlin.geos}"
      voxelFile="permy.geos"
      interpolation="linear" />
    <TableFunction 
      name="permzFunc"
      inputVarNames="{elementCenter}"
      coordinateFiles="{xlin.geos,ylin.geos,zlin.geos}"
      voxelFile="permz.geos"
      interpolation="linear" />

    <TableFunction 
      name="poroFunc"
      inputVarNames="{elementCenter}"
      coordinateFiles="{xlin.geos,ylin.geos,zlin.geos}"
      voxelFile="poro.geos"
      interpolation="linear" />

    <TableFunction
      name="densityTableOil"
      coordinateFiles="{ fluidSI/pres.txt }"
      voxelFile="fluidSI/denso.txt"
      interpolation="linear"/>
    <TableFunction
      name="viscosityTableOil"
      coordinateFiles="{ fluidSI/pres.txt }"
      voxelFile="fluidSI/visco.txt"
      interpolation="linear"/>
    <TableFunction
      name="densityTableWater"
      coordinateFiles="{ fluidSI/pres.txt }"
      voxelFile="fluidSI/densw.txt"
      interpolation="linear"/>
    <TableFunction
      name="viscosityTableWater"
      coordinateFiles="{ fluidSI/pres.txt }"
      voxelFile="fluidSI/viscw.txt"
      interpolation="linear"/>
    <!-- <TableFunction
      name="densityTableOil"
      coordinates="{ 0.0 }"
      values="{ 280 }" />
    <TableFunction
      name="densityTableWater"
      coordinates="{ 0.0 }"
      values="{ 992 }" />
    <TableFunction
      name="viscosityTableOil"
      coordinates="{ 0.0 }"
      values="{ 0.000023 }" />                  
    <TableFunction
      name="viscosityTableWater"
      coordinates="{ 0.0 }"
      values="{ 0.00055 }" /> -->
  </Functions>
  
  <Outputs>
    <VTK
      name="vtkOutput_direct"/>
  </Outputs>
  
</Problem>
