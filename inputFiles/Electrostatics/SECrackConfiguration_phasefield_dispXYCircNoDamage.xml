  <Functions>
    <!-- These are example mathpresso functions.  In order to use them, you need to specify the order that the
    symbolic math function should expect the variables to be given, and an expression that it will compile.
    A list of available functions is given here: https://github.com/kobalicek/mathpresso -->
    <TableFunction
      name="f_b"
      inputVarNames="{ time }"
      coordinates="{ 0, 4 }"
      values="{ 0, 129.5 }"/>

    <TableFunction
      name="disp"
      inputVarNames="{ time }"
      coordinates="{ 0, 8 }"
      values="{ 0, 0.1 }"/>

    <TableFunction
      name="dispCircX"
      inputVarNames="{ ReferencePosition, time }"
      coordinateFiles="{ tables/tablef2/xd.geos, tables/tablef2/yd.geos, tables/tablef2/zd.geos, tables/tablef2/td.geos}"
      voxelFile="tables/tablef2/displacement_x.geos"/>

    <TableFunction
      name="dispCircY"
      inputVarNames="{ ReferencePosition, time }"
      coordinateFiles="{ tables/tablef2/xd.geos, tables/tablef2/yd.geos, tables/tablef2/zd.geos, tables/tablef2/td.geos}"
      voxelFile="tables/tablef2/displacement_y.geos"/>

      
  </Functions>




  <Outputs>
    <VTK
      name="vtkOutput"
      plotFileRoot="LiSEdefect_interface_LiGrowthPFLdxyCirTestNDFullBottomNoUp"/>
  </Outputs>
</Problem>
