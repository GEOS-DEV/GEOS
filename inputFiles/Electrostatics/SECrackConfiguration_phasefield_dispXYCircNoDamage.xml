      fieldName="totalDisplacement"
      component="0"
      objectPath="nodeManager"
      scale="0.4"
      functionName="dispCircX"
      setNames="{ topCircleSurface }"/>

    <FieldSpecification
      name="yCircDisp"
      fieldName="totalDisplacement"
