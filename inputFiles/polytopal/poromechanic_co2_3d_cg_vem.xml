<?xml version="1.0" ?>

<Problem>

  <Included>
    <File name="./poromechanic_co2_3d_base.xml"/>
  </Included>  

  <NumericalMethods>
    <FiniteElements>
      <FiniteElementSpace
        name="FE1"
        order="1"
        useVirtualElements="1"/>
    </FiniteElements>
  <FiniteVolume>
      <!--  
      <TwoPointFluxApproximation
        name="fluidTPFA"/>
-->
      <HybridMimeticDiscretization
        name="fluidHybridMimetic"
        innerProductType="TPFA"/>
    </FiniteVolume>
  </NumericalMethods>

  <Solvers>
    
    <MultiphasePoromechanics
      name="multiphasePoroelasticity"
      solidSolverName="linearElasticity"
      flowSolverName="twoPhaseFlow"
      stabilizationType="None"
      stabilizationRegionNames="{ channel, barrier }"
      logLevel="1"
      targetRegions="{ channel, barrier }">
    <NonlinearSolverParameters
        newtonTol="1.0e-4"
        lineSearchAction="Attempt"
        newtonMaxIter="40"/>
      <LinearSolverParameters
        directParallel="0"/>
    </MultiphasePoromechanics>

    <SolidMechanicsLagrangianFEM
      name="linearElasticity"
      timeIntegrationOption="QuasiStatic"
      logLevel="1"
      discretization="FE1"
      targetRegions="{ channel, barrier  }"/>

    <CompositionalMultiphaseHybridFVM
      name="twoPhaseFlow"
      logLevel="1"
      discretization="fluidHybridMimetic"
      targetRelativePressureChangeInTimeStep="1"
      targetPhaseVolFractionChangeInTimeStep="1"
      targetRegions="{ channel, barrier  }"
      temperature="300"
      useMass="1"/>
  </Solvers>

  <Events
    minTime="-1e11"  
    maxTime="17280000">
    
    <PeriodicEvent
      name="outputs"
      timeFrequency="1728000"
      target="/Outputs/vtkOutputVEM"/>
<!-- 
    <SoloEvent
      name="multiphasePoroelasticityEquilibrationStep"
      targetTime="-1e11"
      beginTime="-1e11"
      target="/Tasks/multiphasePoroelasticityEquilibrationStep"/> -->
    
    <PeriodicEvent
      name="linearElasticityStatistics"
      timeFrequency="1728000"
      target="/Tasks/linearElasticityStatistics"/>
    <PeriodicEvent
      name="twoPhaseFlowStatistics"
      timeFrequency="1728000"
      target="/Tasks/twoPhaseFlowStatistics"/>
    
    <PeriodicEvent
      name="solverApplications1"
      endTime="17280000"
      forceDt="864000"
      target="/Solvers/multiphasePoroelasticity"/>

    <PeriodicEvent
      name="restarts"
      timeFrequency="1728000"
      target="/Outputs/restartOutputVEM"/>  
  </Events>

  <Outputs>
    <VTK
      name="vtkOutputVEM"
      fieldNames="{ initialPressure, skeletonChannel_density }"/>
    <Restart
      name="restartOutputVEM"/>      
  </Outputs>

  <Tasks>
  
    <SolidMechanicsStatistics
      name="linearElasticityStatistics"
      solidSolverName="linearElasticity"
      logLevel="1"/>
    <CompositionalMultiphaseStatistics
      name="twoPhaseFlowStatistics"
      flowSolverName="twoPhaseFlow"
      logLevel="1"
      computeRegionStatistics="1"/>

<!--     <MultiphasePoromechanicsInitialization 
      logLevel="1"      
      name="multiphasePoroelasticityEquilibrationStep"
      poromechanicsSolverName="multiphasePoroelasticity"/> -->
    
  </Tasks>
  
</Problem>
