  <Functions>
    <TableFunction
      name="producerPhaseRateTable"
      inputVarNames="{ time }"
      coordinates="{ -1e9, 0, 1e9 }"
      values="{ 0, 100, 100 }" 
      interpolation="lower"/>
    <TableFunction
      name="injectorTotalRateTable"
      inputVarNames="{ time }"
      coordinates="{ -1e9, 0, 1e9 }"
      values="{ 0, 7, 7 }" 
      interpolation="lower"/>
  </Functions>
  
</Problem>
