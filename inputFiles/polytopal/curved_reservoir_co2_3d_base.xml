      values="{ 10.5300, 2.0300, 0.9800, 0.4600, 0.1764, 0.0671, 0.0597, 0.0525, 0.0461, 0.0411, 0.0386, 0.0363, 0.0340, 0.0313, 0.0203, 0.0110, 0.0097, 0.0091, 0.0039, 0.0011, 0.0001 }"/>
