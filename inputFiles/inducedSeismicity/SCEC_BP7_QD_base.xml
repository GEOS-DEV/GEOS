<?xml version="1.0" ?>
<Problem>

  <NumericalMethods>
    <FiniteElements>
      <FiniteElementSpace
        name="FE1"
        order="1"/>
    </FiniteElements>
  </NumericalMethods>

  <Mesh>
    <InternalMesh
      name="mesh1"
      elementTypes="{ C3D8 }"
      xCoords="{ -500, 500 }"
      yCoords="{ -500, 500 }"
      zCoords="{ -500, 500 }"
      nx="{ 5 }"
      ny="{ 5 }"
      nz="{ 2 }"
      cellBlockNames="{ cb1 }"/>
  </Mesh>

   <ElementRegions>
    <CellElementRegion
      name="Domain"
      cellBlocks="{ cb1 }"
      materialList="{ rock }"/>

    <SurfaceElementRegion
      name="Fault"
      materialList="{frictionLaw}"
      defaultAperture="1e-3"/>  
    </ElementRegions>
  
  <Constitutive>

    <ElasticIsotropic
     name="rock"
     defaultDensity="2670"
     defaultBulkModulus="50.0e9"
     defaultShearModulus="32.04e9"/>

    <RateAndStateFrictionSlipLaw
      name="frictionLaw"
      defaultA="0.007"
      defaultB="0.005"
      defaultDc="4.0e-3"  
      defaultReferenceVelocity="1.0e-6"
      defaultReferenceFrictionCoefficient="0.6"/>  
  </Constitutive>

  <Geometry>    
    <Box
      name="faultPlane"
      xMin="{ -400.01, -400.01, -0.01 }"
      xMax="{  400.01,  400.01, 0.01 }"/>

    <Cylinder
      name="slipWeakeningRegion"
      firstFaceCenter="{  0.0, 0.0, -500.01 }"
      secondFaceCenter="{ 0.0, 0.0,  500.01 }"
      outerRadius="200"/>

    <Cylinder
      name="nucleationRegion"
      firstFaceCenter="{ 0.0, 0.0, -500.01 }"
      secondFaceCenter="{ 0.0, 0.0, 500.01 }"
      outerRadius="150"/>
    

  <!-- Stations -->
    <Cylinder
      name="receiver_1"
      firstFaceCenter="{ 0.0, 0.0, -500.01 }"
      secondFaceCenter="{ 0.0, 0.0, 500.01 }"
      outerRadius="1"/> 
    <Cylinder
      name="receiver_2"
      firstFaceCenter="{ -100.0, 0.0, -500.01 }"
      secondFaceCenter="{ -100.0, 0.0, 500.01 }"
      outerRadius="1"/>
    <Cylinder
      name="receiver_3"
      firstFaceCenter="{ 0.0, 100.0, -500.01 }"
      secondFaceCenter="{ 0.0, 100.0, 500.01 }"
      outerRadius="1"/> 
    <Cylinder
      name="receiver_4"
     firstFaceCenter="{ 100.0, 0.0, -500.01 }"
      secondFaceCenter="{ 100.0, 0.0, 500.01 }"
      outerRadius="1"/>
    <Cylinder
      name="receiver_5"
      firstFaceCenter="{ 0.0, -100.0, -500.01 }"
      secondFaceCenter="{ 0.0, -100.0, 500.01 }"
      outerRadius="1"/> 
    <Cylinder
      name="receiver_6"
      firstFaceCenter="{ -100.0, -100.0, -500.01 }"
      secondFaceCenter="{ -100.0, -100.0, 500.01 }"
      outerRadius="1"/>
    <Cylinder
      name="receiver_7"
      firstFaceCenter="{ -100.0, 100.0, -500.01 }"
      secondFaceCenter="{ -100.0, 100.0, 500.01 }"
      outerRadius="1"/>
    <Cylinder
      name="receiver_8"
      firstFaceCenter="{ 100.0, -100.0, -500.01 }"
      secondFaceCenter="{ 100.0, -100.0, 500.01 }"
      outerRadius="1"/> 
    <Cylinder
      name="receiver_9"
      firstFaceCenter="{ 100.0, 100.0, -500.01 }"
      secondFaceCenter="{ 100.0, 100.0, 500.01 }"
      outerRadius="1"/>
    <Cylinder
      name="receiver_10"
      firstFaceCenter="{ -300.0, 0.0, -500.01 }"
      secondFaceCenter="{ -300.0, 0.0, 500.01 }"
      outerRadius="1"/>
    <Cylinder
      name="receiver_11"
      firstFaceCenter="{ 0.0, 300.0, -500.01 }"
      secondFaceCenter="{ 0.0, 300.0, 500.01 }"
      outerRadius="1"/>
    <Cylinder
      name="receiver_12"
      firstFaceCenter="{ 300.0, 0.0, -500.01 }"
      secondFaceCenter="{ 300.0, 0.0, 500.01 }"
      outerRadius="1"/>
    <Cylinder
      name="receiver_13"
      firstFaceCenter="{ 0.0, -300.0, -500.01 }"
      secondFaceCenter="{ 0.0, -300.0, 500.01 }"
      outerRadius="1"/>      

  </Geometry>

  <ElementRegions>
    <CellElementRegion
      name="Domain"
      cellBlocks="{ cb1 }"
      materialList="{rock}"/>

    <SurfaceElementRegion
      name="Fault"
      materialList="{frictionLaw}"
      defaultAperture="1e-3"/>  
    </ElementRegions>

  <FieldSpecifications>
    <FieldSpecification
      name="fault"
      fieldName="ruptureState"
      initialCondition="1"
      objectPath="faceManager"
      scale="1"
      setNames="{ faultPlane }"/>

    <FieldSpecification
      name="xconstraint"
      objectPath="nodeManager"
      fieldName="totalDisplacement"
      component="0"
      scale="0.0"
      setNames="{ xneg, xpos }"/>

    <FieldSpecification
      name="yconstraint"
      objectPath="nodeManager"
      fieldName="totalDisplacement"
      component="1"
      scale="0.0"
      setNames="{ ypos, yneg }"/>

    <FieldSpecification
      name="zconstraint"
      objectPath="nodeManager"
      fieldName="totalDisplacement"
      component="2"
      scale="0.0"
      setNames="{ zpos, zneg }"/>

    <FieldSpecification
      name="slipWeakeningRSA"
      objectPath="ElementRegions/Fault"
      fieldName="frictionLaw_a"
      scale="0.004"
      setNames="{ slipWeakeningRegion }"
      initialCondition="1"/>

  <!-- Shear stress -->
    <FieldSpecification
      name="initial_backgroundShearStress_t1"
      fieldName="backgroundShearStress"
      objectPath="ElementRegions/Fault/FractureSubRegion"
      component="0"
      scale="1.0"
      setNames="{all}"
      functionName="initial_background_shearStress_t1"
      initialCondition="1"/>

    <FieldSpecification
      name="initial_backgroundShearStress_t2"
      fieldName="backgroundShearStress"
      objectPath="ElementRegions/Fault/FractureSubRegion"
      component="1"
      scale="1.0"
      setNames="{all}"
      functionName="background_shearStress_t2"
      initialCondition="1"/>        
    
    <FieldSpecification
      name="backgroundShearStress_t1"
      fieldName="backgroundShearStress"
      objectPath="ElementRegions/Fault/FractureSubRegion"
      component="0"
      scale="1.0"
      setNames="{all}"
      functionName="background_shearStress_t1"/>

    <FieldSpecification
      name="backGroundNormalStress"
      fieldName="backgroundNormalStress"
      objectPath="ElementRegions/Fault/FractureSubRegion"
      scale="25.0e6"
      setNames="{all}"/>  

<!-- Initial conditions -->
    <FieldSpecification
      name="initialStateVariable"
      objectPath="ElementRegions/Fault"
      fieldName="stateVariable"
      scale="0.041446531673892825"
      setNames="{ all }"
      initialCondition="1"/>  
      
    <FieldSpecification
      name="slipVelocity1"
      fieldName="slipVelocity"
      initialCondition="1"
      objectPath="ElementRegions/Fault/FractureSubRegion"
      component="0"
      scale="1.0e-9"
      setNames="{all}"/>

    <FieldSpecification
      name="slipVelocity2"
      fieldName="slipVelocity"
      initialCondition="1"
      objectPath="ElementRegions/Fault/FractureSubRegion"
      component="1"
      scale="1.0e-20"
      setNames="{all}"/>                 
  </FieldSpecifications>

  <Functions>
   <TableFunction
      name="initial_background_shearStress_t1"
      inputVarNames="{ elementCenter }"
      coordinateFiles="{ tables/x.geos, tables/y.geos, tables/z.geos }"
      voxelFile="./tables/backgroungShearTraction_x.geos"
      interpolation="linear"/>

   <TableFunction
      name="background_shearStress_t1"
      inputVarNames="{ elementCenter  }"
      coordinateFiles="{ tables/x.geos, tables/y.geos, tables/z.geos, tables/t.geos }"
      voxelFile="./tables/backgroungShearTractionWithForcing_x.geos"
      interpolation="linear"/>

    <TableFunction
      name="background_shearStress_t2"
      inputVarNames="{ elementCenter }"
      coordinateFiles="{ tables/x.geos, tables/y.geos, tables/z.geos }"
      voxelFile="./tables/backgroungShearTraction_y.geos"
      interpolation="linear"/>  
  </Functions>
  
  <Outputs>
    <VTK
      name="vtkOutput"
      plotFileRoot="BP7_QD_S"/>
  </Outputs>
</Problem>
