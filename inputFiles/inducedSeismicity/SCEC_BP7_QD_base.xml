<?xml version="1.0" ?>
<Problem>

  <NumericalMethods>
    <FiniteElements>
      <FiniteElementSpace
        name="FE1"
        order="1"/>
    </FiniteElements>
  </NumericalMethods>

  <Mesh>
    <InternalMesh
      name="mesh1"
      elementTypes="{ C3D8 }"
      xCoords="{ -505, 505 }"
      yCoords="{ -505, 505 }"
      zCoords="{ -500, -300, -50, 50, 300, 500 }"
      nx="{ 101 }"
      ny="{ 101 }"
      nz="{ 2, 10, 10, 10, 2 }"
      cellBlockNames="{ cb1 }"/>
  </Mesh>

   <ElementRegions>
    <CellElementRegion
      name="Domain"
      cellBlocks="{ cb1 }"
      materialList="{ rock }"/>

    <SurfaceElementRegion
      name="Fault"
      materialList="{frictionLaw}"
      defaultAperture="1e-3"/>  
    </ElementRegions>
  
  <Constitutive>

    <ElasticIsotropic
     name="rock"
     defaultDensity="2670"
     defaultBulkModulus="50.0e9"
     defaultShearModulus="32.04e9"/>

    <RateAndStateFrictionSlipLaw
      name="frictionLaw"
      defaultA="0.007"
      defaultB="0.005"
      defaultDc="4.0e-3"  
      defaultReferenceVelocity="1.0e-6"
      defaultReferenceFrictionCoefficient="0.6"/>  
  </Constitutive>

  <Geometry>    
    <Box
      name="faultPlane"
      xMin="{ -400.01, -400.01, -0.01 }"
      xMax="{  400.01,  400.01, 0.01 }"/>

    <Cylinder
      name="slipWeakeningRegion"
      firstFaceCenter="{  0.0, 0.0, -505.01 }"
      secondFaceCenter="{ 0.0, 0.0,  505.01 }"
      outerRadius="200"/>

    <Cylinder
      name="nucleationRegion"
      firstFaceCenter="{ 0.0, 0.0, -505.01 }"
      secondFaceCenter="{ 0.0, 0.0, 505.01 }"
      outerRadius="150"/>
      
  <!-- Stations -->
    <Cylinder
      name="01_faultStation"
      firstFaceCenter="{ 0.0, 0.0, -505.01 }"
      secondFaceCenter="{ 0.0, 0.0, 505.01 }"
      outerRadius="8"/> 
    <Cylinder
      name="02_faultStation"
      firstFaceCenter="{ -100.0, 0.0, -505.01 }"
      secondFaceCenter="{ -100.0, 0.0, 505.01 }"
      outerRadius="8.0"/>
    <Cylinder
      name="03_faultStation"
      firstFaceCenter="{ 0.0, 100.0, -505.01 }"
      secondFaceCenter="{ 0.0, 100.0, 505.01 }"
      outerRadius="8.0"/> 
    <Cylinder
      name="04_faultStation"
      firstFaceCenter="{ 100.0, 0.0, -505.01 }"
      secondFaceCenter="{ 100.0, 0.0, 505.01 }"
      outerRadius="8.0"/>
    <Cylinder
      name="05_faultStation"
      firstFaceCenter="{ 0.0, -100.0, -505.01 }"
      secondFaceCenter="{ 0.0, -100.0, 505.01 }"
      outerRadius="8.0"/> 
    <Cylinder
      name="06_faultStation"
      firstFaceCenter="{ -100.0, -100.0, -505.01 }"
      secondFaceCenter="{ -100.0, -100.0, 505.01 }"
      outerRadius="8.0"/>
    <Cylinder
      name="07_faultStation"
      firstFaceCenter="{ -100.0, 100.0, -505.01 }"
      secondFaceCenter="{ -100.0, 100.0, 505.01 }"
      outerRadius="8.0"/>
    <Cylinder
      name="08_faultStation"
      firstFaceCenter="{ 100.0, -100.0, -505.01 }"
      secondFaceCenter="{ 100.0, -100.0, 505.01 }"
      outerRadius="8.0"/> 
    <Cylinder
      name="09_faultStation"
      firstFaceCenter="{ 100.0, 100.0, -505.01 }"
      secondFaceCenter="{ 100.0, 100.0, 505.01 }"
      outerRadius="8.0"/>
    <Cylinder
      name="10_faultStation"
      firstFaceCenter="{ -300.0, 0.0, -505.01 }"
      secondFaceCenter="{ -300.0, 0.0, 505.01 }"
      outerRadius="8.0"/>
    <Cylinder
      name="11_faultStation"
      firstFaceCenter="{ 0.0, 300.0, -505.01 }"
      secondFaceCenter="{ 0.0, 300.0, 505.01 }"
      outerRadius="8.0"/>
    <Cylinder
      name="12_faultStation"
      firstFaceCenter="{ 300.0, 0.0, -505.01 }"
      secondFaceCenter="{ 300.0, 0.0, 505.01 }"
      outerRadius="8.0"/>
    <Cylinder
      name="13_faultStation"
      firstFaceCenter="{ 0.0, -300.0, -505.01 }"
      secondFaceCenter="{ 0.0, -300.0, 505.01 }"
      outerRadius="8.0"/>      

  </Geometry>

  <ElementRegions>
    <CellElementRegion
      name="Domain"
      cellBlocks="{ cb1 }"
      materialList="{rock}"/>

    <SurfaceElementRegion
      name="Fault"
      materialList="{frictionLaw}"
      defaultAperture="1e-3"/>  
    </ElementRegions>

  <FieldSpecifications>
    <FieldSpecification
      name="fault"
      fieldName="ruptureState"
      initialCondition="1"
      objectPath="faceManager"
      scale="1"
      setNames="{ faultPlane }"/>

    <FieldSpecification
      name="xconstraint"
      objectPath="nodeManager"
      fieldName="totalDisplacement"
      component="0"
      scale="0.0"
      setNames="{ xneg, xpos }"/>

    <FieldSpecification
      name="yconstraint"
      objectPath="nodeManager"
      fieldName="totalDisplacement"
      component="1"
      scale="0.0"
      setNames="{ ypos, yneg }"/>

    <FieldSpecification
      name="zconstraint"
      objectPath="nodeManager"
      fieldName="totalDisplacement"
      component="2"
      scale="0.0"
      setNames="{ zpos, zneg }"/>

    <FieldSpecification
      name="a_param"
      objectPath="ElementRegions/Fault"
      fieldName="frictionLaw_a"
      scale="1"
      setNames="{ all }"
      functionName="a_param"
      initialCondition="1"/>

  <!-- Shear stress -->
    <FieldSpecification
      name="initial_backgroundShearStress_t1"
      fieldName="backgroundShearStress"
      objectPath="ElementRegions/Fault/FractureSubRegion"
      component="0"
      scale="1.0"
      setNames="{all}"
      functionName="background_shearStress_t1"
      initialCondition="1"/>

    <FieldSpecification
      name="initial_backgroundShearStress_t2"
      fieldName="backgroundShearStress"
      objectPath="ElementRegions/Fault/FractureSubRegion"
      component="1"
      scale="1.0"
      setNames="{all}"
      functionName="background_shearStress_t2"
      initialCondition="1"/>        
    
    <FieldSpecification
      name="shearStressPerturbation_t1"
      fieldName="shearStressPerturbation"
      objectPath="ElementRegions/Fault/FractureSubRegion"
      component="0"
      scale="1.0"
      setNames="{all}"
      functionName="shearStressPerturbation_t1"/>

    <FieldSpecification
      name="backGroundNormalStress"
      fieldName="backgroundNormalStress"
      objectPath="ElementRegions/Fault/FractureSubRegion"
      scale="25.0e6"
      setNames="{all}"/>

<!-- Initial conditions -->
    <FieldSpecification
      name="initialStateVariable"
      objectPath="ElementRegions/Fault"
      fieldName="stateVariable"
      scale="0.6690775527898214"
      setNames="{ all }"
      initialCondition="1"/>  
      
    <FieldSpecification
      name="slipVelocity1"
      fieldName="slipVelocity"
      initialCondition="1"
      objectPath="ElementRegions/Fault/FractureSubRegion"
      component="0"
      scale="1.0e-9"
      setNames="{all}"/>

    <FieldSpecification
      name="slipVelocity2"
      fieldName="slipVelocity"
      initialCondition="1"
      objectPath="ElementRegions/Fault/FractureSubRegion"
      component="1"
      scale="1.0e-20"
      setNames="{all}"/>

    <FieldSpecification
      name="backSlipRate1"
      fieldName="backSlipRate"
      initialCondition="1"
      objectPath="ElementRegions/Fault/FractureSubRegion"
      component="0"
      scale="1.0e-9"
      setNames="{all}"/>

    <FieldSpecification
      name="backSlipRate2"
      fieldName="backSlipRate"
      initialCondition="1"
      objectPath="ElementRegions/Fault/FractureSubRegion"
      component="1"
      scale="0.0"
      setNames="{all}"/>                          
  </FieldSpecifications>

  <Functions>
   <TableFunction
      name="background_shearStress_t1"
      inputVarNames="{ elementCenter }"
      coordinateFiles="{ tables/x.geos, tables/y.geos, tables/z.geos }"
      voxelFile="./tables/backgroungShearTraction_x.geos"
      interpolation="nearest"/>

   <TableFunction
      name="shearStressPerturbation_t1"
      inputVarNames="{ elementCenter, time  }"
      coordinateFiles="{ tables/x.geos, tables/y.geos, tables/z.geos, tables/t.geos }"
      voxelFile="./tables/stressPerturbation_x.geos"
      interpolation="nearest"/>

    <TableFunction
      name="background_shearStress_t2"
      inputVarNames="{ elementCenter }"
      coordinateFiles="{ tables/x.geos, tables/y.geos, tables/z.geos }"
      voxelFile="./tables/backgroungShearTraction_y.geos"
      interpolation="nearest"/>

     <TableFunction
      name="a_param"
      inputVarNames="{ elementCenter }"
      coordinateFiles="{ tables/x.geos, tables/y.geos, tables/z.geos }"
      voxelFile="./tables/a.geos"
      interpolation="nearest"/>      
  </Functions>

  <Tasks>
    <PackCollection
      name="slipVelocityCollection"
      objectPath="ElementRegions/Fault/FractureSubRegion"
      fieldName="slipVelocity"
      setNames="{01_faultStation, 02_faultStation, 03_faultStation, 04_faultStation, 05_faultStation, 06_faultStation, 07_faultStation, 08_faultStation, 09_faultStation, 10_faultStation, 11_faultStation, 12_faultStation, 13_faultStation}"/>

    <PackCollection
      name="slipCollection"
      objectPath="ElementRegions/Fault/FractureSubRegion"
      fieldName="totalSlip"
      setNames="{01_faultStation, 02_faultStation, 03_faultStation, 04_faultStation, 05_faultStation, 06_faultStation, 07_faultStation, 08_faultStation, 09_faultStation, 10_faultStation, 11_faultStation, 12_faultStation, 13_faultStation}"/>

    <PackCollection
      name="shearTractionCollection"
      objectPath="ElementRegions/Fault/FractureSubRegion"
      fieldName="shearTraction"
      setNames="{01_faultStation, 02_faultStation, 03_faultStation, 04_faultStation, 05_faultStation, 06_faultStation, 07_faultStation, 08_faultStation, 09_faultStation, 10_faultStation, 11_faultStation, 12_faultStation, 13_faultStation}"/>

    <PackCollection
      name="stateCollection"
      objectPath="ElementRegions/Fault/FractureSubRegion"
      fieldName="stateVariable"
      setNames="{01_faultStation, 02_faultStation, 03_faultStation, 04_faultStation, 05_faultStation, 06_faultStation, 07_faultStation, 08_faultStation, 09_faultStation, 10_faultStation, 11_faultStation, 12_faultStation, 13_faultStation}"/>
   </Tasks>
</Problem>
