from geos.ats.test_builder import TestDeck, RestartcheckParameters, generate_geos_tests

restartcheck_params = {'atol': 1e-07, 'rtol': 4e-06}

decks = [
    TestDeck(
        name="validation_case_smoke_fim.xml",
        description='Local yield acceleration test (fully implicit version)',
        partitions=((1, 1, 1), (2, 2, 1)),
        restart_step=0,
        check_step=1,
        restartcheck_params=RestartcheckParameters(**restartcheck_params)),
    TestDeck(
        name="validation_case_smoke_seq.xml",
        description='Local yield acceleration test (sequential version)',
        partitions=((1, 1, 1), (2, 2, 1)),
        restart_step=0,
        check_step=5,
        restartcheck_params=RestartcheckParameters(**restartcheck_params))
]

generate_geos_tests(decks)
