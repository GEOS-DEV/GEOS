<?xml version="1.0" ?>

<Problem>

  <Included>
    <File name="validation_case_solvers_fim.xml"/>
  
    <File name="validation_case_base.xml"/>
  </Included>

  <Mesh>
     <VTKMesh         
      name="mesh1"      
      file="mesh_faultModel.vtm"
      useGlobalIds="1"
      regionAttribute="CellEntityIds"
      faceBlocks="{ Fracture }"/>
  </Mesh>

  <Geometry>
    <Box
      name="source"
      xMin="{ 803, -2.6, -0.01 }"
      xMax="{ 906,  2.6,  2000.01 }"/>

    <Box
      name="xnegFace"
      xMin="{ -2000.01, -500.01,  -0.01 }"
      xMax="{ -1999.99,  500.01,   2000.01 }"/>

    <Box
      name="xposFace"
      xMin="{ 1999.99, -500.01,  -0.01 }"
      xMax="{ 2000.01,  500.01,   2000.01 }"/>


    <Box
      name="ynegFace"
      xMin="{ -2000.01, -500.01,  -0.01 }"
      xMax="{  2000.01, -499.01,   2000.01 }"/>

    <Box
      name="yposFace"
      xMin="{ -2000.01,  499.99,  -0.01 }"
      xMax="{  2000.01,  500.01,   2000.01 }"/>
    
    <Box
      name="znegFace"
      xMin="{ -2000.01, -500.01,  -0.01 }"
      xMax="{  2000.01,  500.01,   0.01 }"/>

    <Box
      name="zposFace"
      xMin="{ -2000.01, -500.01,  1999.99 }"
      xMax="{  2000.01,  500.01,  2000.01 }"/>

  </Geometry>

  <FieldSpecifications>
    <FieldSpecification 
      name="initialPressure"
      initialCondition="1"
      setNames="{all}"
      objectPath="ElementRegions"
      fieldName="pressure"
      scale="1.0e6"/>
    	     
    <FieldSpecification 
      name="stressXX"
      initialCondition="1"
      setNames="{all}"
      objectPath="ElementRegions/Domain"
      fieldName="rock_stress"
      component="0"
      scale="0"/>

    <FieldSpecification 
      name="stressYY"
      initialCondition="1"
      setNames="{all}"
      objectPath="ElementRegions/Domain"
      fieldName="rock_stress"
      component="1"
      scale="0"/>

    <FieldSpecification 
      name="stressZZ"
      initialCondition="1"
      setNames="{all}"
      objectPath="ElementRegions/Domain"
      fieldName="rock_stress"
      component="2"
      scale="0"/>

    <FieldSpecification
      name="xconstraint"
      objectPath="nodeManager"
      fieldName="totalDisplacement"
      component="0"
      scale="0.0"
      setNames="{ xnegFace, xposFace }"/>

    <FieldSpecification
      name="yconstraint"
      objectPath="nodeManager"
      fieldName="totalDisplacement"
      component="1"
      scale="0.0"
      setNames="{ ynegFace }"/>

    <FieldSpecification
      name="zconstraintFront"
      objectPath="nodeManager"
      fieldName="totalDisplacement"
      component="2"
      scale="0.0"
      setNames="{ znegFace, zposFace }"/>

    <Traction
      name="NormalTraction"
      objectPath="faceManager"
      tractionType="normal"
      scale="-2.0e6"      
      setNames="{ yposFace }"/>

    <SourceFlux
      name="sourceTerm"
      objectPath="ElementRegions/Domain"
      scale="-10000"
      component="1"
      setNames="{ source }"/>

  </FieldSpecifications>

  <Outputs>
    <VTK
      name="vtkOutput"
      plotFileRoot="results"/>

    <Restart
      name="restartOutput"/>      
    </Outputs>

</Problem>
