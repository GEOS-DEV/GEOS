<?xml version="1.0" ?>

<Problem>
  <Solvers
    gravityVector="{ 0.0, 0.0, 0}">
    <SinglePhasePoromechanicsConformingFractures
      name="poroSolver"
      targetRegions="{ Domain, Fracture }"
      initialDt="1e3"
      flowSolverName="flowSolver"
      solidSolverName="fractureMechSolver"
      logLevel="1">
      <NonlinearSolverParameters
        couplingType="Sequential"
        subcycling="1"
        newtonTol="1.0e-4"
        logLevel="2"
        maxTimeStepCuts="10"
        newtonMaxIter="20"
        lineSearchAction="None"
        maxAllowedResidualNorm="1.0e15"/>
      <LinearSolverParameters
        solverType="direct"
        directParallel="0"/>
    </SinglePhasePoromechanicsConformingFractures>

    <SolidMechanicsLagrangeContact
      name="fractureMechSolver"
      stabilizationName="singlePhaseTPFA_stab"
      logLevel="1"
      useLocalYieldAcceleration="1"
      targetRegions="{ Domain, Fracture }"
      discretization="FE1">
      <NonlinearSolverParameters
        newtonMaxIter="20"
        newtonTol="1.0e-4"
        maxNumConfigurationAttempts="100"
        lineSearchAction="None"
        maxTimeStepCuts="10"/>
      <LinearSolverParameters
        solverType="direct"
        directParallel="0"/>
    </SolidMechanicsLagrangeContact>

    <SinglePhaseFVM
      name="flowSolver"
      logLevel="1"
      discretization="singlePhaseTPFA"
      targetRegions="{ Domain, Fracture }">
      <NonlinearSolverParameters
        newtonTol="1.0e-4"
        lineSearchAction="None"
        newtonMaxIter="20"/>
      <LinearSolverParameters
        solverType="direct"
        directParallel="0"/>
    </SinglePhaseFVM>

  </Solvers>
</Problem>
