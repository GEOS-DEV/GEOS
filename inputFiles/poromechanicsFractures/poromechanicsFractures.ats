import os

from geos.ats import test_builder
from geos.ats.test_builder import TestDeck, RestartcheckParameters

TEST_TIMELIMITS = {
    "multiphasePoromechanics_FaultModel_smoke_01": "90m",
    "multiphasePoromechanics_FaultModel_well_fim_smoke_01": "90m",
}


def generate_geos_tests_with_timelimits(decks):
    original_geos = test_builder.geos

    def geos_with_timelimit(*args, **kwargs):
        deck = kwargs.get("deck")
        np = kwargs.get("np", 1)
        if deck is not None:
            testcase_name = "{}_{:02d}".format(os.path.splitext(deck)[0], np)
            if testcase_name in TEST_TIMELIMITS:
                kwargs.setdefault("timelimit", TEST_TIMELIMITS[testcase_name])
        return original_geos(*args, **kwargs)

    try:
        test_builder.geos = geos_with_timelimit
        test_builder.generate_geos_tests(decks)
    finally:
        test_builder.geos = original_geos

restartcheck_params = {'atol': 1e-07, 'rtol': 4e-06}

decks = [
    TestDeck(
        name="SlipPermeability_pEDFM_smoke",
        description='pEDFM slip dependent permeability case',
        partitions=((1, 1, 1), (2, 2, 1)),
        restart_step=0,
        check_step=1,
        restartcheck_params=RestartcheckParameters(**restartcheck_params)),
    TestDeck(
        name="WillisRichardsPermeability_efem-edfm_smoke",
        description='WillisRichards Permeability model with EDFM',
        partitions=((1, 1, 1), (2, 2, 1)),
        restart_step=0,
