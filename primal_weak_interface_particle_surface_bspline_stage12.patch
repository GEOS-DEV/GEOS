+// -------------------------------------------------------------------------------------------------
+// Serial CPU geometry support for the experimental primal weak-interface enrichment.  These
+// structures are intentionally local to this translation unit.  The persistent particle state
+// remains particleSurfacePosition/particleSurfaceNormal; the reconstructed polyline is rebuilt and
+// discarded every explicit step.
+// -------------------------------------------------------------------------------------------------
+struct PrimalWeakInterfaceMarker
+{
+  std::array< real64, 3 > point{};
+  std::array< real64, 3 > normal{};
+  real64 weight = 0.0;
+};
+
+struct PrimalWeakCrossingKey
+{
+  // Local node ids are sufficient for the current single-rank prototype.  An
+  // MPI implementation should key shared edges with global endpoint ids and
+  // finalize the canonical crossing on a deterministic edge owner.
+  int kind = 0; // 0: grid vertex, 1: grid edge.
+  localIndex node0 = -1;
+  localIndex node1 = -1;
+
+  bool operator<( PrimalWeakCrossingKey const & other ) const
+  {
+    return std::tie( kind, node0, node1 ) <
+           std::tie( other.kind, other.node0, other.node1 );
+  }
+
+  bool operator==( PrimalWeakCrossingKey const & other ) const
+  {
+    return kind == other.kind && node0 == other.node0 && node1 == other.node1;
+  }
+};
+
+PrimalWeakCrossingKey primalWeakVertexKey( localIndex const node )
+{
+  return PrimalWeakCrossingKey{ 0, node, -1 };
+}
+
+PrimalWeakCrossingKey primalWeakEdgeKey( localIndex node0,
+                                         localIndex node1 )
+{
+  if( node1 < node0 )
+  {
+    std::swap( node0, node1 );
+  }
+  return PrimalWeakCrossingKey{ 1, node0, node1 };
+}
+
+struct PrimalWeakCrossingAccumulator
+{
+  std::array< real64, 3 > weightedPoint{};
+  real64 weight = 0.0;
+  std::vector< std::array< real64, 3 > > proposals;
+};
+
+struct PrimalWeakCellProposal
+{
+  bool valid = false;
+  localIndex i = -1;
+  localIndex j = -1;
+  std::array< PrimalWeakCrossingKey, 2 > crossings{};
+  std::array< std::array< real64, 3 >, 2 > proposedPoints{};
+  std::array< real64, 3 > point{};
+  std::array< real64, 3 > normal{};
+  real64 fitResidual = 0.0;
+  real64 normalCoherence = 0.0;
+  real64 weight = 0.0;
+};
+
+struct PrimalWeakInterfaceSegment
+{
+  std::array< real64, 3 > endpoint0{};
+  std::array< real64, 3 > endpoint1{};
+  std::array< real64, 3 > normal{};
+  localIndex cellI = -1;
+  localIndex cellJ = -1;
+  real64 length = 0.0;
+  real64 fitResidual = 0.0;
+  real64 normalCoherence = 0.0;
+};
+
+real64 primalWeakClosestPointOnSegment2D( std::array< real64, 3 > const & point,
+                                          PrimalWeakInterfaceSegment const & segment,
+                                          std::array< real64, 3 > & closestPoint )
+{
+  real64 const dx = segment.endpoint1[0] - segment.endpoint0[0];
+  real64 const dy = segment.endpoint1[1] - segment.endpoint0[1];
+  real64 const lengthSquared = dx * dx + dy * dy;
+  real64 parameter = 0.0;
+  if( lengthSquared > std::numeric_limits< real64 >::min() )
+  {
+    parameter = ( ( point[0] - segment.endpoint0[0] ) * dx +
+                  ( point[1] - segment.endpoint0[1] ) * dy ) / lengthSquared;
+    parameter = LvArray::math::max( 0.0, LvArray::math::min( 1.0, parameter ) );
+  }
+
+  closestPoint[0] = segment.endpoint0[0] + parameter * dx;
+  closestPoint[1] = segment.endpoint0[1] + parameter * dy;
+  closestPoint[2] = point[2];
+
+  real64 const rx = point[0] - closestPoint[0];
+  real64 const ry = point[1] - closestPoint[1];
+  return rx * rx + ry * ry;
+}
+
+bool primalWeakSegmentIntersectsBox2D( PrimalWeakInterfaceSegment const & segment,
+                                        real64 const xmin,
+                                        real64 const xmax,
+                                        real64 const ymin,
+                                        real64 const ymax )
+{
+  real64 const dx = segment.endpoint1[0] - segment.endpoint0[0];
+  real64 const dy = segment.endpoint1[1] - segment.endpoint0[1];
+  real64 t0 = 0.0;
+  real64 t1 = 1.0;
+
+  auto clip = [&]( real64 const p, real64 const q )
+  {
+    if( LvArray::math::abs( p ) <= std::numeric_limits< real64 >::epsilon() )
+    {
+      return q >= 0.0;
+    }
+    real64 const r = q / p;
+    if( p < 0.0 )
+    {
+      if( r > t1 )
+      {
+        return false;
+      }
+      t0 = LvArray::math::max( t0, r );
+    }
+    else
+    {
+      if( r < t0 )
+      {
+        return false;
+      }
+      t1 = LvArray::math::min( t1, r );
+    }
+    return true;
+  };
+
+  return clip( -dx, segment.endpoint0[0] - xmin ) &&
+         clip(  dx, xmax - segment.endpoint0[0] ) &&
+         clip( -dy, segment.endpoint0[1] - ymin ) &&
+         clip(  dy, ymax - segment.endpoint0[1] ) &&
+         t0 <= t1;
+}
