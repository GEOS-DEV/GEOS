# GEOS-MPM generated example/V&V case outputs
/scripts/preProcessing/materialPointMethodParticleFileWriter/examples/**/output/**
!/scripts/preProcessing/materialPointMethodParticleFileWriter/examples/**/output/
!/scripts/preProcessing/materialPointMethodParticleFileWriter/examples/**/output/.gitignore

/scripts/preProcessing/materialPointMethodParticleFileWriter/verification/**/output/**
!/scripts/preProcessing/materialPointMethodParticleFileWriter/verification/**/output/
