<?xml version="1.0" ?>
<!-- 
srun -n 4 /g/g19/homel1/geosx/build-dane-toss_4_x86_64_ib-gcc@12.1.1-mpm-minimal-tpl-release/bin/geosx -i mpm_collidingDisks.xml
-->
<Problem>

  <Mesh>
    <InternalMesh
      name="backgroundGrid"
      elementTypes="{ C3D8 }"
      xCoords="{ -1.0526315789473684, 1.0526315789473684 }"
      yCoords="{ -0.05263157894736842, 2.0526315789473686 }"
      zCoords="{ -0.07500000000000001, 0.07500000000000001 }"
      nx="{ 40 }"
      ny="{ 40 }"
      nz="{ 3 }"
      periodic="{ 0, 0, 0 }"
      cellBlockNames="{ cb1 }"/>
      
    <ParticleMesh
      name="particles"
      particleFile="mpmParticleFile_collidingDisks"
      particleBlockNames="{ pb0 }"
      particleTypes="{ CPDI }"/>
  </Mesh>

  <ElementRegions>
    <CellElementRegion
      name="CellRegion1"
      meshBody="backgroundGrid"
      cellBlocks="{ cb1 }"
      materialList="{ null }"/>
  </ElementRegions>

  <ParticleRegions>
    <ParticleRegion
        name="ParticleRegion1"
        meshBody="particles"
        particleBlocks="{ pb0 }"
        materialList="{ elasticDemo }"/>
  </ParticleRegions>

  <Solvers
    gravityVector="{ 0.0, 0.0, 0.0 }">
    <SolidMechanics_MPM
      name="mpmsolve"
      discretization="FE1"
      targetRegions="{ backgroundGrid/CellRegion1, particles/ParticleRegion1 }"
      timeIntegrationOption="ExplicitDynamic"
      updateMethod="XPIC"
      updateOrder="2"
      cflFactor="0.25"
      initialDt="1e-16"
      solverProfiling="0"
      cpdiDomainScaling="1"
      damageFieldPartitioning="1"
      planeStrain="1"
      needsNeighborList="0"
      reactionHistory="1"
      boxAverageHistory="1"
      prescribedBcTable="0"
      prescribedBoundaryFTable="0"
      boundaryConditionTypes="{0, 0, 0, 0, 0, 0}"
      frictionCoefficient="0.25"
      minParticleJacobian="0.01"
      maxParticleJacobian="10.0"
      maxParticleVelocity="10.0">
    </SolidMechanics_MPM>
  </Solvers>

  <Constitutive>
    <ElasticIsotropic
      name="null"
      defaultDensity="1000"
      defaultBulkModulus="1.0e9"
      defaultShearModulus="1.0e9"/>
<!--elasticDemo parameterization of ElasticIsotropic model, version: 2605170001-->
<ElasticIsotropic
name="elasticDemo"
defaultDensity="1.0"
defaultYoungModulus="1.0"
defaultPoissonRatio="0.25"
/>

  </Constitutive>

  <Events
    maxTime="2.0">
    <PeriodicEvent
      name="solverApplications"
      target="/Solvers/mpmsolve"/>
    <PeriodicEvent
      name="outputs"
      timeFrequency="2.0"
      target="/Outputs/siloOutput"/>
    <PeriodicEvent
      name="restart"
      timeFrequency="4.0"
      target="/Outputs/restartOutput"/> 
    <HaltEvent
      maxRuntime="3590"/>
  </Events>

  <NumericalMethods>
    <FiniteElements>
      <FiniteElementSpace
        name="FE1"
        order="1"/>
    </FiniteElements>
  </NumericalMethods>

  <Outputs>
    <Silo
    name="siloOutput"
    plotFileRoot="mpm_cpdi"
    plotLevel="1"
    parallelThreads="4"
    writeCellElementMesh="1"
    writeFaceElementMesh="0"
    writeEdgeMesh="0"
    writeFEMFaces="0"/>
    <Restart
      name="restartOutput"/>
  </Outputs>

</Problem>