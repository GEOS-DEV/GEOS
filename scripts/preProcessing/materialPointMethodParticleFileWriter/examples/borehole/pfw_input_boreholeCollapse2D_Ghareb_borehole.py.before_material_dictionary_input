# GEOMETRY OBJECTS -------------------------------------------------------------------------------------------

def make_objects():
    sample = geom.cylinder('ring',
        x1=[0.0,0.0,pfw["zmin"]-10],
        x2=[0.0,0.0,pfw["zmax"]+10],
        ri=0.5*boreholeDiameter,
        r=0.95*domainSize,
        vel=np.array([0.,0.,0.]),
        mat=0,
        group=0)

    weibullVolume = 0.25*3.1415*25.12*25.12*56.6  # test cylinder sample volume (mm^3)
    weibullModulus = 7.3 # this is a guess based on shale value
    flawSize=5*DZ

    weibullSample = geom.voronoiWeibullBoxWrapper('weibullring',
        subObject=sample,
        x0=[pfw["xmin"],pfw["ymin"],pfw["zmin"]-flawSize],
        x1=[pfw["xmax"],pfw["ymax"],pfw["zmax"]+flawSize],
        flawSize=flawSize,
        weibullVolume=weibullVolume,
        weibullModulus=weibullModulus,
        weibullSeed=1,
        vMin=(DZ)**3.
        )


    objects=[weibullSample]
    return objects

