#!/usr/bin/env bash
set -euo pipefail

# Borehole collapse example wrapper.
# The retained borehole case is borehole_Ghareb.  The source pfw_input file is
# kept as a copyable problem definition; workflow-only staging and reporting are
# delegated to examples/mpm_example_runner.py.

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
PFW_ROOT=$(cd "$SCRIPT_DIR/../.." && pwd -P)
PYTHON_CMD="${PFW_PYTHON:-${PFW_PYTHON_COMMAND:-/usr/tce/bin/python3}}"
CASE='borehole_Ghareb'
PASSTHRU=()

while [ "$#" -gt 0 ]; do
  case "$1" in
    --python)
      [ "$#" -ge 2 ] || { echo "--python requires an argument" >&2; exit 2; }
      PYTHON_CMD="$2"
      PASSTHRU+=("--python" "$2")
      shift 2
      ;;
    --case|--variant)
      [ "$#" -ge 2 ] || { echo "$1 requires an argument" >&2; exit 2; }
      CASE="$2"
      shift 2
      ;;
    --help|-h)
      echo "Usage: ./runProblem [--case borehole_Ghareb] [--python PYTHON] [runner options]"
      echo "Cases: borehole_Ghareb"
      "$PYTHON_CMD" "$PFW_ROOT/examples/mpm_example_runner.py" --help || true
      exit 0
      ;;
    *)
      PASSTHRU+=("$1")
      shift
      ;;
  esac
done

case "$CASE" in
  Ghareb|borehole_Ghareb) ;;
  *) echo "Unknown case '$CASE'. Valid case: borehole_Ghareb" >&2; exit 2 ;;
esac

exec "$PYTHON_CMD" "$PFW_ROOT/examples/mpm_example_runner.py" \
  --case-id borehole_Ghareb \
  --source-dir "$SCRIPT_DIR" \
  --input pfw_input_boreholeCollapse2D_Ghareb_borehole.py \
  --output-prefix borehole_Ghareb \
  --initial-variable Pressure \
  --final-variable PlasticStrainMagnitude \
  --view xy \
  "${PASSTHRU[@]}"
