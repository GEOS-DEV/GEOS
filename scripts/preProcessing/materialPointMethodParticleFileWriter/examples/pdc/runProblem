#!/usr/bin/env bash
set -euo pipefail

# PDC cutter example wrapper.
# The source pfw_input_pdc.py is a copyable problem definition.  Runtime
# staging, overwrite prompts, Slurm submission, and post-processing are handled
# by examples/mpm_example_runner.py.

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
PFW_ROOT=$(cd "$SCRIPT_DIR/../.." && pwd -P)
PYTHON_CMD="${PFW_PYTHON:-${PFW_PYTHON_COMMAND:-/usr/tce/bin/python3}}"
CASE='pdc'
PASSTHRU=()

while [ "$#" -gt 0 ]; do
  case "$1" in
    --python)
      [ "$#" -ge 2 ] || { echo "--python requires an argument" >&2; exit 2; }
      PYTHON_CMD="$2"
      PASSTHRU+=("--python" "$2")
      shift 2
      ;;
    --case|--variant)
      [ "$#" -ge 2 ] || { echo "$1 requires an argument" >&2; exit 2; }
      CASE="$2"
      shift 2
      ;;
    --help|-h)
      echo "Usage: ./runProblem [--case pdc] [--python PYTHON] [runner options]"
      echo "Cases: pdc"
      "$PYTHON_CMD" "$PFW_ROOT/examples/mpm_example_runner.py" --help || true
      exit 0
      ;;
    *)
      PASSTHRU+=("$1")
      shift
      ;;
  esac
done

case "$CASE" in
  pdc) ;;
  *) echo "Unknown case '$CASE'. Valid case: pdc" >&2; exit 2 ;;
esac

exec "$PYTHON_CMD" "$PFW_ROOT/examples/mpm_example_runner.py" \
  --case-id pdc \
  --source-dir "$SCRIPT_DIR" \
  --input pfw_input_pdc.py \
  --output-prefix pdc \
  --initial-variable MaterialType \
  --final-variable Damage \
  --view xy \
  "${PASSTHRU[@]}"
