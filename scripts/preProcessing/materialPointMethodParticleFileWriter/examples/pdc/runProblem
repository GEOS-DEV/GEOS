#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
PFW_ROOT=$(cd "$SCRIPT_DIR/../.." && pwd -P)
PYTHON_CMD="${PFW_PYTHON:-${PFW_PYTHON_COMMAND:-/usr/tce/bin/python3}}"
CASE='pdc'
PASSTHRU=()

while [ "$#" -gt 0 ]; do
  case "$1" in
    --python)
      [ "$#" -ge 2 ] || { echo "--python requires an argument" >&2; exit 2; }
      PYTHON_CMD="$2"
      PASSTHRU+=("--python" "$2")
      shift 2
      ;;
    --case|--variant)
      [ "$#" -ge 2 ] || { echo "$1 requires an argument" >&2; exit 2; }
      CASE="$2"
      shift 2
      ;;
    --help|-h)
      echo "Usage: ./runProblem [--case CASE] [--python PYTHON] [runner options]"
      echo "Cases: pdc pdc_r4"
      "$PYTHON_CMD" "$PFW_ROOT/examples/mpm_example_runner.py" --help || true
      exit 0
      ;;
    *)
      PASSTHRU+=("$1")
      shift
      ;;
  esac
done

case "$CASE" in
    r4) CASE='pdc_r4' ;;
esac

case "$CASE" in
    pdc) INPUT='pfw_input_pdc.py'; PREFIX='pdc'; INITIAL_VAR='MaterialType'; FINAL_VAR='Damage'; VIEW='xy' ;;
    pdc_r4) INPUT='pfw_input_pdc_r4.py'; PREFIX='pdc_r4'; INITIAL_VAR='MaterialType'; FINAL_VAR='Damage'; VIEW='xy' ;;
    *) echo "Unknown case '$CASE'. Valid cases: pdc pdc_r4" >&2; exit 2 ;;
esac

exec "$PYTHON_CMD" "$PFW_ROOT/examples/mpm_example_runner.py"   --case-id "$CASE"   --source-dir "$SCRIPT_DIR"   --input "$INPUT"   --output-prefix "$PREFIX"   --initial-variable "$INITIAL_VAR"   --final-variable "$FINAL_VAR"   --view "$VIEW"   "${PASSTHRU[@]}"
