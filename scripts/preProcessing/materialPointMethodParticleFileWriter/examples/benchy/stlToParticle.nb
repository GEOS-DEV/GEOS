Cell[BoxData[
 RowBox[{
  RowBox[{"triangleInteriorTest", "=", 
   RowBox[{"Compile", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"px", ",", "_Real"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"py", ",", "_Real"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"p1x", ",", "_Real"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"p1y", ",", "_Real"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"p2x", ",", "_Real"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"p2y", ",", "_Real"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"p3x", ",", "_Real"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"p3y", ",", "_Real"}], "}"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"s", ",", "t"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"s", "=", 
         RowBox[{"-", 
          FractionBox[
           RowBox[{
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"p1y", "-", "p3y"}], ")"}], " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "p1x"}], "+", "px"}], ")"}]}], ")"}]}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"p1x", "-", "p3x"}], ")"}], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "p1y"}], "+", "py"}], ")"}]}]}], 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"p1y", "-", "p2y"}], ")"}], " ", 
             RowBox[{"(", 
              RowBox[{"p1x", "-", "p3x"}], ")"}]}], "-", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"p1x", "-", "p2x"}], ")"}], " ", 
             RowBox[{"(", 
              RowBox[{"p1y", "-", "p3y"}], ")"}]}]}]]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"t", "=", 
         FractionBox[
          RowBox[{
           RowBox[{
            RowBox[{"-", "p1y"}], " ", "p2x"}], "+", 
           RowBox[{"p1x", " ", "p2y"}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"p1y", "-", "p2y"}], ")"}], " ", "px"}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "p1x"}], "+", "p2x"}], ")"}], " ", "py"}]}], 
          RowBox[{
           RowBox[{
            RowBox[{"-", "p2y"}], " ", "p3x"}], "+", 
           RowBox[{"p1y", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "p2x"}], "+", "p3x"}], ")"}]}], "+", 
           RowBox[{"p1x", " ", 
            RowBox[{"(", 
             RowBox[{"p2y", "-", "p3y"}], ")"}]}], "+", 
           RowBox[{"p2x", " ", "p3y"}]}]]}], ";", "\[IndentingNewLine]", 
