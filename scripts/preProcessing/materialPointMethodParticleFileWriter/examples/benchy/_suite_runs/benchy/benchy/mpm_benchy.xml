<?xml version="1.0" ?>
<!-- 
srun -n 24 /usr/WS1/homel1/GEOS/scripts/preProcessing/materialPointMethodParticleFileWriter/examples/benchy/_suite_runs/benchy/benchy/geosx -i mpm_benchy.xml
-->
<Problem>

  <Mesh>
    <InternalMesh
      name="backgroundGrid"
      elementTypes="{ C3D8 }"
      xCoords="{ -51.95652173913044, 41.95652173913044 }"
      yCoords="{ -27.272727272727273, 27.272727272727273 }"
      zCoords="{ -1.7647058823529411, 61.76470588235294 }"
      nx="{ 48 }"
      ny="{ 24 }"
      nz="{ 36 }"
      periodic="{ 0, 0, 0 }"
      cellBlockNames="{ cb1 }"/>
      
    <ParticleMesh
      name="particles"
      particleFile="mpmParticleFile_benchy"
      particleBlockNames="{ pb0, pb1 }"
      particleTypes="{ CPDI, CPDI }"/>
  </Mesh>

  <ElementRegions>
    <CellElementRegion
      name="CellRegion1"
      meshBody="backgroundGrid"
      cellBlocks="{ cb1 }"
      materialList="{ null }"/>
  </ElementRegions>

  <ParticleRegions>
    <ParticleRegion
        name="ParticleRegion1"
        meshBody="particles"
        particleBlocks="{ pb0 }"
        materialList="{ copper }"/>
    <ParticleRegion
        name="ParticleRegion2"
        meshBody="particles"
        particleBlocks="{ pb1 }"
        materialList="{ steel }"/>
  </ParticleRegions>

  <Solvers
    gravityVector="{ 0.0, 0.0, 0.0 }">
    <SolidMechanics_MPM
      name="mpmsolve"
      discretization="FE1"
      targetRegions="{ backgroundGrid/CellRegion1, particles/ParticleRegion1, particles/ParticleRegion2 }"
      timeIntegrationOption="ExplicitDynamic"
      updateMethod="FMPM"
      updateOrder="2"
      cflFactor="0.25"
      initialDt="1e-16"
      solverProfiling="1"
      cpdiDomainScaling="1"
      damageFieldPartitioning="0"
      planeStrain="0"
      needsNeighborList="0"
      reactionHistory="1"
      boxAverageHistory="1"
      prescribedBcTable="0"
      prescribedBoundaryFTable="0"
      fTableInterpType="Linear"
      contactGapCorrection="Implicit"
      explicitSurfaceNormalInfluence="1000.0"
      useSurfacePositionForContact="1"
      boundaryConditionTypes="{1, 1, 1, 1, 1, 1}"
      frictionCoefficient="0.25"
      minParticleJacobian="0.01"
      maxParticleJacobian="10.0"
      maxParticleVelocity="10000.0">
    </SolidMechanics_MPM>
  </Solvers>

  <Constitutive>
    <ElasticIsotropic
      name="null"
      defaultDensity="1000"
      defaultBulkModulus="1.0e9"
      defaultShearModulus="1.0e9"/>
<!--copper parameterization of VonMisesJ model, version: 2605160015-->
<VonMisesJ
name="copper"
defaultDensity="8.96"
defaultBulkModulus="121.875"
defaultShearModulus="43.656716"
defaultYieldStrength="0.07"
/>

<!--steel parameterization of VonMisesJ model, version: 2605160004-->
<VonMisesJ
name="steel"
defaultDensity="7.85"
defaultBulkModulus="175.0"
defaultShearModulus="80.769231"
defaultYieldStrength="0.2"
/>

  </Constitutive>

  <Events
    maxTime="0.05">
    <PeriodicEvent
      name="solverApplications"
      target="/Solvers/mpmsolve"/>
    <PeriodicEvent
      name="outputs"
      timeFrequency="0.05"
      target="/Outputs/siloOutput"/>
    <PeriodicEvent
      name="restart"
      timeFrequency="0.1"
      target="/Outputs/restartOutput"/> 
    <HaltEvent
      maxRuntime="590"/>
  </Events>

  <NumericalMethods>
    <FiniteElements>
      <FiniteElementSpace
        name="FE1"
        order="1"/>
    </FiniteElements>
  </NumericalMethods>

  <Outputs>
    <Silo
    name="siloOutput"
    plotFileRoot="mpm_cpdi"
    plotLevel="1"
    parallelThreads="24"
    writeCellElementMesh="1"
    writeFaceElementMesh="0"
    writeEdgeMesh="0"
    writeFEMFaces="0"/>
    <Restart
      name="restartOutput"/>
  </Outputs>

</Problem>