def parse_args():
    p = argparse.ArgumentParser(description="Dispatch GEOS-MPM examples and build a PDF report")
    p.add_argument("command", nargs="?", default="all", choices=("run", "report", "all"))
    p.add_argument("--python", dest="python_cmd", default=os.environ.get("PFW_PYTHON", "/usr/tce/bin/python3"))
    p.add_argument("--case", action="append", choices=sorted(CASE_BY_ID), help="Run/report one selected case; may be repeated")
    p.add_argument("--force", "-y", action="store_true", help="Do not prompt; pass --force to child runProblem scripts")
    p.add_argument("--no-wait", action="store_true")
    p.add_argument("--no-visit", action="store_true")
    p.add_argument("--post-walltime", default="00:05:00")
    p.add_argument("--post-partition", default="pdebug")
    p.add_argument("--report-dir", default="examples_suite_report")
    p.add_argument("--timing-retries", type=int, default=5)
    p.add_argument("--timing-sleep", type=float, default=6.0)
    p.add_argument("--dispatch-timeout", type=float, default=0.0,
                   help="Seconds before aborting a stuck child runProblem dispatch; 0 disables the timeout")
    p.add_argument("--stop-on-error", action="store_true",
                   help="Restore fail-fast behavior instead of recording a failure and continuing")
    return p.parse_args()


def active_examples():
    retired = {"borehole_Damage_Ghareb", "pdc_r4"}
    return [c for c in EXAMPLES if c.get("id") not in retired]


def selected(args):
    if args.case:
        return [CASE_BY_ID[c] for c in args.case if CASE_BY_ID[c].get("id") not in {"borehole_Damage_Ghareb", "pdc_r4"}]
    root = Path(__file__).resolve().parent
    return [c for c in active_examples() if (root / c["dir"]).is_dir()]


def output_dir(root, case):
    return root / case["dir"] / "output"


def log_path(root, case):
    return output_dir(root, case) / f"{case['prefix']}_runProblem.log"


def run_cmd(cmd, cwd, timeout=0.0):
    """Run one child command, stream its output live, and capture it for logs.

    stdin is /dev/null so a hidden child prompt cannot hang the suite.  Use
    --force at the suite level for noninteractive reruns.
    """
    print("+ " + " ".join(str(c) for c in cmd), flush=True)
    output = []
    timeout = float(timeout or 0.0)
    start = time.time()
    proc = subprocess.Popen(
        cmd,
        cwd=cwd,
        text=True,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        bufsize=1,
    )
    try:
        assert proc.stdout is not None
        while True:
            line = proc.stdout.readline()
            if line:
                output.append(line)
                print(line, end="", flush=True)
            elif proc.poll() is not None:
                break
            else:
                if timeout > 0.0 and (time.time() - start) > timeout:
                    msg = f"ERROR: child command exceeded dispatch timeout of {timeout:g} s; terminating.\n"
                    print(msg, end="", flush=True)
                    output.append(msg)
                    proc.terminate()
                    try:
                        proc.wait(timeout=10)
                    except subprocess.TimeoutExpired:
                        proc.kill()
                        proc.wait()
                    return 124, "".join(output)
                time.sleep(0.1)
        code = proc.wait()
        return code, "".join(output)
    except KeyboardInterrupt:
        try:
            proc.terminate()
        finally:
            raise


def confirm_suite_rerun(args):
    if args.command not in ("run", "all"):
        return
    if args.force:
        return
    cases = selected(args)
    case_names = ", ".join(str(c.get("id", "<unknown>")) for c in cases)
    msg = (
        "runExampleSuite will dispatch runProblem for: " + case_names + "\n"
        "For suite runs, child prompts are disabled to avoid hidden hangs.\n"
        "Continuing will pass --force to each selected runProblem, allowing it to overwrite\n"
        "case-specific generated files in the Lustre run directory and example output directory.\n"
        "Parent directories such as testRunDirectory and defaultRunDirectory are not removed."
    )
    if not sys.stdin.isatty():
        raise SystemExit(msg + "\nERROR: noninteractive suite run requires --force")
    print(msg)
    answer = input("Continue and rerun selected examples? [y/N] ").strip().lower()
    if answer not in ("y", "yes"):
        raise SystemExit("suite run cancelled")
    args.force = True


def write_case_records(root, case, rec):
    odir = output_dir(root, case)
    odir.mkdir(parents=True, exist_ok=True)
    (odir / f"{case['prefix']}_jobs.json").write_text(json.dumps({"case": case["id"], "jobs": rec}, indent=2, sort_keys=True) + "\n")
    if rec.get("log"):
        (odir / f"{case['prefix']}_runProblem.log").write_text(rec["log"])


def dispatch(root, args):
    jobs = []
    for case in selected(args):
        cdir = root / case["dir"]
        odir = output_dir(root, case)
        odir.mkdir(parents=True, exist_ok=True)
        rec = {
            "case": case["id"],
            "prefix": case["prefix"],
            "dir": case["dir"],
            "geos": "",
            "post": "",
            "returncode": None,
            "status": "not_run",
            "error": "",
            "log_file": str(log_path(root, case).relative_to(root)),
        }
        if not (cdir / "runProblem").exists():
            rec.update({"returncode": 127, "status": "missing_runProblem", "error": f"no runProblem in {cdir}"})
            rec["log"] = "ERROR: " + rec["error"] + "\n"
            print(f"WARNING: skipping {case['id']}; {rec['error']}")
            write_case_records(root, case, rec)
            jobs.append(rec)
            if args.stop_on_error:
                raise SystemExit(rec["error"])
            continue

        cmd = ["./runProblem", "--python", args.python_cmd, "--post-walltime", args.post_walltime, "--post-partition", args.post_partition]
        cmd += case.get("args", [])
        # The suite prompt/--force has already decided overwrite policy.  Always
        # pass --force to children during suite dispatch to avoid hidden prompts.
        if args.force:
            cmd.append("--force")
        if args.no_visit:
            cmd.append("--no-visit")
        code, out = run_cmd(cmd, cdir, args.dispatch_timeout)
        geos = re.findall(r"GEOS job id:\s*([0-9]+)", out)
        post = re.findall(r"post-process job id:\s*([0-9]+)", out)
        rec.update({
            "geos": geos[-1] if geos else "",
            "post": post[-1] if post else "",
            "returncode": code,
            "status": "submitted" if code == 0 else "dispatch_failed",
            "error": "" if code == 0 else f"runProblem failed with exit code {code}",
            "log": out,
        })
        write_case_records(root, case, rec)
        jobs.append(rec)
        if code != 0:
            print(f"WARNING: {case['id']} failed with {code}; continuing with remaining examples", flush=True)
            if args.stop_on_error:
                raise SystemExit(f"{case['id']} failed with {code}")

    rdir = root / args.report_dir
    rdir.mkdir(exist_ok=True)
    suite_jobs = {
        "generated_at": datetime.now().isoformat(timespec="seconds"),
        "cases": [{k: v for k, v in rec.items() if k != "log"} for rec in jobs],
    }
    (rdir / "examples_suite_jobs.json").write_text(json.dumps(suite_jobs, indent=2, sort_keys=True) + "\n")
    return jobs


def wait_jobs(jobs):
    ids = [j.get("post", "") for j in jobs if j.get("post")]
    if not ids or shutil.which("squeue") is None:
        return
    joined = ",".join(ids)
    print("Waiting for postprocess jobs: " + joined)
    while True:
        proc = subprocess.run(["squeue", "-h", "-j", joined], text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        if proc.returncode != 0 or not proc.stdout.strip():
            break
        print("still queued/running: " + " ".join(line.split()[0] for line in proc.stdout.splitlines() if line.strip()))
        time.sleep(30)


def read_json(path, default):
    try:
        return json.loads(path.read_text())
    except Exception:
        return default


def load_jobs(root, args):
    data = read_json(root / args.report_dir / "examples_suite_jobs.json", {})
    records = data.get("cases", []) if isinstance(data, dict) else []
    by_case = {r.get("case"): r for r in records if isinstance(r, dict)}
    for case in selected(args):
        j = read_json(output_dir(root, case) / f"{case['prefix']}_jobs.json", {})
        if isinstance(j, dict) and j.get("jobs"):
            rec = j["jobs"]
            by_case.setdefault(case["id"], rec)
    return [by_case[c["id"]] for c in selected(args) if c["id"] in by_case]


def sacct_rows(job_ids):
    if not job_ids or shutil.which("sacct") is None:
        return {}, "sacct unavailable or no job ids"
    joined = ",".join(job_ids)
    for fields in SACCT_FORMATS:
        proc = subprocess.run(["sacct", "-j", joined, "-X", "-n", "-P", "-o", ",".join(fields)], text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        if proc.returncode != 0:
            continue
        clean = [f.split("%", 1)[0] for f in fields]
        rows = {}
        for line in proc.stdout.splitlines():
            parts = line.split("|")
            row = dict(zip(clean, parts + [""] * (len(clean)-len(parts))))
            jid = (row.get("JobIDRaw") or row.get("JobID") or "").split(".",1)[0].split("_",1)[0]
            if jid in job_ids and jid not in rows:
                rows[jid] = row
        if rows:
            return rows, ""
    return {}, "sacct returned no rows"


def query_timing(root, args, jobs):
    ids = []
    for j in jobs:
        for key in ("geos", "post"):
            jid = str(j.get(key, ""))
            if jid and jid not in ids:
                ids.append(jid)
    rows, note = {}, ""
    if ids:
        for attempt in range(max(1, args.timing_retries)):
            rows, note = sacct_rows(ids)
            if rows or attempt == args.timing_retries - 1:
                break
            time.sleep(args.timing_sleep)
    else:
        note = "no job ids to query"
    payload = {"generated_at": datetime.now().isoformat(timespec="seconds"), "note": note, "jobs": jobs, "sacct_by_job_id": rows, "cases": {}}
    for rec in jobs:
        payload["cases"][rec["case"]] = {
            "status": rec.get("status", ""),
            "returncode": rec.get("returncode"),
            "error": rec.get("error", ""),
            "log_file": rec.get("log_file", ""),
            "jobs": {"geos": rec.get("geos", ""), "post": rec.get("post", "")},
            "timing": {"geos": rows.get(rec.get("geos", ""), {}), "post": rows.get(rec.get("post", ""), {})},
        }
    rdir = root / args.report_dir
    rdir.mkdir(exist_ok=True)
    (rdir / "examples_suite_timing.json").write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
    with (rdir / "examples_suite_timing.csv").open("w", newline="") as f:
        writer = csv.writer(f)
        writer.writerow(["case", "status", "phase", "job_id", "state", "exit", "elapsed", "total_cpu", "cpu_time_raw", "alloc_cpus", "error"])
        for case_id, rec in payload["cases"].items():
            for phase in ("geos", "post"):
                row = rec["timing"].get(phase, {})
                writer.writerow([case_id, rec.get("status", ""), phase, rec["jobs"].get(phase, ""), row.get("State", ""), row.get("ExitCode", ""), row.get("Elapsed", ""), row.get("TotalCPU", ""), row.get("CPUTimeRAW", ""), row.get("AllocCPUS", ""), rec.get("error", "")])
    return payload


def latex_escape(s):
    return str(s).replace("\\", r"\textbackslash{} ").replace("&", r"\&").replace("%", r"\%").replace("$", r"\$").replace("#", r"\#").replace("_", r"\_").replace("{", r"\{").replace("}", r"\}").replace("~", r"\textasciitilde{}")


def include_graphics(path, report_dir, width="0.31\\textwidth"):
    path = Path(path)
    if path.is_file():
        rel = os.path.relpath(path, report_dir)
        return r"\includegraphics[width=" + width + "]{" + rel.replace("\\", "/") + "}"
    return r"\fbox{\begin{minipage}[c][0.22\textheight][c]{" + width + r"}\centering missing\\" + latex_escape(path.name) + r"\end{minipage}}"


def find_prefixed_png(odir: Path, prefix: str, token: str):
    exact = odir / token
    if exact.is_file():
        return exact
    matches = sorted(odir.glob(prefix + "*" + token + "*.png")) if not token.endswith(".png") else []
    if not matches:
        low = token.lower().replace(".png", "")
        matches = [p for p in sorted(odir.glob(prefix + "*.png")) if low in p.name.lower()]
    return matches[0] if matches else odir / (prefix + "_" + token)


