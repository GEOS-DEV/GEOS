def parse_args():
    p = argparse.ArgumentParser(description="Dispatch GEOS-MPM examples and build a PDF report")
    p.add_argument("command", nargs="?", default="all", choices=("run", "report", "all"))
    p.add_argument("--python", dest="python_cmd", default=os.environ.get("PFW_PYTHON", "/usr/tce/bin/python3"))
    p.add_argument("--case", action="append", choices=sorted(CASE_BY_ID), help="Run/report one selected case; may be repeated")
    p.add_argument("--force", "-y", action="store_true")
    p.add_argument("--no-wait", action="store_true", help="Submit jobs and return without waiting/reporting completion")
    p.add_argument("--no-visit", action="store_true")
    p.add_argument("--stop-on-error", action="store_true", help="Stop dispatching after the first runProblem failure")
    p.add_argument("--dispatch-timeout", type=float, default=0.0, help="Optional runProblem timeout in seconds")
    p.add_argument("--post-walltime", default="00:05:00")
    p.add_argument("--walltime", default=None, help="Optional GEOS walltime override; by default use each pfw_input mWallTime")
    p.add_argument("--post-partition", default="pdebug")
    p.add_argument("--report-dir", default="examples_suite_report")
    p.add_argument("--timing-retries", type=int, default=8)
    p.add_argument("--timing-sleep", type=float, default=8.0)
    p.add_argument("--wait-timeout", type=float, default=0.0, help="Optional wait timeout for Slurm jobs in seconds; 0 waits until terminal")
    p.add_argument("--skip-backfill", action="store_true", help="Do not copy existing PNG/log outputs from run directories during report generation")
    return p.parse_args()


def selected(args):
    root = Path(__file__).resolve().parent
    if args.case:
        # Preserve order and de-duplicate aliases.
        out = []
        seen = set()
        for name in args.case:
            case = CASE_BY_ID[name]
            if case["id"] not in seen:
                out.append(case)
                seen.add(case["id"])
        return out
    return [c for c in EXAMPLES if (root / c["dir"]).is_dir()]


def output_dir(root, case):
    return root / case["dir"] / "output"


def stream_run_cmd(cmd, cwd, log_path, timeout=0.0):
    print("+ " + " ".join(str(c) for c in cmd), flush=True)
    log_path.parent.mkdir(parents=True, exist_ok=True)
    start = time.time()
    with log_path.open("w", encoding="utf-8", errors="replace") as log:
        log.write("+ " + " ".join(str(c) for c in cmd) + "\n")
        proc = subprocess.Popen(
            cmd,
            cwd=cwd,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            stdin=subprocess.DEVNULL,
            bufsize=1,
        )
        assert proc.stdout is not None
        timed_out = False
        try:
            while True:
                line = proc.stdout.readline()
                if line:
                    print(line, end="", flush=True)
                    log.write(line)
                    log.flush()
                elif proc.poll() is not None:
                    break
                if timeout and (time.time() - start) > timeout:
                    timed_out = True
                    proc.kill()
                    break
                if not line:
                    time.sleep(0.05)
            for line in proc.stdout:
                print(line, end="", flush=True)
                log.write(line)
        finally:
            code = proc.wait()
        if timed_out:
            log.write(f"\nERROR: dispatch timeout after {timeout} seconds\n")
            return 124
        return code


def extract_job_ids_from_text(text):
    ids = re.findall(r"Submitted job with ID\s*=\s*([0-9]+)", text)
    ids += re.findall(r"GEOS job id:\s*([0-9]+)", text)
    post = re.findall(r"post-process job id:\s*([0-9]+)", text)
    post += re.findall(r"Submitted batch job\s+([0-9]+)", text)
    geos = ids[-1] if ids else ""
    # The last Submitted batch job line may be the post job, but PFW may also print one
    # for the GEOS submit. Prefer the explicit post-process marker when present.
    post_job = post[-1] if post else ""
    return geos, post_job


def read_json(path):
    try:
        return json.loads(path.read_text())
    except Exception:
        return None


def dispatch(root, args):
    jobs = []
    failures = []
    cases = selected(args)
    if not args.force and args.command in ("run", "all"):
        if not sys.stdin.isatty():
            raise SystemExit("ERROR: noninteractive suite runs require --force")
        print("The suite may overwrite case-specific generated output for selected examples.")
        answer = input("Continue and rerun selected examples? [y/N] ").strip().lower()
        if answer not in {"y", "yes"}:
            raise SystemExit("suite rerun cancelled")
        args.force = True
    for case in cases:
        cdir = root / case["dir"]
        odir = output_dir(root, case)
        odir.mkdir(parents=True, exist_ok=True)
        log_path = odir / f"{case['prefix']}_runProblem.log"
        cmd = ["./runProblem", "--python", args.python_cmd, "--post-walltime", args.post_walltime, "--post-partition", args.post_partition]
        if args.walltime:
            cmd += ["--walltime", args.walltime]
        if args.no_visit:
            cmd.append("--no-visit")
        if args.force:
            cmd.append("--force")
        cmd += list(case.get("args", []))
        code = stream_run_cmd(cmd, cdir, log_path, args.dispatch_timeout)
        log_text = log_path.read_text(errors="replace") if log_path.is_file() else ""
        geos, post = extract_job_ids_from_text(log_text)
        # Prefer the explicit jobs json written by the case wrapper if present.
        for jobs_file in sorted(odir.glob(case["prefix"] + "*_jobs.json")):
            data = read_json(jobs_file)
            if isinstance(data, dict):
                geos = data.get("jobs", {}).get("geos", geos) or geos
                post = data.get("jobs", {}).get("post", post) or post
        rec = {"case": case["id"], "geos": geos, "post": post, "dispatch_returncode": code, "runProblem_log": str(log_path)}
        jobs.append(rec)
        if code != 0:
            failures.append(rec)
            print(f"{case['id']} failed with {code}; continuing", file=sys.stderr, flush=True)
            if args.stop_on_error:
                break
    write_jobs(root, args, jobs)
    return jobs


def write_jobs(root, args, jobs):
    rdir = root / args.report_dir
    rdir.mkdir(exist_ok=True)
    payload = {"generated_at": datetime.now().isoformat(timespec="seconds"), "cases": jobs}
    (rdir / "examples_suite_jobs.json").write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")


def load_jobs(root, args):
    rdir = root / args.report_dir
    path = rdir / "examples_suite_jobs.json"
    jobs = []
    if path.is_file():
        data = read_json(path)
        if isinstance(data, dict):
            jobs = list(data.get("cases", []))
    # Merge in case-local jobs json. This is especially useful after --no-wait or
    # interrupted suite runs.
    by_case = {j.get("case"): dict(j) for j in jobs if j.get("case")}
    for case in selected(args):
        odir = output_dir(root, case)
        for jf in sorted(odir.glob(case["prefix"] + "*_jobs.json")):
            data = read_json(jf)
            if not isinstance(data, dict):
                continue
            rec = by_case.setdefault(case["id"], {"case": case["id"]})
            rec.setdefault("geos", data.get("jobs", {}).get("geos", ""))
            rec.setdefault("post", data.get("jobs", {}).get("post", ""))
            if data.get("run_dir"):
                rec["run_dir"] = data.get("run_dir")
            if data.get("output_dir"):
                rec["output_dir"] = data.get("output_dir")
    return list(by_case.values())


def job_ids(jobs):
    ids = []
    for j in jobs:
        for key in ("geos", "post"):
            value = str(j.get(key, "")).strip()
            if value and value not in ids:
                ids.append(value)
    return ids


def squeue_states(ids):
    if not ids or not shutil.which("squeue"):
        return {}
    proc = subprocess.run(["squeue", "-h", "-j", ",".join(ids), "-o", "%A|%T|%M|%R"], text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    out = {}
    for line in proc.stdout.splitlines():
        parts = line.split("|", 3)
        if len(parts) >= 2:
            out[parts[0]] = {"State": parts[1], "Elapsed": parts[2] if len(parts) > 2 else "", "Reason": parts[3] if len(parts) > 3 else ""}
    return out


def wait_jobs(jobs, timeout=0.0):
    ids = job_ids(jobs)
    if not ids or not shutil.which("squeue"):
        return
    start = time.time()
    while True:
        states = squeue_states(ids)
        remaining = [jid for jid in ids if jid in states]
        if not remaining:
            return
        summary = ", ".join(f"{jid}:{states[jid].get('State','')}" for jid in remaining[:8])
        print("waiting for Slurm jobs: " + summary, flush=True)
        if timeout and (time.time() - start) > timeout:
            print("WARNING: wait timeout reached; report will mark unfinished jobs as incomplete", file=sys.stderr)
            return
        time.sleep(30.0)


def run_sacct(ids):
    if not ids or not shutil.which("sacct"):
        return {}
    for fields in SACCT_FORMATS:
        cmd = ["sacct", "-n", "-P", "-X", "-j", ",".join(ids), "-o", ",".join(fields)]
        proc = subprocess.run(cmd, text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        if proc.returncode != 0 or not proc.stdout.strip():
            continue
        result = {}
        normalized = [f.split("%", 1)[0] for f in fields]
        for line in proc.stdout.splitlines():
            parts = line.rstrip("\n").split("|")
            if not parts or not parts[0].strip():
                continue
            row = {}
            for key, value in zip(normalized, parts):
                row[key] = value.strip()
            jid = row.get("JobIDRaw") or row.get("JobID") or parts[0].strip()
            jid = jid.split(".", 1)[0]
            result[jid] = row
        if result:
            return result
    return {}


def query_timing(root, args, jobs):
    ids = job_ids(jobs)
    sacct = {}
    for attempt in range(max(args.timing_retries, 1)):
        sacct = run_sacct(ids)
        if all(jid in sacct for jid in ids if jid):
            break
        if attempt < args.timing_retries - 1:
            time.sleep(args.timing_sleep)
    sq = squeue_states(ids)
    payload = {"generated_at": datetime.now().isoformat(timespec="seconds"), "jobs": jobs, "sacct_by_job_id": sacct, "squeue_by_job_id": sq, "cases": {}}
    for j in jobs:
        cid = j.get("case", "")
        geos = str(j.get("geos", ""))
        post = str(j.get("post", ""))
        payload["cases"][cid] = {
            "jobs": {"geos": geos, "post": post},
            "dispatch_returncode": j.get("dispatch_returncode", 0),
            "runProblem_log": j.get("runProblem_log", ""),
            "run_dir": j.get("run_dir", ""),
            "output_dir": j.get("output_dir", ""),
            "timing": {"geos": sacct.get(geos, sq.get(geos, {})), "post": sacct.get(post, sq.get(post, {}))},
        }
    rdir = root / args.report_dir
    rdir.mkdir(exist_ok=True)
    (rdir / "examples_suite_timing.json").write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
    with (rdir / "examples_suite_timing.csv").open("w", newline="") as f:
        writer = csv.writer(f)
        writer.writerow(["case", "phase", "job_id", "state", "exit", "elapsed", "total_cpu", "cpu_time_raw", "alloc_cpus"])
        for case_id, rec in payload["cases"].items():
            for phase in ("geos", "post"):
                row = rec["timing"].get(phase, {})
                writer.writerow([case_id, phase, rec["jobs"].get(phase, ""), row.get("State", ""), row.get("ExitCode", ""), row.get("Elapsed", ""), row.get("TotalCPU", ""), row.get("CPUTimeRAW", ""), row.get("AllocCPUS", "")])
    return payload


def latex_escape(s):
    s = str(s)
    return (s.replace("\\", r"\textbackslash{} ").replace("&", r"\&").replace("%", r"\%").replace("$", r"\$")
             .replace("#", r"\#").replace("_", r"\_").replace("{", r"\{").replace("}", r"\}").replace("~", r"\textasciitilde{}"))


def load_case_jobs(root, case):
    odir = output_dir(root, case)
    rec = {}
    for jf in sorted(odir.glob(case["prefix"] + "*_jobs.json")):
        data = read_json(jf)
        if isinstance(data, dict):
            rec.update(data)
    return rec


def backfill_outputs(root, case):
    odir = output_dir(root, case)
    odir.mkdir(parents=True, exist_ok=True)
    data = load_case_jobs(root, case)
    run_dir_text = data.get("run_dir", "") if isinstance(data, dict) else ""
    if not run_dir_text:
        return []
    run_dir = Path(os.path.expanduser(os.path.expandvars(run_dir_text)))
    copied = []
    for base in [run_dir / "visit_frames", run_dir]:
        if not base.is_dir():
            continue
        for pattern in [case["prefix"] + "*.png", case["prefix"] + "*.csv", case["prefix"] + "*.log", case["prefix"] + "*.json"]:
            for src in sorted(base.glob(pattern)):
                if src.is_file():
                    dst = odir / src.name
                    if not dst.is_file() or src.stat().st_mtime > dst.stat().st_mtime:
                        shutil.copy2(src, dst)
                    copied.append(dst.name)
        for src_name in ["reactionHistory.csv", "boxAverageHistory.csv"]:
            src = base / src_name
            if src.is_file():
                shutil.copy2(src, odir / src_name)
                copied.append(src_name)
    return sorted(set(copied))


def pngs_for_case(root, case):
    odir = output_dir(root, case)
    return sorted([p for p in odir.glob(case["prefix"] + "*.png") if p.is_file()])


def find_image(root, case, token):
    odir = output_dir(root, case)
    if not token:
        return None
    exact = odir / token
    if exact.is_file():
        return exact
    prefix = case["prefix"]
    low_tokens = [t for t in re.split(r"[^a-z0-9]+", str(token).lower().replace(".png", "")) if t]
    all_pngs = pngs_for_case(root, case)
    for path in all_pngs:
        low = path.name.lower()
        if all(t in low for t in low_tokens):
            return path
    # relaxed matching for generic tokens like initial/final/pressure.
    if low_tokens:
        for path in all_pngs:
            low = path.name.lower()
            if any(t in low for t in low_tokens):
                return path
    return None


def find_reaction(root, case):
    token = case.get("reaction", "")
    if token:
        path = find_image(root, case, token)
        if path:
            return path
    odir = output_dir(root, case)
    matches = list(odir.glob(case["prefix"] + "*reaction*.png")) + list(odir.glob(case["prefix"] + "*reactions*.png"))
    return sorted(matches)[0] if matches else None


def include_graphics(path, report_dir, width="0.31\\textwidth", missing_label="missing"):
    if path and Path(path).is_file():
        rel = os.path.relpath(path, report_dir)
        return r"\includegraphics[width=" + width + "]{" + rel.replace("\\", "/") + "}"
    return r"\fbox{\begin{minipage}[c][0.16\textheight][c]{" + width + r"}\centering " + latex_escape(missing_label) + r"\end{minipage}}"


def state_of(timing, case_id, phase):
    return timing.get("cases", {}).get(case_id, {}).get("timing", {}).get(phase, {}).get("State", "") if isinstance(timing, dict) else ""


def cell(timing, case_id, phase, key):
    return timing.get("cases", {}).get(case_id, {}).get("timing", {}).get(phase, {}).get(key, "") if isinstance(timing, dict) else ""


def job_id(timing, case_id, phase):
    return timing.get("cases", {}).get(case_id, {}).get("jobs", {}).get(phase, "") if isinstance(timing, dict) else ""


def dispatch_code(timing, case_id):
    return timing.get("cases", {}).get(case_id, {}).get("dispatch_returncode", 0) if isinstance(timing, dict) else 0


def case_status(root, case, timing):
    cid = case["id"]
    code = dispatch_code(timing, cid)
    geos_state = state_of(timing, cid, "geos")
    post_state = state_of(timing, cid, "post")
    initial = find_image(root, case, case.get("initial", ""))
    final = find_image(root, case, case.get("final", ""))
    reaction_required = bool(case.get("reaction"))
    reaction = find_reaction(root, case) if reaction_required else None
    images_ok = bool(initial and final and ((not reaction_required) or reaction))
    if code not in (0, "", None):
        return "dispatch failed"
    # Prefer the actual artifacts when regenerating a report from existing output
    # folders. This prevents an old report-only run with no jobs json from labeling
    # successfully copied figures as not run.
    if images_ok:
        if not job_id(timing, cid, "geos") and not geos_state:
            return "figures available"
        return "complete"
    if geos_state in BAD_STATES:
        return "GEOS " + geos_state
    if post_state in BAD_STATES:
        return "post " + post_state
    if geos_state and geos_state not in TERMINAL_STATES:
        return "GEOS " + geos_state
    if post_state and post_state not in TERMINAL_STATES:
        return "post " + post_state
    if not geos_state and job_id(timing, cid, "geos"):
        return "GEOS unknown"
    if not post_state and job_id(timing, cid, "post"):
        return "post unknown"
    if geos_state == "COMPLETED":
        return "missing figures"
    if not job_id(timing, cid, "geos"):
        return "not run"
    return "incomplete"


def important_log_excerpt(root, case, max_lines=24):
    odir = output_dir(root, case)
    data = load_case_jobs(root, case)
    run_dir = Path(os.path.expanduser(os.path.expandvars(str(data.get("run_dir", ""))))) if isinstance(data, dict) and data.get("run_dir") else None
    candidates = []
    candidates += sorted(odir.glob(case["prefix"] + "*.log"))
    candidates += sorted(odir.glob(case["prefix"] + "*.txt"))
    if run_dir and run_dir.is_dir():
        candidates += sorted(run_dir.glob(case["prefix"] + "*.log"))
        candidates += sorted(run_dir.glob("slurm-*.out"))[-4:]
    interesting = []
    patterns = re.compile(r"(ERROR|Error|EXCEPTION|Traceback|FAILED|CANCELLED|TIMEOUT|TIME LIMIT|NODE_FAIL|OUT_OF_MEMORY|VisIt|warning|no PNG|missing|skipping)", re.I)
    for path in candidates:
        try:
            lines = path.read_text(errors="replace").splitlines()
        except Exception:
            continue
        hits = [line for line in lines if patterns.search(line)]
        if hits:
            interesting.append("# " + path.name)
            interesting.extend(hits[-max_lines:])
        elif path.name.endswith("_runProblem.log"):
            interesting.append("# " + path.name)
            interesting.extend(lines[-min(max_lines, len(lines)):])
        if len(interesting) > max_lines:
            break
    if not interesting:
        return []
    return interesting[-max_lines:]


def timing_table(root, timing, cases):
    lines = [r"\begin{longtable}{p{0.18\textwidth}p{0.16\textwidth}p{0.13\textwidth}p{0.12\textwidth}p{0.1\textwidth}p{0.12\textwidth}p{0.1\textwidth}}", r"\toprule", "Example & Status & GEOS state & GEOS wall & GEOS CPU & Post state & Post wall " + r"\\", r"\midrule", r"\endhead"]
    for c in cases:
        cid = c["id"]
        cpu = cell(timing,cid,"geos","TotalCPU") or cell(timing,cid,"geos","CPUTimeRAW")
        lines.append(" & ".join(latex_escape(x) for x in [cid, case_status(root, c, timing), state_of(timing,cid,"geos"), cell(timing,cid,"geos","Elapsed"), cpu, state_of(timing,cid,"post"), cell(timing,cid,"post","Elapsed")]) + r" \\")
    lines += [r"\bottomrule", r"\end{longtable}"]
    return "\n".join(lines)


