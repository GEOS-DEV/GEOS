def failure_summary(root, cases, timing):
    lines = []
    for c in cases:
        status = case_status(root, c, timing)
        if status in {"complete", "figures available"}:
            continue
        lines.append(r"\subsection*{" + latex_escape(c["id"]) + r" -- " + latex_escape(status) + r"}")
        lines.append(r"\textbf{GEOS job/state:} " + latex_escape(job_id(timing,c['id'],'geos')) + " / " + latex_escape(state_of(timing,c['id'],'geos')) + r"\\")
        lines.append(r"\textbf{Post job/state:} " + latex_escape(job_id(timing,c['id'],'post')) + " / " + latex_escape(state_of(timing,c['id'],'post')))
        excerpt = important_log_excerpt(root, c)
        if excerpt:
            lines.append(r"\begin{verbatim}")
            lines.extend(excerpt[:30])
            lines.append(r"\end{verbatim}")
        else:
            lines.append("No diagnostic log excerpt was found. The case may not have started or may still be queued/running.")
    return lines


def generate_report(root, args, timing):
    rdir = root / args.report_dir
    rdir.mkdir(exist_ok=True)
    cases = selected(args)
    if not args.skip_backfill:
        for c in cases:
            backfill_outputs(root, c)
    schematics = try_make_schematics(root, cases, rdir)
    lines = [
        r"\documentclass[10pt]{article}",
        r"\usepackage[margin=0.65in]{geometry}",
        r"\usepackage{graphicx}",
        r"\usepackage{float}",
        r"\usepackage{booktabs}",
        r"\usepackage{longtable}",
        r"\usepackage{xcolor}",
        r"\setlength{\parindent}{0pt}",
        r"\setlength{\parskip}{0.35em}",
        r"\begin{document}",
        r"\title{GEOS-MPM Examples Suite Report}",
        r"\author{Generated by examples/runExampleSuite}",
        r"\date{\today}",
        r"\maketitle",
        r"\section*{Running and rerunning}",
        r"Each example directory contains a copyable \texttt{pfw\_input\_*.py} and a \texttt{runProblem} wrapper. The wrapper stages an isolated case directory under \texttt{testRunDirectory}, copies the needed PFW files, runs the particle-file writer, submits GEOS, submits dependent post-processing, and copies figures/logs back to the example \texttt{output/} directory.",
        r"\begin{verbatim}",
        r"cd scripts/preProcessing/materialPointMethodParticleFileWriter/examples",
