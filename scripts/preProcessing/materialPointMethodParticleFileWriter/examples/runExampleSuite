def timing_cell(timing, case_id, phase, key):
    return timing.get("cases", {}).get(case_id, {}).get("timing", {}).get(phase, {}).get(key, "") if isinstance(timing, dict) else ""


def job_id(timing, case_id, phase):
    return timing.get("cases", {}).get(case_id, {}).get("jobs", {}).get(phase, "") if isinstance(timing, dict) else ""


def timing_table(timing, cases):
    lines = [r"\begin{table}[H]", r"\centering", r"\scriptsize", r"\begin{tabular}{llrrrrrr}", r"\toprule", r"Example & Family & GEOS job & GEOS state & GEOS wall & GEOS CPU & Post wall & Post CPU \\", r"\midrule"]
    for c in cases:
        cid = c["id"]
        lines.append(" & ".join(latex_escape(x) for x in [cid, c["family"], job_id(timing,cid,"geos"), timing_cell(timing,cid,"geos","State"), timing_cell(timing,cid,"geos","Elapsed"), timing_cell(timing,cid,"geos","TotalCPU") or timing_cell(timing,cid,"geos","CPUTimeRAW"), timing_cell(timing,cid,"post","Elapsed"), timing_cell(timing,cid,"post","TotalCPU") or timing_cell(timing,cid,"post","CPUTimeRAW")]) + r" \\")
    lines += [r"\bottomrule", r"\end{tabular}", r"\end{table}"]
    return "\n".join(lines)


def generate_report(root, args, timing):
    rdir = root / args.report_dir
    rdir.mkdir(exist_ok=True)
    cases = selected(args)
    lines = [
        r"\documentclass[11pt]{article}",
        r"\usepackage[margin=0.75in]{geometry}",
        r"\usepackage{graphicx}",
        r"\usepackage{float}",
        r"\usepackage{booktabs}",
        r"\usepackage{rotating}",
        r"\setlength{\parindent}{0pt}",
        r"\setlength{\parskip}{0.5em}",
        r"\begin{document}",
        r"\title{GEOS-MPM Examples Suite Report}",
        r"\author{Generated by examples/runExampleSuite}",
        r"\date{\today}",
        r"\maketitle",
        r"\section*{Running and rerunning}",
        r"Each example directory contains a copyable \texttt{pfw\_input\_*.py} and a \texttt{runProblem} wrapper.  The wrapper stages an isolated case directory under \texttt{testRunDirectory}, copies the needed PFW files, runs the particle-file writer, submits GEOS, submits dependent post-processing, and copies figures/logs back to the example \texttt{output/} directory.",
        r"\begin{verbatim}",
        r"cd scripts/preProcessing/materialPointMethodParticleFileWriter/examples",
        r"./runExampleSuite all --python /usr/tce/bin/python3 --force",
        r"./runExampleSuite all --case borehole_Ghareb --python /usr/tce/bin/python3 --force",
        r"./runExampleSuite report --python /usr/tce/bin/python3",
        r"\end{verbatim}",
        r"If output exists, \texttt{runProblem} prompts before overwriting. Use \texttt{--force} for noninteractive reruns.",
        r"\section*{Timing summary}",
        timing_table(timing, cases),
    ]
    for c in cases:
        odir = output_dir(root, c)
        prefix = c["prefix"]
        if c["initial"].endswith("_"):
            initial = find_prefixed_png(odir, prefix, "initial")
            final = find_prefixed_png(odir, prefix, "final")
        else:
            initial = odir / c["initial"]
            final = odir / c["final"]
        reaction = odir / c.get("reaction", "") if c.get("reaction") else None
        if reaction and not reaction.is_file():
            matches = list(odir.glob(prefix + "*reaction*.png")) + list(odir.glob(prefix + "*reactions*.png"))
            reaction = matches[0] if matches else reaction
        lines += [r"\clearpage", r"\section*{" + latex_escape(c["id"]) + r"}", latex_escape(c["description"]), r"\begin{figure}[H]", r"\centering", schematic(c), r"\caption{Schematic for " + latex_escape(c["id"]) + r".}", r"\end{figure}", r"\textbf{Code features exercised.}", r"\begin{itemize}"]
        for feat in c.get("features", []):
            lines.append(r"\item " + latex_escape(feat))
        lines += [r"\end{itemize}", r"\begin{figure}[H]", r"\centering"]
        if reaction:
            lines.append(include_graphics(initial, rdir, "0.31\\textwidth") + "\n" + include_graphics(final, rdir, "0.31\\textwidth") + "\n" + include_graphics(reaction, rdir, "0.31\\textwidth"))
            lines.append(r"\caption{Initial state, final state, and reaction history for " + latex_escape(c["id"]) + r".}")
        else:
            lines.append(include_graphics(initial, rdir, "0.45\\textwidth") + "\n" + include_graphics(final, rdir, "0.45\\textwidth"))
            lines.append(r"\caption{Initial and final state for " + latex_escape(c["id"]) + r".}")
        lines += [r"\end{figure}"]
    lines.append(r"\end{document}")
    tex = rdir / "examples_suite_report.tex"
    tex.write_text("\n".join(lines) + "\n")
    print("wrote " + str(tex))
    pdflatex = shutil.which("pdflatex")
    if pdflatex:
        for _ in range(2):
            proc = subprocess.run([pdflatex, "-interaction=nonstopmode", "-halt-on-error", tex.name], cwd=rdir, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
            (rdir / "pdflatex.log").write_text(proc.stdout)
            if proc.returncode != 0:
                print(proc.stdout[-4000:])
                raise SystemExit("pdflatex failed; see " + str(rdir / "pdflatex.log"))
        print("wrote " + str(rdir / "examples_suite_report.pdf"))
    else:
        print("pdflatex not found; generated LaTeX only")


def main():
    args = parse_args()
    root = Path(__file__).resolve().parent
    jobs = []
    timing = None
    if args.command in ("run", "all"):
        jobs = dispatch(root, args)
        if not args.no_wait:
            wait_jobs(jobs)
            timing = query_timing(root, args, jobs)
    if args.command in ("report", "all"):
        if timing is None:
            jobs = load_jobs(root, args)
            timing = query_timing(root, args, jobs)
        generate_report(root, args, timing)


if __name__ == "__main__":
    main()
