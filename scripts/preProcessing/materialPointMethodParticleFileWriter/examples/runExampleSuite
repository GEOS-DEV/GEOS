        r"./runExampleSuite all --case borehole_Ghareb --python /usr/tce/bin/python3 --force",
        r"./runExampleSuite report --python /usr/tce/bin/python3",
        r"\end{verbatim}",
        r"If output exists, \texttt{runProblem} prompts before overwriting. Use \texttt{--force} for noninteractive reruns. The suite records case-level failures, continues with remaining cases by default, and reports incomplete or interrupted Slurm jobs explicitly.",
        r"\section*{Timing and completion summary}",
        timing_table(root, timing, cases),
    ]
    fs = failure_summary(root, cases, timing)
    if fs:
        lines += [r"\section*{Incomplete, failed, or missing-output cases}"] + fs
    for c in cases:
        odir = output_dir(root, c)
        prefix = c["prefix"]
        initial = find_image(root, c, c.get("initial", ""))
        final = find_image(root, c, c.get("final", ""))
        reaction = find_reaction(root, c) if c.get("reaction") else None
        status = case_status(root, c, timing)
        lines += [r"\clearpage", r"\section*{" + latex_escape(c["id"]) + r"}", latex_escape(c["description"]), r"\textbf{Status:} " + latex_escape(status)]
        schematic_path = schematics.get(c["id"])
        lines += [r"\begin{figure}[H]", r"\centering"]
        if schematic_path and schematic_path.is_file():
            lines.append(include_graphics(schematic_path, rdir, "0.58\\textwidth", "schematic unavailable"))
        else:
            lines.append(r"\fbox{\begin{minipage}[c][0.20\textheight][c]{0.58\textwidth}\centering schematic unavailable\end{minipage}}")
        lines += [r"\caption{Schematic for " + latex_escape(c["id"]) + r".}", r"\end{figure}", r"\textbf{Code features exercised.}", r"\begin{itemize}"]
        for feat in c.get("features", []):
            lines.append(r"\item " + latex_escape(feat))
        lines += [r"\end{itemize}", r"\begin{figure}[H]", r"\centering"]
        missing = []
        if not initial: missing.append("initial image")
        if not final: missing.append("final image")
        if c.get("reaction") and not reaction: missing.append("reaction plot")
        if c.get("reaction"):
            lines.append(include_graphics(initial, rdir, "0.31\\textwidth", "initial image unavailable") + "\n" + include_graphics(final, rdir, "0.31\\textwidth", "final image unavailable") + "\n" + include_graphics(reaction, rdir, "0.31\\textwidth", "reaction plot unavailable"))
            cap = "Initial state, final state, and reaction history for " + c["id"]
        else:
            lines.append(include_graphics(initial, rdir, "0.45\\textwidth", "initial image unavailable") + "\n" + include_graphics(final, rdir, "0.45\\textwidth", "final image unavailable"))
            cap = "Initial and final state for " + c["id"]
        lines.append(r"\caption{" + latex_escape(cap) + r".}")
        lines += [r"\end{figure}"]
        if missing:
            lines.append(r"\textbf{Missing expected products:} " + latex_escape(", ".join(missing)) + ".")
            excerpt = important_log_excerpt(root, c, max_lines=12)
            if excerpt:
                lines.append(r"\begin{verbatim}")
                lines.extend(excerpt[-12:])
                lines.append(r"\end{verbatim}")
        elif pngs_for_case(root, c):
            names = ", ".join(p.name for p in pngs_for_case(root, c)[:6])
            lines.append(r"\textbf{Output figures:} " + latex_escape(names))
    lines.append(r"\end{document}")
    tex = rdir / "examples_suite_report.tex"
    tex.write_text("\n".join(lines) + "\n")
    print("wrote " + str(tex))
    pdflatex = shutil.which("pdflatex")
    if pdflatex:
        for _ in range(2):
            proc = subprocess.run([pdflatex, "-interaction=nonstopmode", "-halt-on-error", tex.name], cwd=rdir, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
            (rdir / "pdflatex.log").write_text(proc.stdout)
            if proc.returncode != 0:
                print(proc.stdout[-4000:])
                raise SystemExit("pdflatex failed; see " + str(rdir / "pdflatex.log"))
        print("wrote " + str(rdir / "examples_suite_report.pdf"))
    else:
        print("pdflatex not found; generated LaTeX only")



def print_postprocess_recovery_hint(root, cases):
    missing = []
    for c in cases:
        odir = output_dir(root, c)
        if not odir.is_dir():
            missing.append(c["id"])
            continue
        pngs = list(odir.glob(c["prefix"] + "*.png"))
        if not pngs:
            missing.append(c["id"])
    if missing:
        print("\nCases still missing copied PNG products: " + ", ".join(missing))
        print("If their GEOS jobs completed before this updater, rerun those cases with --force, or rerun their post-processing jobs after the fixed staging is in place.")

def main():
    args = parse_args()
    root = Path(__file__).resolve().parent
    jobs = []
    timing = None
    if args.command in ("run", "all"):
        jobs = dispatch(root, args)
        if not args.no_wait:
            wait_jobs(jobs, timeout=args.wait_timeout)
            # Reload jobs because wrappers may have written richer jobs json.
            merged = load_jobs(root, args)
            if merged:
                by_case = {j.get("case"): j for j in jobs}
                for j in merged:
                    by_case.setdefault(j.get("case"), {}).update({k:v for k,v in j.items() if v})
                jobs = list(by_case.values())
            timing = query_timing(root, args, jobs)
        else:
            timing = query_timing(root, args, jobs)
    if args.command in ("report", "all"):
        if timing is None:
            jobs = load_jobs(root, args)
            timing = query_timing(root, args, jobs)
        generate_report(root, args, timing)


if __name__ == "__main__":
    main()
