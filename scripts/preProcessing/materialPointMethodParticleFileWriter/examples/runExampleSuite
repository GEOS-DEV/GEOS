CASE_BY_ID = {c["id"]: c for c in EXAMPLES}
CASE_BY_ID["benchy_FMPM"] = CASE_BY_ID.get("benchy", {})

SACCT_FORMATS = [
    ["JobIDRaw", "JobID", "JobName%40", "State", "ExitCode", "Elapsed", "ElapsedRaw", "TotalCPU", "CPUTimeRAW", "AllocCPUS", "NNodes", "Account", "Partition"],
    ["JobID", "JobName%40", "State", "ExitCode", "Elapsed", "ElapsedRaw", "TotalCPU", "CPUTimeRAW", "AllocCPUS", "NNodes"],
]


def parse_args():
    p = argparse.ArgumentParser(description="Dispatch GEOS-MPM examples and build a PDF report")
    p.add_argument("command", nargs="?", default="all", choices=("run", "report", "all"))
    p.add_argument("--python", dest="python_cmd", default=os.environ.get("PFW_PYTHON", "/usr/tce/bin/python3"))
    p.add_argument("--case", action="append", choices=sorted(CASE_BY_ID), help="Run/report one selected case; may be repeated")
    p.add_argument("--force", "-y", action="store_true")
    p.add_argument("--no-wait", action="store_true")
    p.add_argument("--no-visit", action="store_true")
    p.add_argument("--post-walltime", default="00:05:00")
    p.add_argument("--post-partition", default="pdebug")
    p.add_argument("--report-dir", default="examples_suite_report")
    p.add_argument("--timing-retries", type=int, default=5)
    p.add_argument("--timing-sleep", type=float, default=6.0)
    return p.parse_args()


def selected(args):
    if args.case:
        return [CASE_BY_ID[c] for c in args.case]
    return [c for c in EXAMPLES if (Path(__file__).resolve().parent / c["dir"]).is_dir()]


def run_cmd(cmd, cwd):
    print("+ " + " ".join(str(c) for c in cmd))
    proc = subprocess.run(cmd, cwd=cwd, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    print(proc.stdout, end="")
    return proc.returncode, proc.stdout


def output_dir(root, case):
    return root / case["dir"] / "output"


def dispatch(root, args):
    jobs = []
    for case in selected(args):
        cdir = root / case["dir"]
        if not (cdir / "runProblem").exists():
            print(f"WARNING: skipping {case['id']}; no runProblem in {cdir}")
            continue
        cmd = ["./runProblem", "--python", args.python_cmd, "--post-walltime", args.post_walltime, "--post-partition", args.post_partition]
        cmd += case.get("args", [])
        if args.force:
            cmd.append("--force")
        if args.no_visit:
            cmd.append("--no-visit")
        code, out = run_cmd(cmd, cdir)
        if code != 0:
            raise SystemExit(f"{case['id']} failed with {code}")
        geos = re.findall(r"GEOS job id:\s*([0-9]+)", out)
        post = re.findall(r"post-process job id:\s*([0-9]+)", out)
        rec = {"case": case["id"], "geos": geos[-1] if geos else "", "post": post[-1] if post else ""}
        jobs.append(rec)
        odir = output_dir(root, case)
        odir.mkdir(parents=True, exist_ok=True)
        (odir / f"{case['prefix']}_jobs.json").write_text(json.dumps({"case": case["id"], "jobs": rec}, indent=2) + "\n")
    rdir = root / args.report_dir
    rdir.mkdir(exist_ok=True)
    (rdir / "examples_suite_jobs.json").write_text(json.dumps({"generated_at": datetime.now().isoformat(timespec="seconds"), "cases": jobs}, indent=2) + "\n")
    return jobs


def wait_jobs(jobs):
    ids = [j.get("post", "") for j in jobs if j.get("post")]
    if not ids or shutil.which("squeue") is None:
        return
    joined = ",".join(ids)
    print("Waiting for postprocess jobs: " + joined)
    while True:
        proc = subprocess.run(["squeue", "-h", "-j", joined], text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        if proc.returncode != 0 or not proc.stdout.strip():
            break
        print("still queued/running: " + " ".join(line.split()[0] for line in proc.stdout.splitlines() if line.strip()))
        time.sleep(30)


def read_json(path, default):
    try:
        return json.loads(path.read_text())
    except Exception:
        return default


def load_jobs(root, args):
    data = read_json(root / args.report_dir / "examples_suite_jobs.json", {})
    records = data.get("cases", []) if isinstance(data, dict) else []
    by_case = {r.get("case"): r for r in records if isinstance(r, dict)}
    for case in selected(args):
        j = read_json(output_dir(root, case) / f"{case['prefix']}_jobs.json", {})
        if isinstance(j, dict) and j.get("jobs"):
            rec = j["jobs"]
            by_case.setdefault(case["id"], {"case": case["id"], "geos": rec.get("geos", ""), "post": rec.get("post", "")})
    return [by_case[c["id"]] for c in selected(args) if c["id"] in by_case]


def sacct_rows(job_ids):
    if not job_ids or shutil.which("sacct") is None:
        return {}, "sacct unavailable or no job ids"
    joined = ",".join(job_ids)
    for fields in SACCT_FORMATS:
        proc = subprocess.run(["sacct", "-j", joined, "-X", "-n", "-P", "-o", ",".join(fields)], text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        if proc.returncode != 0:
            continue
        clean = [f.split("%", 1)[0] for f in fields]
        rows = {}
        for line in proc.stdout.splitlines():
            parts = line.split("|")
            row = dict(zip(clean, parts + [""] * (len(clean)-len(parts))))
            jid = (row.get("JobIDRaw") or row.get("JobID") or "").split(".",1)[0].split("_",1)[0]
            if jid in job_ids and jid not in rows:
                rows[jid] = row
        if rows:
            return rows, ""
    return {}, "sacct returned no rows"


def query_timing(root, args, jobs):
    ids = []
    for j in jobs:
        for key in ("geos", "post"):
            jid = str(j.get(key, ""))
            if jid and jid not in ids:
                ids.append(jid)
    rows, note = {}, ""
    for attempt in range(max(1, args.timing_retries)):
        rows, note = sacct_rows(ids)
        if rows or attempt == args.timing_retries - 1:
            break
        time.sleep(args.timing_sleep)
    payload = {"generated_at": datetime.now().isoformat(timespec="seconds"), "note": note, "jobs": jobs, "sacct_by_job_id": rows, "cases": {}}
    for rec in jobs:
        payload["cases"][rec["case"]] = {"jobs": {"geos": rec.get("geos", ""), "post": rec.get("post", "")}, "timing": {"geos": rows.get(rec.get("geos", ""), {}), "post": rows.get(rec.get("post", ""), {})}}
    rdir = root / args.report_dir
    rdir.mkdir(exist_ok=True)
    (rdir / "examples_suite_timing.json").write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
    with (rdir / "examples_suite_timing.csv").open("w", newline="") as f:
        writer = csv.writer(f)
        writer.writerow(["case", "phase", "job_id", "state", "exit", "elapsed", "total_cpu", "cpu_time_raw", "alloc_cpus"])
        for case_id, rec in payload["cases"].items():
            for phase in ("geos", "post"):
                row = rec["timing"].get(phase, {})
                writer.writerow([case_id, phase, rec["jobs"].get(phase, ""), row.get("State", ""), row.get("ExitCode", ""), row.get("Elapsed", ""), row.get("TotalCPU", ""), row.get("CPUTimeRAW", ""), row.get("AllocCPUS", "")])
    return payload


def latex_escape(s):
    return str(s).replace("\\", r"\textbackslash{} ").replace("&", r"\&").replace("%", r"\%").replace("$", r"\$").replace("#", r"\#").replace("_", r"\_").replace("{", r"\{").replace("}", r"\}").replace("~", r"\textasciitilde{}")


def include_graphics(path, report_dir, width="0.31\\textwidth"):
    path = Path(path)
    if path.is_file():
        rel = os.path.relpath(path, report_dir)
        return r"\includegraphics[width=" + width + "]{" + rel.replace("\\", "/") + "}"
    return r"\fbox{\begin{minipage}[c][0.22\textheight][c]{" + width + r"}\centering missing\\" + latex_escape(path.name) + r"\end{minipage}}"


def find_prefixed_png(odir: Path, prefix: str, token: str):
    exact = odir / token
    if exact.is_file():
        return exact
    matches = sorted(odir.glob(prefix + "*" + token + "*.png")) if not token.endswith(".png") else []
    if not matches:
        low = token.lower().replace(".png", "")
        matches = [p for p in sorted(odir.glob(prefix + "*.png")) if low in p.name.lower()]
    return matches[0] if matches else odir / (prefix + "_" + token)


