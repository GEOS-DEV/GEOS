    return r"\setlength{\unitlength}{0.0045\textwidth}\begin{picture}(120,82)\put(12,12){\framebox(96,58){background grid}}\put(22,40){\vector(1,0){32}}\put(60,41){particles}\end{picture}"


def timing_case(timing, case_id):
    return timing.get("cases", {}).get(case_id, {}) if isinstance(timing, dict) else {}


def timing_cell(timing, case_id, phase, key):
    return timing_case(timing, case_id).get("timing", {}).get(phase, {}).get(key, "")


def job_id(timing, case_id, phase):
    return timing_case(timing, case_id).get("jobs", {}).get(phase, "")


def case_status(timing, case_id):
    return timing_case(timing, case_id).get("status", "not_run")


def timing_table(timing, cases):
    lines = [r"\begin{table}[H]", r"\centering", r"\scriptsize", r"\begin{tabular}{lllrrrrrr}", r"\toprule", r"Example & Status & Family & GEOS job & GEOS state & GEOS wall & GEOS CPU & Post wall & Post CPU \\", r"\midrule"]
    for c in cases:
        cid = c["id"]
        values = [cid, case_status(timing,cid), c["family"], job_id(timing,cid,"geos"), timing_cell(timing,cid,"geos","State"), timing_cell(timing,cid,"geos","Elapsed"), timing_cell(timing,cid,"geos","TotalCPU") or timing_cell(timing,cid,"geos","CPUTimeRAW"), timing_cell(timing,cid,"post","Elapsed"), timing_cell(timing,cid,"post","TotalCPU") or timing_cell(timing,cid,"post","CPUTimeRAW")]
        lines.append(" & ".join(latex_escape(x) for x in values) + r" \\")
    lines += [r"\bottomrule", r"\end{tabular}", r"\end{table}"]
    return "\n".join(lines)


def important_log_excerpt(text, max_lines=60):
    if not text:
        return ""
    lines = text.splitlines()
    important = []
    patterns = ("ERROR", "Error", "error", "EXCEPTION", "Traceback", "failed", "Unknown case", "XML parsing", "AttributeError", "NameError")
    for i, line in enumerate(lines):
        if any(p in line for p in patterns):
            start = max(0, i - 4)
            end = min(len(lines), i + 10)
            important.extend(lines[start:end])
            important.append("...")
    if not important:
        important = lines[-max_lines:]
    # Deduplicate while preserving order and cap length.
    out = []
    last = None
    for line in important:
        if line == last:
            continue
        out.append(line)
        last = line
    if len(out) > max_lines:
        out = out[:max_lines//2] + ["..."] + out[-max_lines//2:]
    return "\n".join(out)


def log_excerpt_for_case(root, case, timing):
    rec = timing_case(timing, case["id"])
    rel = rec.get("log_file", "")
    candidates = []
    if rel:
        candidates.append(root / rel)
    candidates.append(output_dir(root, case) / f"{case['prefix']}_runProblem.log")
    for path in candidates:
        if path.is_file():
            return important_log_excerpt(path.read_text(errors="replace"))
    err = rec.get("error", "")
    return err


def add_failure_summary(lines, root, cases, timing):
    failed = [c for c in cases if case_status(timing, c["id"]) not in ("", "submitted", "not_run")]
    if not failed:
        return
    lines += [r"\section*{Dispatch failures}", r"The suite continued after the following case-level failures.  The log excerpts below are copied from the per-case \texttt{output/*runProblem.log} files."]
    for c in failed:
        lines += [r"\subsection*{" + latex_escape(c["id"]) + r"}"]
        err = timing_case(timing, c["id"]).get("error", "")
        if err:
            lines.append(r"\textbf{Error:} " + latex_escape(err))
        excerpt = log_excerpt_for_case(root, c, timing)
        if excerpt:
            lines += [r"\begin{verbatim}", excerpt, r"\end{verbatim}"]


def generate_report(root, args, timing):
    rdir = root / args.report_dir
    rdir.mkdir(exist_ok=True)
    cases = selected(args)
    lines = [
        r"\documentclass[11pt]{article}",
        r"\usepackage[margin=0.75in]{geometry}",
        r"\usepackage{graphicx}",
        r"\usepackage{float}",
        r"\usepackage{booktabs}",
        r"\usepackage{rotating}",
        r"\usepackage{longtable}",
        r"\setlength{\parindent}{0pt}",
        r"\setlength{\parskip}{0.5em}",
        r"\begin{document}",
        r"\title{GEOS-MPM Examples Suite Report}",
        r"\author{Generated by examples/runExampleSuite}",
        r"\date{\today}",
        r"\maketitle",
        r"\section*{Running and rerunning}",
        r"Each example directory contains a copyable \texttt{pfw\_input\_*.py} and a \texttt{runProblem} wrapper.  The wrapper stages an isolated case directory under \texttt{testRunDirectory}, copies the needed PFW files, runs the particle-file writer, submits GEOS, submits dependent post-processing, and copies figures/logs back to the example \texttt{output/} directory.",
        r"\begin{verbatim}",
        r"cd scripts/preProcessing/materialPointMethodParticleFileWriter/examples",
        r"./runExampleSuite all --python /usr/tce/bin/python3 --force",
        r"./runExampleSuite all --case borehole_Ghareb --python /usr/tce/bin/python3 --force",
        r"./runExampleSuite report --python /usr/tce/bin/python3",
        r"\end{verbatim}",
        r"If output exists, \texttt{runProblem} prompts before overwriting. Use \texttt{--force} for noninteractive reruns.  The suite records case-level failures and continues with the remaining cases unless \texttt{--stop-on-error} is supplied.",
        r"\section*{Timing and dispatch summary}",
        timing_table(timing, cases),
    ]
    add_failure_summary(lines, root, cases, timing)
    for c in cases:
        odir = output_dir(root, c)
        prefix = c["prefix"]
        if c.get("initial", "").endswith("_"):
            initial = find_prefixed_png(odir, prefix, "initial")
            final = find_prefixed_png(odir, prefix, "final")
        else:
            initial = odir / c.get("initial", "")
            final = odir / c.get("final", "")
        reaction = odir / c.get("reaction", "") if c.get("reaction") else None
        if reaction and not reaction.is_file():
            matches = list(odir.glob(prefix + "*reaction*.png")) + list(odir.glob(prefix + "*reactions*.png"))
            reaction = matches[0] if matches else reaction
        lines += [r"\clearpage", r"\section*{" + latex_escape(c["id"]) + r"}"]
        status = case_status(timing, c["id"])
        if status not in ("", "submitted", "not_run"):
            lines.append(r"\textbf{Dispatch status:} " + latex_escape(status))
            err = timing_case(timing, c["id"]).get("error", "")
            if err:
                lines.append(r"\textbf{Error:} " + latex_escape(err))
        lines += [latex_escape(c.get("description", "")), r"\begin{figure}[H]", r"\centering", schematic(c), r"\caption{Schematic for " + latex_escape(c["id"]) + r".}", r"\end{figure}", r"\textbf{Code features exercised.}", r"\begin{itemize}"]
        for feat in c.get("features", []):
            lines.append(r"\item " + latex_escape(feat))
        lines += [r"\end{itemize}", r"\begin{figure}[H]", r"\centering"]
        if reaction:
            lines.append(include_graphics(initial, rdir, "0.31\\textwidth") + "\n" + include_graphics(final, rdir, "0.31\\textwidth") + "\n" + include_graphics(reaction, rdir, "0.31\\textwidth"))
            lines.append(r"\caption{Initial state, final state, and reaction history for " + latex_escape(c["id"]) + r".}")
        else:
            lines.append(include_graphics(initial, rdir, "0.45\\textwidth") + "\n" + include_graphics(final, rdir, "0.45\\textwidth"))
            lines.append(r"\caption{Initial and final state for " + latex_escape(c["id"]) + r".}")
        lines += [r"\end{figure}"]
        if status not in ("", "submitted", "not_run"):
            excerpt = log_excerpt_for_case(root, c, timing)
            if excerpt:
                lines += [r"\subsection*{Failure log excerpt}", r"\begin{verbatim}", excerpt, r"\end{verbatim}"]
    lines.append(r"\end{document}")
    tex = rdir / "examples_suite_report.tex"
    tex.write_text("\n".join(lines) + "\n")
    print("wrote " + str(tex))
    pdflatex = shutil.which("pdflatex")
    if pdflatex:
        for _ in range(2):
            proc = subprocess.run([pdflatex, "-interaction=nonstopmode", "-halt-on-error", tex.name], cwd=rdir, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
            (rdir / "pdflatex.log").write_text(proc.stdout)
            if proc.returncode != 0:
                print(proc.stdout[-4000:])
                print("WARNING: pdflatex failed; LaTeX report was still written to " + str(tex))
                return
        print("wrote " + str(rdir / "examples_suite_report.pdf"))
    else:
        print("pdflatex not found; generated LaTeX only")


def main():
    args = parse_args()
    root = Path(__file__).resolve().parent
    confirm_suite_rerun(args)
    jobs = []
    timing = None
    if args.command in ("run", "all"):
        jobs = dispatch(root, args)
        if not args.no_wait:
            wait_jobs(jobs)
            timing = query_timing(root, args, jobs)
    if args.command in ("report", "all"):
        if timing is None:
            jobs = load_jobs(root, args)
            timing = query_timing(root, args, jobs)
        generate_report(root, args, timing)


if __name__ == "__main__":
    main()
