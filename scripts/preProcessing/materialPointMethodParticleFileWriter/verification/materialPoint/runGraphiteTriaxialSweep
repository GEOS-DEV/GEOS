#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
PYTHON_CMD=${PFW_PYTHON:-${PYTHON:-python3}}

if [ -n "${GEOS_MPM_MATERIAL_POINT_DRIVER:-}" ]; then
  exec "$PYTHON_CMD" "$SCRIPT_DIR/pfw_input_graphite_triaxial_sweep_material_point.py" \
    --driver "$GEOS_MPM_MATERIAL_POINT_DRIVER" \
    "$@"
fi

exec "$PYTHON_CMD" "$SCRIPT_DIR/pfw_input_graphite_triaxial_sweep_material_point.py" \
  "$@"
