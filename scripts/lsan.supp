# External MPI-runtime initialization allocations retained until process exit.
# These are the same OpenMPI/Caliper startup cases covered by LvArray's
# valgrind.supp. Do not suppress GEOS, Hypre, or other application frames.
leak:ompi_
leak:orte_
leak:hwloc_
leak:event_base_loop
leak:MPI_Init
leak:caliper

# MPICH 4.2.x retains small communicator-collective selection allocations
# until process exit. Keep these suppressions at the MPICH allocation
# boundary; do not suppress generic communicator or GEOS frames.
leak:MPIR_Csel_prune
leak:MPIR_Find_local
leak:MPIR_Find_external

# HDF5 1.14.6's parallel MPIO driver leaves tiny MPI-IO request bookkeeping
# allocations behind after collective writes. Keep the suppression at the
# HDF5 driver boundary; do not suppress generic MPI or GEOS allocations.
leak:H5FD__mpio_write_vector
leak:H5FD__mpio_write_selection

# ROCm 7.x HSA initialization retains a small device-discovery allocation
# until process exit.  Scope this to the HSA runtime module; do not suppress
# allocations in HIP, GEOS, or application code.
leak:libhsa-runtime64.so
