    --build-target)
      [ "$#" -ge 2 ] || fail "$1 requires a value"
      BUILD_TARGET="$2"
      shift 2
      ;;
    --log-file)
      [ "$#" -ge 2 ] || fail "$1 requires a value"
      LOG_FILE="$2"
      shift 2
      ;;
    --no-log)
      NO_LOG=1
      shift
      ;;
    --skip-modules)
      LOAD_MODULES=0
      shift
      ;;
    --module-purge)
      MODULE_PURGE=1
      shift
      ;;
    --force)
      FORCE_LINK=1
      OVERWRITE_USERDEFS=1
      OVERWRITE_RUNCLEAN=1
      shift
      ;;
    --force-link)
      FORCE_LINK=1
      shift
      ;;
    --overwrite-userdefs)
      OVERWRITE_USERDEFS=1
      shift
      ;;
    --overwrite-runclean)
      OVERWRITE_RUNCLEAN=1
      shift
      ;;
    --skip-build|--no-build)
      SKIP_BUILD=1
      shift
      ;;
    --configure-only)
      CONFIGURE_ONLY=1
      shift
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      fail "Unknown option: $1"
      ;;
  esac
done

