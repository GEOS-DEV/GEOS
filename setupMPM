write_runclean() {
  if [ -e "$RUNCLEAN_PATH" ] && [ "$OVERWRITE_RUNCLEAN" -ne 1 ]; then
    log "leaving existing $RUNCLEAN_PATH unchanged; use --overwrite-runclean to replace it"
    return 0
  fi

  local slurm_account_line flux_account_line
  if [ -n "$DEFAULT_BANK" ]; then
    slurm_account_line="#SBATCH -A $DEFAULT_BANK"
    flux_account_line="#flux: -B $DEFAULT_BANK"
  else
    slurm_account_line="#SBATCH -A CHANGE_ME"
    flux_account_line="#flux: -B CHANGE_ME"
  fi

  if [ "$DRY_RUN" -eq 1 ]; then
    log "would write $RUNCLEAN_PATH"
    return 0
  fi

  cat > "$RUNCLEAN_PATH" <<EOF_RUNCLEAN
#!/bin/bash
#SBATCH -J mpm-pfw-clean
#SBATCH -t $SLURM_TIME
#SBATCH -N 1
@@SLURM_ACCOUNT_LINE@@
#SBATCH -p $DANE_PARTITION
#flux: --job-name=mpm-pfw-clean
#flux: -N 1
#flux: -t $FLUX_TIME
@@FLUX_ACCOUNT_LINE@@
#flux: -q $DEFAULT_QUEUE
#flux: -l

set -euo pipefail

hostName="@@DOLLAR@@(hostname -s 2>/dev/null || hostname)"
hostLower="@@DOLLAR@@(printf '%s' "@@DOLLAR@@hostName" | tr '[:upper:]' '[:lower:]')"
case "@@DOLLAR@@{GEOS_MPM_MACHINE:-}" in
  dane|DANE)
    mpmMachine="dane"
    ;;
  tuolumne|TUOLUMNE)
    mpmMachine="tuolumne"
    ;;
  "")
    case "@@DOLLAR@@hostLower" in
      *dane*)
        mpmMachine="dane"
        ;;
      tuolumne*|*tuolumne*|tuo*)
        mpmMachine="tuolumne"
        ;;
      *)
        echo "ERROR: Could not identify Dane or Tuolumne from host '@@DOLLAR@@hostName'." >&2
        echo "       Set GEOS_MPM_MACHINE=dane or GEOS_MPM_MACHINE=tuolumne." >&2
        exit 1
        ;;
    esac
    ;;
  *)
    echo "ERROR: unsupported GEOS_MPM_MACHINE='@@DOLLAR@@{GEOS_MPM_MACHINE}'." >&2
    exit 1
    ;;
esac

case "@@DOLLAR@@mpmMachine" in
  dane)
    scheduler="slurm"
    defaultRunLocation="$DANE_TEST_RUN_DIR"
    defaultPython="$PYTHON_CMD"
    unset MPICH_GPU_SUPPORT_ENABLED || true
    unset HSA_XNACK || true
    export OMP_NUM_THREADS="@@DOLLAR@@{OMP_NUM_THREADS:-1}"
    ;;
  tuolumne)
    scheduler="flux"
    defaultRunLocation="$TUOLUMNE_TEST_RUN_DIR"
    defaultPython="$PYTHON_CMD"
    export MPICH_GPU_SUPPORT_ENABLED="@@DOLLAR@@{MPICH_GPU_SUPPORT_ENABLED:-1}"
    export HSA_XNACK="@@DOLLAR@@{HSA_XNACK:-1}"
    export OMP_NUM_THREADS="@@DOLLAR@@{OMP_NUM_THREADS:-1}"
    ;;
esac
export GEOS_MPM_MACHINE="@@DOLLAR@@mpmMachine"

# Set fileNames to the suffixes of input files named pfw_input_<name>.py.
# The default is a current smoke-test example; edit this list for local batches.
fileNames=(
  brazilianDisk
)

# Defaults generated by setupMPM. Override these at launch with
# FILE_LOCATION=..., RUN_LOCATION=..., PFW_PATH=..., PFW_PYTHON=..., or PFW_PYTHON_COMMAND=...
particleFileWriterPath="@@DOLLAR@@{PFW_PATH:-$PFW_USER_PATH}"
fileLocation="@@DOLLAR@@{FILE_LOCATION:-@@DOLLAR@@particleFileWriterPath/examples/brazilianDisk}"
runLocation="@@DOLLAR@@{RUN_LOCATION:-@@DOLLAR@@defaultRunLocation}"
pythonCommand="@@DOLLAR@@{PFW_PYTHON:-@@DOLLAR@@{PFW_PYTHON_COMMAND:-@@DOLLAR@@defaultPython}}"
userName="@@DOLLAR@@(whoami)"

echo "runClean machine: @@DOLLAR@@mpmMachine"
echo "runClean scheduler: @@DOLLAR@@scheduler"
echo "runClean run location: @@DOLLAR@@runLocation"

for fileName in "@@DOLLAR@@{fileNames[@]}"
do
  if [ -z "@@DOLLAR@@fileName" ] || [[ "@@DOLLAR@@fileName" == \<*\> ]]; then
    continue
  fi

  if [ "@@DOLLAR@@#" -eq 0 ] || [ "@@DOLLAR@@1" -eq 1 ]; then
    num_tasks="1"
  else
    num_tasks="@@DOLLAR@@1"
  fi

  if [ "@@DOLLAR@@scheduler" = "flux" ] && [ "@@DOLLAR@@num_tasks" -ne 1 ]; then
    echo "PFW MPI is not supported under Flux currently; running particleFileWriter.py serially for @@DOLLAR@@fileName."
    num_tasks="1"
  fi

  echo "Running PFW on @@DOLLAR@@num_tasks process(es): @@DOLLAR@@fileName"

  if [ -d "@@DOLLAR@@runLocation/@@DOLLAR@@fileName" ] && [ -z "@@DOLLAR@@{SLURM_JOBID:-}" ] && [ -z "@@DOLLAR@@{FLUX_JOB_ID:-}" ]; then
    echo "Removing existing run directory @@DOLLAR@@runLocation/@@DOLLAR@@fileName"
  fi
  rm -rf "@@DOLLAR@@runLocation/@@DOLLAR@@fileName"
  mkdir -p "@@DOLLAR@@runLocation/@@DOLLAR@@fileName"

  cp "@@DOLLAR@@fileLocation/pfw_input_@@DOLLAR@@fileName.py" "@@DOLLAR@@runLocation/@@DOLLAR@@fileName/"
  for pfwFile in particleFileWriter.py pfw_check.py pfw_geometryObjects.py pfw_materials.py pfw_analysis.py pfw_visit_render.py; do
    if [ -f "@@DOLLAR@@particleFileWriterPath/@@DOLLAR@@pfwFile" ]; then
      cp "@@DOLLAR@@particleFileWriterPath/@@DOLLAR@@pfwFile" "@@DOLLAR@@runLocation/@@DOLLAR@@fileName/"
    fi
  done
  cp "@@DOLLAR@@particleFileWriterPath/userDefs_@@DOLLAR@@userName.py" "@@DOLLAR@@runLocation/@@DOLLAR@@fileName/"

  cd "@@DOLLAR@@runLocation/@@DOLLAR@@fileName"
  if [ "@@DOLLAR@@scheduler" = "slurm" ] && [ "@@DOLLAR@@num_tasks" -ne 1 ]; then
    srun -n "@@DOLLAR@@num_tasks" "@@DOLLAR@@pythonCommand" particleFileWriter.py "pfw_input_@@DOLLAR@@fileName"
  else
    "@@DOLLAR@@pythonCommand" particleFileWriter.py "pfw_input_@@DOLLAR@@fileName"
  fi
  echo
done
EOF_RUNCLEAN

  # Replace placeholders. This keeps the generated script readable while allowing
  # setup-time variables above to expand where desired.
  "$PYTHON_CMD" - "$RUNCLEAN_PATH" "$slurm_account_line" "$flux_account_line" <<'PY'
from pathlib import Path
import sys
p = Path(sys.argv[1])
text = p.read_text()
text = text.replace('@@DOLLAR@@', '$')
text = text.replace('@@SLURM_ACCOUNT_LINE@@', sys.argv[2])
text = text.replace('@@FLUX_ACCOUNT_LINE@@', sys.argv[3])
p.write_text(text)
PY
  chmod 755 "$RUNCLEAN_PATH"
  log "wrote $RUNCLEAN_PATH"
}

load_module_any() {
  local label="$1"
  shift

  local module_name
  for module_name in "$@"; do
    if run_cmd module load "$module_name"; then
      log "loaded $label module: $module_name"
      return 0
    fi
  done

  log "could not load $label module from candidates: $*; continuing with current environment"
  return 0
}

prepare_module_command() {
  if [ "$LOAD_MODULES" -ne 1 ]; then
    return 1
  fi

  if ! command -v module >/dev/null 2>&1; then
    log "module command not found; continuing with current environment"
    return 1
  fi

  if [ "$MODULE_PURGE" -eq 1 ]; then
    log "purging modules"
    run_cmd module purge
  fi

  return 0
}

load_dane_modules() {
  prepare_module_command || return 0

  log "loading Dane build modules if available"
  load_module_any "Dane GCC" gcc/12.1.1-magic gcc/12.1.1
  load_module_any "Dane MVAPICH2" mvapich2/2.3.7-gcc-12.1.1-magic mvapich2/2.3.7
  load_module_any "CMake" cmake/3.26.3 cmake/3.29.2
  load_module_any "Ninja" ninja/1.10.2 ninja
}

load_tuolumne_modules() {
  prepare_module_command || return 0

  log "loading Tuolumne build modules if available"
  load_module_any "Tuolumne ROCm" rocm/6.4.2
  load_module_any "CMake" cmake/3.29.2 cmake/3.26.3
  load_module_any "Ninja" ninja/1.10.2 ninja
}
create_minimal_tpl_view() {
  if [ "$CREATE_TPL_VIEW" -ne 1 ]; then
    return 0
  fi

  if [ -z "$TPL_DIR" ]; then
    TPL_DIR="$DEFAULT_TPL_DIR"
  fi

  local upper_helper lower_helper
  upper_helper="$REPO_ROOT_PHYSICAL/scripts/LLNL/create_geos_mpm_tuolumne_minimal_tpl_view.sh"
  lower_helper="$REPO_ROOT_PHYSICAL/scripts/llnl/build_tuolumne_mpm_minimal_tpls.sh"

  run_cmd mkdir -p "$(dirname "$TPL_DIR")"
  if [ -x "$upper_helper" ]; then
    log "creating minimal TPL view at $TPL_DIR"
    run_cmd "$upper_helper" --prefix "$TPL_DIR"
  elif [ -x "$lower_helper" ]; then
    log "building minimal TPL install at $TPL_DIR"
    run_cmd "$lower_helper" --tpl-root "$TPL_DIR" -j "$JOBS"
  else
    fail "--create-tpl-view was requested, but no Tuolumne minimal TPL helper script was found. Expected $upper_helper or $lower_helper."
  fi
}

prepare_tuolumne_environment() {
  load_tuolumne_modules

  export ROCM_PATH="${ROCM_PATH:-/opt/rocm-6.4.2}"
  if [ -z "${HIPCXX:-}" ] || [ "$(basename "$HIPCXX")" = "hipcc" ]; then
    export HIPCXX="/opt/rocm-6.4.2/llvm/bin/amdclang++"
  fi
  export MPICH_GPU_SUPPORT_ENABLED="${MPICH_GPU_SUPPORT_ENABLED:-1}"
  export HSA_XNACK="${HSA_XNACK:-1}"
  export OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"

  if [ -n "$TPL_DIR" ]; then
    [ -d "$TPL_DIR" ] || fail "TPL directory does not exist: $TPL_DIR. Use --create-tpl-view or pass a valid --tpl-dir."
    export GEOS_TPL_DIR="$TPL_DIR"
    export GEOS_MPM_TPL_DIR="$TPL_DIR"
    log "using minimal TPL dir: $TPL_DIR"
  fi
}

prepare_dane_environment() {
  load_dane_modules

  # Do not let a previous Tuolumne/ROCm environment leak into a Dane CPU configure.
  unset HIPCXX HIPCC HIP_PATH HIP_PLATFORM ROCM_PATH
  unset MPICH_GPU_SUPPORT_ENABLED HSA_XNACK
}

prepare_build_environment() {
  case "$SETUP_MACHINE" in
    tuolumne)
      create_minimal_tpl_view
      prepare_tuolumne_environment
      ;;
    dane)
      if [ "$CREATE_TPL_VIEW" -eq 1 ]; then
        fail "--create-tpl-view is only valid for the Tuolumne build. Use --setup-machine tuolumne, or remove --create-tpl-view."
      fi
      if [ -n "$TPL_DIR" ]; then
        log "ignoring --tpl-dir for Dane CPU setup"
      fi
      prepare_dane_environment
      ;;
  esac
}

configure_and_build() {
  if [ "$SKIP_BUILD" -eq 1 ]; then
    log "skipping CMake configure/build"
    return 0
  fi

  [ -f "$CONFIG_SCRIPT" ] || fail "Missing config script: $CONFIG_SCRIPT"
  [ -f "$HOST_CONFIG" ] || fail "Missing host config: $HOST_CONFIG. Use --host-config or apply the machine host-config patch."

  prepare_build_environment

  run_cmd mkdir -p "$BUILD_ROOT" "$INSTALL_ROOT"
  log "configuring GEOS with $HOST_CONFIG"
  local config_cmd
  config_cmd=("$PYTHON_CMD" "$CONFIG_SCRIPT" \
    --hostconfig "$HOST_CONFIG" \
    --buildtype "$BUILD_TYPE" \
    --installrootdir "$INSTALL_ROOT")
  if [ -n "$BUILD_DIR_OVERRIDE" ]; then
    config_cmd+=(--buildpath "$BUILD_DIR")
  else
    config_cmd+=(--buildrootdir "$BUILD_ROOT")
  fi
  run_cmd "${config_cmd[@]}"

  if [ "$CONFIGURE_ONLY" -eq 1 ]; then
    log "configure-only requested; not building"
    return 0
  fi

  local cmake_cmd
  cmake_cmd=$(detect_cmake)
  log "building target $BUILD_TARGET in $BUILD_DIR"
  run_cmd "$cmake_cmd" --build "$BUILD_DIR" --target "$BUILD_TARGET" -j "$JOBS"

  if [ "$DRY_RUN" -eq 0 ]; then
    if [ -x "$GEOS_EXECUTABLE" ]; then
      log "GEOS executable: $GEOS_EXECUTABLE"
    else
      log "expected GEOS executable was not found yet: $GEOS_EXECUTABLE"
    fi
  fi
}

