+/**
+ * @brief Returns the dimensionless exact signed distance used by the serial
+ * primal weak-interface prototype.
+ */
+real64 SolidMechanicsMPM::primalWeakInterfaceSignedDistance( real64 const x,
+                                                             real64 const y ) const
+{
+  real64 const h = LvArray::math::sqrt( m_hEl[0] * m_hEl[1] );
+  GEOS_ERROR_IF( h <= 0.0, "Invalid grid spacing for primal weak-interface enrichment." );
+
+  if( m_weakInterfacePrimalGeometryType == 1 )
+  {
+    real64 const norm = LvArray::math::sqrt(
+      m_weakInterfacePrimalNormalX * m_weakInterfacePrimalNormalX +
+      m_weakInterfacePrimalNormalY * m_weakInterfacePrimalNormalY );
+    return ( ( x - m_weakInterfacePrimalPointX ) * m_weakInterfacePrimalNormalX +
+             ( y - m_weakInterfacePrimalPointY ) * m_weakInterfacePrimalNormalY ) /
+           ( h * norm );
+  }
+
+  real64 const dx = x - m_weakInterfacePrimalPointX;
+  real64 const dy = y - m_weakInterfacePrimalPointY;
+  return ( LvArray::math::sqrt( dx * dx + dy * dy ) - m_weakInterfacePrimalRadius ) / h;
+}
+
+/**
+ * @brief Maps raw mass, momentum, and internal-force moments for a primal
+ * weak-interface ridge enrichment.
+ *
+ * This first implementation is intentionally serial and host-only. The raw
+ * moments are additive and are the quantities that must eventually be summed
+ * across MPI partitions before nodal mass orthogonalization.
+ */
+void SolidMechanicsMPM::mapPrimalWeakInterfaceToGrid( ParticleManager & particleManager,
+                                                      NodeManager & nodeManager )
+{
+  GEOS_MARK_FUNCTION;
+
+  GEOS_ERROR_IF( MpiWrapper::commSize( MPI_COMM_GEOS ) != 1,
+                 "Primal weak-interface enrichment is currently serial only." );
+
+  arrayView2d< real64 const, nodes::REFERENCE_POSITION_USD > const gridPosition =
+    nodeManager.referencePosition();
+  arrayView2d< real64 const > const gridBackgroundStress =
+    nodeManager.getReference< array2d< real64 > >( viewKeyStruct::gridBackgroundStressString() );
+
+  arrayView1d< real64 > const crossMass =
+    nodeManager.getReference< array1d< real64 > >( viewKeyStruct::gridWeakPrimalCrossMassString() );
+  arrayView1d< real64 > const rawMass =
+    nodeManager.getReference< array1d< real64 > >( viewKeyStruct::gridWeakPrimalRawMassString() );
+  arrayView2d< real64 > const rawMomentum =
+    nodeManager.getReference< array2d< real64 > >( viewKeyStruct::gridWeakPrimalRawMomentumString() );
+  arrayView2d< real64 > const rawInternalForce =
+    nodeManager.getReference< array2d< real64 > >( viewKeyStruct::gridWeakPrimalRawInternalForceString() );
+  arrayView1d< real64 > const mean =
+    nodeManager.getReference< array1d< real64 > >( viewKeyStruct::gridWeakPrimalMeanString() );
+  arrayView1d< real64 > const enrichedMass =
+    nodeManager.getReference< array1d< real64 > >( viewKeyStruct::gridWeakPrimalMassString() );
+  arrayView1d< real64 > const massRatio =
+    nodeManager.getReference< array1d< real64 > >( viewKeyStruct::gridWeakPrimalMassRatioString() );
+  arrayView2d< real64 > const enrichedVelocity =
+    nodeManager.getReference< array2d< real64 > >( viewKeyStruct::gridWeakPrimalVelocityString() );
+  arrayView2d< real64 > const enrichedAcceleration =
+    nodeManager.getReference< array2d< real64 > >( viewKeyStruct::gridWeakPrimalAccelerationString() );
+  arrayView1d< int > const active =
+    nodeManager.getReference< array1d< int > >( viewKeyStruct::gridWeakPrimalActiveString() );
+
+  for( localIndex g = 0; g < nodeManager.size(); ++g )
+  {
+    crossMass[g] = 0.0;
+    rawMass[g] = 0.0;
+    mean[g] = 0.0;
+    enrichedMass[g] = 0.0;
+    massRatio[g] = 0.0;
+    active[g] = 0;
+    for( int i = 0; i < 3; ++i )
+    {
+      rawMomentum[g][i] = 0.0;
+      rawInternalForce[g][i] = 0.0;
+      enrichedVelocity[g][i] = 0.0;
+      enrichedAcceleration[g][i] = 0.0;
+    }
+  }
+
+  localIndex subRegionIndex = 0;
+  particleManager.forParticleSubRegions( [&]( ParticleSubRegion & subRegion )
+  {
+    GEOS_ERROR_IF( subRegion.getParticleType() != ParticleType::SinglePointBSpline,
+                   "Primal weak-interface enrichment supports SinglePointBSpline particles only." );
+
+    arrayView1d< real64 const > const particleMass =
+      subRegion.getField< fields::mpm::particleMass >();
+    arrayView1d< real64 const > const particleVolume = subRegion.getParticleVolume();
+    arrayView2d< real64 const > const particlePosition = subRegion.getParticleCenter();
+    arrayView2d< real64 const > const particleVelocity = subRegion.getParticleVelocity();
+    arrayView2d< real64 const > const particleStress =
+      subRegion.getField< fields::mpm::particleStress >();
+    arrayView1d< real64 const > const particleSupplementalPressure =
+      subRegion.getField< fields::mpm::particleSupplementalPressure >();
+    SortedArrayView< localIndex const > const activeParticleIndices =
+      subRegion.activeParticleIndices();
+
+    arrayView1d< localIndex const > const numEffectiveMappedNodes =
+      m_numEffectiveMappedNodes[subRegionIndex];
+    arrayView2d< localIndex const > const effectiveMappedNodes =
+      m_effectiveMappedNodes[subRegionIndex];
+    arrayView2d< real64 const > const effectiveShapeFunctionValues =
+      m_effectiveShapeFunctionValues[subRegionIndex];
+    arrayView3d< real64 const > const effectiveShapeFunctionGradientValues =
+      m_effectiveShapeFunctionGradientValues[subRegionIndex];
+
+    for( localIndex pp = 0; pp < activeParticleIndices.size(); ++pp )
+    {
+      localIndex const p = activeParticleIndices[pp];
+      localIndex const count = numEffectiveMappedNodes[pp];
+
+      real64 phiH = 0.0;
+      real64 qH = 0.0;
+      real64 gradPhi[3] = {};
+      real64 gradQ[3] = {};
+
+      for( localIndex n = 0; n < count; ++n )
+      {
+        localIndex const g = effectiveMappedNodes[pp][n];
+        real64 const N = effectiveShapeFunctionValues[pp][n];
+        real64 const phiNode = primalWeakInterfaceSignedDistance(
+          gridPosition[g][0], gridPosition[g][1] );
+        real64 const absPhiNode = LvArray::math::abs( phiNode );
+        phiH += N * phiNode;
+        qH += N * absPhiNode;
+        for( int j = 0; j < 2; ++j )
+        {
+          real64 const gradN = effectiveShapeFunctionGradientValues[pp][n][j];
+          gradPhi[j] += gradN * phiNode;
+          gradQ[j] += gradN * absPhiNode;
+        }
+      }
+
+      real64 const phiParticle = primalWeakInterfaceSignedDistance(
+        particlePosition[p][0], particlePosition[p][1] );
+      real64 const side = phiParticle >= 0.0 ? 1.0 : -1.0;
+      real64 const psi = qH - side * phiH;
+      real64 gradPsi[3] = {};
+      for( int j = 0; j < 2; ++j )
+      {
+        gradPsi[j] = gradQ[j] - side * gradPhi[j];
+      }
+
+      real64 const mp = particleMass[p];
+      real64 const Vp = particleVolume[p];
+      real64 const supplementalPressure = particleSupplementalPressure[p];
+
+      for( localIndex n = 0; n < count; ++n )
+      {
+        localIndex const g = effectiveMappedNodes[pp][n];
+        real64 const N = effectiveShapeFunctionValues[pp][n];
+        real64 const weightedRidge = N * psi;
+
+        crossMass[g] += mp * weightedRidge;
+        rawMass[g] += mp * N * psi * psi;
+        for( int i = 0; i < 2; ++i )
+        {
+          rawMomentum[g][i] += mp * weightedRidge * particleVelocity[p][i];
+        }
+
+        real64 gradR[3] = {};
+        for( int j = 0; j < 2; ++j )
+        {
+          gradR[j] = effectiveShapeFunctionGradientValues[pp][n][j] * psi + N * gradPsi[j];
+        }
+
+        real64 const sigmaXX = particleStress[p][0] - gridBackgroundStress[g][0] - supplementalPressure;
+        real64 const sigmaYY = particleStress[p][1] - gridBackgroundStress[g][1] - supplementalPressure;
+        real64 const sigmaXY = particleStress[p][5] - gridBackgroundStress[g][5];
+
+        rawInternalForce[g][0] += -Vp * ( gradR[0] * sigmaXX + gradR[1] * sigmaXY );
+        rawInternalForce[g][1] += -Vp * ( gradR[0] * sigmaXY + gradR[1] * sigmaYY );
+      }
+    }
+
+    ++subRegionIndex;
+  } );
+}
