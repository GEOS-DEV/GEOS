+/**
+ * @brief Orthogonalizes and advances the enriched nodal coefficient.
+ */
+void SolidMechanicsMPM::finalizePrimalWeakInterfaceGrid( real64 const dt,
+                                                         NodeManager & nodeManager )
+{
+  GEOS_MARK_FUNCTION;
+
+  arrayView2d< real64 const > const gridMass =
+    nodeManager.getReference< array2d< real64 > >( viewKeyStruct::gridMassString() );
+  arrayView3d< real64 const > const gridMomentum =
+    nodeManager.getReference< array3d< real64 > >( viewKeyStruct::gridMomentumString() );
+  arrayView3d< real64 const > const gridInternalForce =
+    nodeManager.getReference< array3d< real64 > >( viewKeyStruct::gridInternalForceString() );
+  arrayView3d< real64 const > const gridExternalForce =
+    nodeManager.getReference< array3d< real64 > >( viewKeyStruct::gridExternalForceString() );
+  arrayView3d< real64 const > const gridSurfaceTensionForce =
+    nodeManager.getReference< array3d< real64 > >( viewKeyStruct::gridSurfaceTensionForceString() );
+
+  arrayView1d< real64 const > const crossMass =
+    nodeManager.getReference< array1d< real64 > >( viewKeyStruct::gridWeakPrimalCrossMassString() );
+  arrayView1d< real64 const > const rawMass =
+    nodeManager.getReference< array1d< real64 > >( viewKeyStruct::gridWeakPrimalRawMassString() );
+  arrayView2d< real64 const > const rawMomentum =
+    nodeManager.getReference< array2d< real64 > >( viewKeyStruct::gridWeakPrimalRawMomentumString() );
+  arrayView2d< real64 const > const rawInternalForce =
+    nodeManager.getReference< array2d< real64 > >( viewKeyStruct::gridWeakPrimalRawInternalForceString() );
+  arrayView1d< real64 > const mean =
+    nodeManager.getReference< array1d< real64 > >( viewKeyStruct::gridWeakPrimalMeanString() );
+  arrayView1d< real64 > const enrichedMass =
+    nodeManager.getReference< array1d< real64 > >( viewKeyStruct::gridWeakPrimalMassString() );
+  arrayView1d< real64 > const massRatio =
+    nodeManager.getReference< array1d< real64 > >( viewKeyStruct::gridWeakPrimalMassRatioString() );
+  arrayView2d< real64 > const enrichedVelocity =
+    nodeManager.getReference< array2d< real64 > >( viewKeyStruct::gridWeakPrimalVelocityString() );
+  arrayView2d< real64 > const enrichedAcceleration =
+    nodeManager.getReference< array2d< real64 > >( viewKeyStruct::gridWeakPrimalAccelerationString() );
+  arrayView1d< int > const active =
+    nodeManager.getReference< array1d< int > >( viewKeyStruct::gridWeakPrimalActiveString() );
+
+  for( localIndex g = 0; g < nodeManager.size(); ++g )
+  {
+    real64 const m = gridMass[g][0];
+    if( m <= m_smallMass )
+    {
+      continue;
+    }
+
+    real64 const psiMean = crossMass[g] / m;
+    real64 const me = LvArray::math::max( 0.0, rawMass[g] - crossMass[g] * crossMass[g] / m );
+    real64 const ratio = me / m;
+    mean[g] = psiMean;
+    enrichedMass[g] = me;
+    massRatio[g] = ratio;
+
+    if( ratio <= m_weakInterfacePrimalMinMassRatio || me <= m_smallMass )
+    {
+      continue;
+    }
+
+    active[g] = 1;
+    for( int i = 0; i < 2; ++i )
+    {
+      real64 const standardInternalForce = gridInternalForce[g][0][i];
+      real64 const standardExternalForce =
+        gridExternalForce[g][0][i] + gridSurfaceTensionForce[g][0][i];
+      real64 const standardMomentumBeforeInternalUpdate =
+        gridMomentum[g][0][i] - dt * ( standardInternalForce + standardExternalForce );
+      real64 const enrichedForce = rawInternalForce[g][i] - psiMean * standardInternalForce;
+      real64 const enrichedMomentum = rawMomentum[g][i] - psiMean * standardMomentumBeforeInternalUpdate;
+
+      enrichedAcceleration[g][i] = enrichedForce / me;
+      enrichedVelocity[g][i] = ( enrichedMomentum + dt * enrichedForce ) / me;
+    }
+  }
+}
