		<xsd:attribute name="maxTangentialDisplacement" type="real64" use="required" />
		<!--normalForceConstant => Normal force constant-->
		<xsd:attribute name="normalForceConstant" type="real64" use="required" />
		<!--shearForceConstant => Shear force constant-->
		<xsd:attribute name="shearForceConstant" type="real64" use="required" />
