		<!--name => A name is required for any non-unique nodes-->
		<xsd:attribute name="name" type="groupName" use="required" />
	</xsd:complexType>
	<xsd:complexType name="StrainHardeningPolymerType">
		<!--bulkModulusA => Temperature dependent bulk modulus A parameter-->
		<xsd:attribute name="bulkModulusA" type="real64" default="0" />
		<!--bulkModulusB => Temperature dependent bulk modulus B parameter-->
		<xsd:attribute name="bulkModulusB" type="real64" default="0" />
		<!--bulkModulusT0 => Temperature dependent bulk modulus T0 parameter-->
		<xsd:attribute name="bulkModulusT0" type="real64" default="300" />
		<!--defaultBulkModulus => Default Bulk Modulus Parameter-->
		<xsd:attribute name="defaultBulkModulus" type="real64" default="-1" />
		<!--defaultDensity => Default Material Density-->
		<xsd:attribute name="defaultDensity" type="real64" use="required" />
		<!--defaultDrainedLinearTEC => Default Linear Thermal Expansion Coefficient of the Solid Rock Frame-->
		<xsd:attribute name="defaultDrainedLinearTEC" type="real64" default="0" />
		<!--defaultPoissonRatio => Default Poisson's Ratio-->
		<xsd:attribute name="defaultPoissonRatio" type="real64" default="-1" />
		<!--defaultShearModulus => Default Shear Modulus Parameter-->
		<xsd:attribute name="defaultShearModulus" type="real64" default="-1" />
		<!--defaultYieldStrength => Default yield strength-->
		<xsd:attribute name="defaultYieldStrength" type="real64" default="1.79769e+308" />
		<!--defaultYoungModulus => Default Young's Modulus-->
		<xsd:attribute name="defaultYoungModulus" type="real64" default="-1" />
		<!--maximumStretch => Maximum stretch-->
		<xsd:attribute name="maximumStretch" type="real64" default="1.79769e+308" />
		<!--maximumStretchA => max Stretch A-->
		<xsd:attribute name="maximumStretchA" type="real64" default="0" />
		<!--maximumStretchB => Maximum stretch B-->
		<xsd:attribute name="maximumStretchB" type="real64" default="0" />
		<!--maximumStretchT0 => Maximum stretch T0-->
		<xsd:attribute name="maximumStretchT0" type="real64" default="300" />
		<!--shearModulusA => Temperature dependent shear modulus A parameter-->
		<xsd:attribute name="shearModulusA" type="real64" default="0" />
		<!--shearModulusB => Temperature dependent shear modulus B parameter-->
		<xsd:attribute name="shearModulusB" type="real64" default="0" />
		<!--shearModulusT0 => Temperature dependent shear modulus T0 parameter-->
		<xsd:attribute name="shearModulusT0" type="real64" default="300" />
		<!--shearSofteningMagnitude => Shear softening magnitude-->
		<xsd:attribute name="shearSofteningMagnitude" type="real64" use="required" />
		<!--shearSofteningMagnitudeA => Shear softening magnitude A-->
		<xsd:attribute name="shearSofteningMagnitudeA" type="real64" default="0" />
		<!--shearSofteningMagnitudeB => Shear softening magnitude B-->
		<xsd:attribute name="shearSofteningMagnitudeB" type="real64" default="0" />
		<!--shearSofteningMagnitudeT0 => Shear softening magnitude T0-->
		<xsd:attribute name="shearSofteningMagnitudeT0" type="real64" default="300" />
		<!--shearSofteningShapeParameter1 => Shear softening shape parameter 1-->
		<xsd:attribute name="shearSofteningShapeParameter1" type="real64" use="required" />
		<!--shearSofteningShapeParameter2 => Shear softening shape parameter 2-->
		<xsd:attribute name="shearSofteningShapeParameter2" type="real64" use="required" />
		<!--strainHardeningSlope => Strain hardening slope-->
		<xsd:attribute name="strainHardeningSlope" type="real64" use="required" />
		<!--strainHardeningSlopeA => Strain hardening slope A-->
		<xsd:attribute name="strainHardeningSlopeA" type="real64" default="0" />
		<!--strainHardeningSlopeB => Strain hardening slope B-->
		<xsd:attribute name="strainHardeningSlopeB" type="real64" default="0" />
		<!--strainHardeningSlopeT0 => Strain hardening slope T0-->
		<xsd:attribute name="strainHardeningSlopeT0" type="real64" default="300" />
		<!--yieldStrengthA => Yield strength A-->
		<xsd:attribute name="yieldStrengthA" type="real64" default="0" />
		<!--yieldStrengthB => Yield strength B-->
		<xsd:attribute name="yieldStrengthB" type="real64" default="0" />
		<!--yieldStrengthT0 => Yield strength T0-->
		<xsd:attribute name="yieldStrengthT0" type="real64" default="300" />
		<!--name => A name is required for any non-unique nodes-->
		<xsd:attribute name="name" type="groupName" use="required" />
	</xsd:complexType>
	<xsd:complexType name="UncoupledCohesiveZoneType">
