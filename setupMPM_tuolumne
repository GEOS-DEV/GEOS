#!/usr/bin/env bash
# Configure a fresh GEOS-MPM checkout for LLNL Dane or Tuolumne.
#
# This script creates local MPM convenience files, writes machine-aware Dane and
# Tuolumne userDefs/runClean helpers, then configures and builds the GEOS
# executable for the machine on which setup is run unless --setup-machine is
# supplied. Dane uses the CPU minimal-TPL host-config. Tuolumne uses the
# ROCm/MI300A minimal-TPL host-config.

set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: ./setupMPM_tuolumne [options]

Options:
  --setup-machine MACHINE   Machine to configure/build for: dane or tuolumne.
                            Default: infer from hostname, or GEOS_MPM_SETUP_MACHINE.
  --dane                    Shortcut for --setup-machine dane.
  --tuolumne                Shortcut for --setup-machine tuolumne.
  --python PATH             Python executable used for PFW/config scripts.
                            Default: PFW_PYTHON, PFW_PYTHON_COMMAND,
                            /usr/tce/bin/python3, python3, then python.
  --bank BANK               LC bank/account. Default: infer from mshare,
                            preferring its default bank, then starred bank,
                            then the user leaf bank with largest shares.
  --repo-path PATH          User-facing repo path written to userDefs.py.
                            Default: ~/geosx if it resolves to this checkout,
                            otherwise the logical checkout path.
  --run-root DIR            Active-machine defaultRunDirectory root.
                            Default: /p/lustre1/$USER/geosxRuns on Dane,
                            /p/lustre5/$USER/geosxRuns on Tuolumne.
  --test-dir DIR            Active-machine testRunDirectory.
  --default-run-dir DIR     Active-machine defaultRunDirectory. Default: RUN_ROOT.
  --build-root DIR          Active-machine CMake build root. Default: repo root.
  --build-dir DIR           Explicit active-machine CMake build directory.
                            Default: BUILD_ROOT/build-<host-config>-<type>.
  --geos-path PATH          Explicit active-machine geosx path written to userDefs.py.
                            Default: BUILD_DIR/bin/geosx.
  --tuolumne-build-dir DIR  Tuolumne CMake build directory written to userDefs.py.
                            Default: repo/build-tuolumne-...-mpm-minimal-tpl-release.
  --tuolumne-geos-path PATH Explicit Tuolumne geosx path written to userDefs.py.
                            Default: TUOLUMNE_BUILD_DIR/bin/geosx.
  --tuolumne-run-root DIR   Tuolumne defaultRunDirectory root. Default: /p/lustre5/$USER/geosxRuns
  --tuolumne-test-dir DIR   Tuolumne testRunDirectory. Default: /p/lustre5/$USER/geosxTests
  --tuolumne-default-run-dir DIR
                            Tuolumne defaultRunDirectory. Default: TUOLUMNE_RUN_ROOT
  --dane-build-dir DIR      Dane CMake build directory written to userDefs.py.
                            Default: repo/build-dane-toss_4_x86_64_ib-gcc@12.1.1-mpm-minimal-tpl-release
  --dane-geos-path PATH     Explicit Dane geosx path written to userDefs.py.
                            Default: DANE_BUILD_DIR/bin/geosx.
  --dane-run-root DIR       Dane defaultRunDirectory root. Default: /p/lustre1/$USER/geosxRuns
  --dane-test-dir DIR       Dane testRunDirectory. Default: /p/lustre1/$USER/geosxTests
  --dane-default-run-dir DIR
                            Dane defaultRunDirectory. Default: DANE_RUN_ROOT
  --dane-partition NAME     Dane Slurm partition for runClean_$USER.sh. Default: pdebug
  --slurm-time TIME         Dane Slurm walltime for runClean_$USER.sh. Default: 00:30:00
  --install-root DIR        Active-machine CMake install root.
                            Default: /p/lustre1/$USER/geosxInstalls on Dane,
                            /p/lustre5/$USER/geosxInstalls on Tuolumne.
  --build-type TYPE         CMake build type. Default: Release
  --host-config FILE        Host config. Default: machine-specific minimal-TPL MPM config
  --tpl-dir DIR             Minimal TPL install/view root. If provided, exported as
                            GEOS_TPL_DIR and GEOS_MPM_TPL_DIR before configure.
  --create-tpl-view         Create the minimal TPL view at --tpl-dir before configure.
                            Default TPL dir: /p/lustre5/$USER/geos-tpls/tuolumne-mpm-minimal-rocm-6.4.2
  --queue QUEUE             Tuolumne Flux queue written to runClean_$USER.sh. Default: pdebug
  --flux-time TIME          Tuolumne Flux walltime written to runClean_$USER.sh. Default: 30m
  --jobs N                  Build parallelism. Default: GEOS_BUILD_JOBS or 32
  --build-target TARGET     CMake build target. Default: geosx
  --log-file FILE           Write full setup/configure/build output to FILE.
                            Default: BUILD_DIR/setupMPM_<machine>_<timestamp>.log
  --no-log                  Do not create a setup/build log file.
  --skip-modules            Do not attempt to load Tuolumne ROCm/CMake/Ninja modules.
  --module-purge            Run module purge before loading Tuolumne modules.
  --force                   Replace the symlink and overwrite generated user files.
  --force-link              Replace an existing root particleFileWriter symlink.
  --overwrite-userdefs      Replace particleFileWriter/userDefs_$USER.py.
  --overwrite-runclean      Replace particleFileWriter/runClean_$USER.sh.
  --skip-build, --no-build  Generate local files but do not configure or build.
  --configure-only          Configure CMake but do not build.
  --dry-run                 Print actions without changing files.
  -h, --help                Show this help.
USAGE
}

log() {
  printf '[setupMPM_tuolumne] %s\n' "$*"
}

fail() {
  printf '[setupMPM_tuolumne] ERROR: %s\n' "$*" >&2
  exit 1
}

start_logging() {
  if [ "$DRY_RUN" -eq 1 ] || [ "$NO_LOG" -eq 1 ]; then
    return 0
  fi

  if [ -z "$LOG_FILE" ]; then
    local stamp
    stamp=$(date '+%Y%m%d-%H%M%S')
    LOG_FILE="$BUILD_DIR/setupMPM_${SETUP_MACHINE}_${stamp}.log"
  else
    LOG_FILE=$(abs_path "$LOG_FILE")
  fi

  mkdir -p "$(dirname "$LOG_FILE")"
  : > "$LOG_FILE"
  export GEOS_MPM_SETUP_LOG="$LOG_FILE"

  exec > >(tee -a "$LOG_FILE") 2>&1

  trap 'status=$?; if [ "$status" -eq 0 ]; then printf "[setupMPM_tuolumne] log file: %s\n" "$LOG_FILE"; else printf "[setupMPM_tuolumne] setup failed with exit code %s\n[setupMPM_tuolumne] log file: %s\n" "$status" "$LOG_FILE" >&2; fi; exit "$status"' EXIT

  log "logging to: $LOG_FILE"
  log "hostname: $(hostname 2>/dev/null || true)"
  log "working directory: $(pwd -P)"
  log "date: $(date)"
}

quote_cmd() {
  printf '%q ' "$@"
  printf '\n'
}

run_cmd() {
  if [ "$DRY_RUN" -eq 1 ]; then
    printf '[setupMPM_tuolumne] would run: '
    quote_cmd "$@"
  else
    printf '[setupMPM_tuolumne] running: '
    quote_cmd "$@"
    "$@"
  fi
}

abs_path() {
  local path="$1"
  if [ -d "$path" ]; then
    (cd "$path" && pwd -P)
  else
    local dir base
    dir=$(dirname "$path")
    base=$(basename "$path")
    if [ -d "$dir" ]; then
      (cd "$dir" && printf '%s/%s\n' "$(pwd -P)" "$base")
    else
      case "$path" in
        /*) printf '%s\n' "$path" ;;
        *) printf '%s/%s\n' "$(pwd -P)" "$path" ;;
      esac
    fi
  fi
}

logical_path() {
  local path="$1"
  if [ -d "$path" ]; then
    (cd "$path" && pwd -L)
  else
    local dir base
    dir=$(dirname "$path")
    base=$(basename "$path")
    if [ -d "$dir" ]; then
      (cd "$dir" && printf '%s/%s\n' "$(pwd -L)" "$base")
    else
      case "$path" in
        /*) printf '%s\n' "$path" ;;
        *) printf '%s/%s\n' "$(pwd -L)" "$path" ;;
      esac
    fi
  fi
}

trim_trailing_slashes() {
  local path="$1"
  while [ "${#path}" -gt 1 ] && [ "${path%/}" != "$path" ]; do
    path=${path%/}
  done
  printf '%s\n' "$path"
}

ensure_trailing_slash() {
  local path
  path=$(trim_trailing_slashes "$1")
  if [ "$path" = "/" ]; then
    printf '/\n'
  else
    printf '%s/\n' "$path"
  fi
}

shell_to_display_path() {
  local path
  path=$(trim_trailing_slashes "$1")
  case "$path" in
    "$HOME") printf '~\n' ;;
    "$HOME"/*) printf '~/%s\n' "${path#"$HOME"/}" ;;
    *) printf '%s\n' "$path" ;;
  esac
}

resolve_existing_dir() {
  local path="$1"
  case "$path" in
    '~') path="$HOME" ;;
    '~/'*) path="$HOME/${path#~/}" ;;
  esac
  if [ -d "$path" ]; then
    abs_path "$path"
  else
    return 1
  fi
}

detect_python() {
  local requested="${1:-}"
  local candidates=()
  if [ -n "$requested" ]; then
    candidates+=("$requested")
  fi
  if [ -n "${PFW_PYTHON:-}" ]; then
    candidates+=("$PFW_PYTHON")
  fi
  if [ -n "${PFW_PYTHON_COMMAND:-}" ]; then
    candidates+=("$PFW_PYTHON_COMMAND")
  fi
  candidates+=("/usr/tce/bin/python3" "python3" "python")

  local cmd
  for cmd in "${candidates[@]}"; do
    if [ -z "$cmd" ]; then
      continue
    fi
    if [ -x "$cmd" ]; then
      printf '%s\n' "$cmd"
      return 0
    fi
    if command -v "$cmd" >/dev/null 2>&1; then
      command -v "$cmd"
      return 0
    fi
  done
  fail "Could not find a usable Python executable. Re-run with --python /path/to/python3."
}

detect_pfw_relative_path() {
  local candidates=(
    "scripts/preProcessing/materialPointMethodParticleFileWriter"
    "scripts/preProcessing/mpmParticleFileWriter"
    "scripts/preprocessor/mpmParticleFileWriter"
    "scripts/preprocessor/materialPointMethodParticleFileWriter"
  )
  local rel
  for rel in "${candidates[@]}"; do
    if [ -d "$REPO_ROOT_PHYSICAL/$rel" ]; then
      printf '%s\n' "$rel"
      return 0
    fi
  done
  fail "Could not locate the MPM particle file writer directory."
}

detect_cmake() {
  local cmake_path
  cmake_path=$(awk '/# CMake executable path:/ {print $5; exit}' "$HOST_CONFIG" 2>/dev/null || true)
  if [ -n "$cmake_path" ] && [ -x "$cmake_path" ]; then
    printf '%s\n' "$cmake_path"
    return 0
  fi
  if command -v cmake >/dev/null 2>&1; then
    command -v cmake
    return 0
  fi
  fail "Could not find cmake. Load the Tuolumne build environment or update the host-config."
}

parse_mshare_bank() {
  local input_text="${1:-}"
  MPM_BANK_TEXT="$input_text" "$PYTHON_CMD" - "$LC_USER" <<'PY'
import os
import re
import sys

user = sys.argv[1].lower()
text = os.environ.get('MPM_BANK_TEXT', '')
ansi_re = re.compile(r"\x1b\[[0-9;]*m")
num_re = re.compile(r"[-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][-+]?\d+)?")
name_re = re.compile(r"^[A-Za-z][A-Za-z0-9_.:-]*\*?$")
skip = {
    "account", "accounts", "allocation", "allocations", "bank", "banks",
    "class", "cluster", "default", "fairshare", "group", "name", "norm",
    "normshares", "partition", "project", "projects", "qos", "rawshares",
    "share", "shares", "total", "user", "users", user, "dane", "tuolumne",
    "elcapitan", "root",
}

# mshare commonly prints this line. It is the best default to use.
for raw in text.splitlines():
    line = ansi_re.sub("", raw).strip()
    m = re.search(r"\bDefault\s+bank\s+is\s+([A-Za-z][A-Za-z0-9_.:-]*)\b", line, re.I)
    if m:
        print(m.group(1))
        raise SystemExit

rows = []
starred = []
for raw in text.splitlines():
    clean = ansi_re.sub("", raw.rstrip("\n"))
    if not clean.strip() or clean.lstrip().startswith("#"):
        continue
    tokens = clean.split()
    if not tokens:
        continue
    first = tokens[0]
    first_clean = first.strip(":")
    lower_tokens = [t.strip(":").lower() for t in tokens]
    if "shares" in lower_tokens and "name" in lower_tokens:
        continue
    if not name_re.match(first_clean):
        continue
    name = first_clean.rstrip("*")
    low = name.lower()
    if low in skip:
        continue
    share = None
    for token in tokens[1:]:
        value = token.strip("%,")
        if num_re.fullmatch(value):
            share = float(value)
            break
    if share is None:
        continue
    indent = len(clean) - len(clean.lstrip(" "))
    row = {"indent": indent, "name": name, "share": share, "star": first_clean.endswith("*")}
    rows.append(row)
    if row["star"]:
        starred.append(row)

# In mshare's tree format, the chargeable leaf bank for a user is the nearest
# non-user parent row above the user's row. Choose the largest share among those.
direct_parents = []
for i, row in enumerate(rows):
    if row["name"].lower() != user:
        continue
    for parent in reversed(rows[:i]):
        if parent["indent"] < row["indent"] and parent["name"].lower() != user:
            direct_parents.append(parent)
            break

if starred:
    # If mshare marks a bank with '*', respect that before applying a shares heuristic.
    starred.sort(key=lambda r: (r["share"], r["name"]))
    print(starred[-1]["name"])
elif direct_parents:
    direct_parents.sort(key=lambda r: (r["share"], r["name"]))
    print(direct_parents[-1]["name"])
elif rows:
    # Last-resort heuristic for alternate mshare layouts.
    rows = [r for r in rows if r["name"].lower() not in skip]
    if rows:
        rows.sort(key=lambda r: (r["share"], r["name"]))
        print(rows[-1]["name"])
PY
}

parse_bankinfo_bank() {
  local input_text="${1:-}"
  MPM_BANK_TEXT="$input_text" "$PYTHON_CMD" - "$LC_USER" <<'PY'
import os
import re
import sys

user = sys.argv[1].lower()
text = os.environ.get('MPM_BANK_TEXT', '')
name_re = re.compile(r"^[A-Za-z][A-Za-z0-9_.:-]*\*?$")
skip = {"account", "accounts", "bank", "banks", "class", "cluster", "default", "name", "partition", "qos", "user", user}

marked = []
plain = []
for raw in text.splitlines():
    line = raw.strip()
    if not line or line.startswith("#"):
        continue
    m = re.search(r"\bDefault\s+bank\s+is\s+([A-Za-z][A-Za-z0-9_.:-]*)\b", line, re.I)
    if m:
        print(m.group(1))
        raise SystemExit
    tokens = line.replace(",", " ").split()
    lower_line = line.lower()
    for token in tokens:
        cleaned = token.strip("*:")
        low = cleaned.lower()
        if low in skip or not name_re.match(token.strip(":")):
            continue
        if "default" in lower_line or token.endswith("*"):
            marked.append(cleaned)
        else:
            plain.append(cleaned)
        break

if marked:
    print(marked[0])
elif plain:
    print(plain[0])
PY
}

detect_bank() {
  if [ -n "$REQUESTED_BANK" ]; then
    printf '%s\n' "$REQUESTED_BANK"
    return 0
  fi

  local output parsed
  if command -v mshare >/dev/null 2>&1; then
    output=$(mshare 2>/dev/null || mshare -u "$LC_USER" -p ALL 2>/dev/null || mshare -u "$LC_USER" 2>/dev/null || mshare "$LC_USER" 2>/dev/null || true)
    parsed=$(parse_mshare_bank "$output" || true)
    if [ -n "$parsed" ]; then
      printf '%s\n' "$parsed"
      return 0
    fi
  fi

  if command -v bankinfo >/dev/null 2>&1; then
    output=$(bankinfo -u "$LC_USER" 2>/dev/null || bankinfo 2>/dev/null || true)
    parsed=$(parse_bankinfo_bank "$output" || true)
    if [ -n "$parsed" ]; then
      printf '%s\n' "$parsed"
      return 0
    fi
  fi

  printf '%s\n' "${GEOS_BANK:-}"
}

detect_setup_machine() {
  local requested="${1:-}"
  local value
  if [ -n "$requested" ]; then
    value="$requested"
  elif [ -n "${GEOS_MPM_SETUP_MACHINE:-}" ]; then
    value="$GEOS_MPM_SETUP_MACHINE"
  else
    value=$(hostname 2>/dev/null || uname -n 2>/dev/null || printf '')
  fi

  value=$(printf '%s' "$value" | tr '[:upper:]' '[:lower:]')
  case "$value" in
    dane|dane.*|*dane*)
      printf 'dane\n'
      return 0
      ;;
    tuolumne|tuolumne.*|*tuolumne*|tuo|tuo*)
      printf 'tuolumne\n'
      return 0
      ;;
  esac

  fail "Could not infer setup machine from '$value'. Re-run with --setup-machine dane or --setup-machine tuolumne."
}

choose_repo_command_root() {
  local candidate
  if [ -n "$REQUESTED_REPO_PATH" ]; then
    case "$REQUESTED_REPO_PATH" in
      '~') candidate="$HOME" ;;
      '~/'*) candidate="$HOME/${REQUESTED_REPO_PATH#~/}" ;;
      *) candidate="$REQUESTED_REPO_PATH" ;;
    esac
    [ -d "$candidate" ] || fail "--repo-path does not exist as a directory: $REQUESTED_REPO_PATH"
    [ "$(abs_path "$candidate")" = "$REPO_ROOT_PHYSICAL" ] || fail "--repo-path does not resolve to this checkout: $REQUESTED_REPO_PATH"
    printf '%s\n' "$(trim_trailing_slashes "$candidate")"
    return 0
  fi

  # LLNL users often keep the checkout as ~/geosx, which may be a symlink into /usr/WS1.
  candidate="$HOME/geosx"
  if [ -d "$candidate" ] && [ "$(abs_path "$candidate")" = "$REPO_ROOT_PHYSICAL" ]; then
    printf '%s\n' "$candidate"
    return 0
  fi

  if [ -n "$REPO_ROOT_LOGICAL" ] && [ "$(abs_path "$REPO_ROOT_LOGICAL")" = "$REPO_ROOT_PHYSICAL" ]; then
    printf '%s\n' "$(trim_trailing_slashes "$REPO_ROOT_LOGICAL")"
    return 0
  fi

  printf '%s\n' "$REPO_ROOT_PHYSICAL"
}

create_pfw_link() {
  if [ -L "$PFW_LINK" ]; then
    local current current_abs target_abs
    current=$(readlink "$PFW_LINK")
    current_abs=$(abs_path "$REPO_ROOT_CMD/$current" 2>/dev/null || true)
    target_abs=$(abs_path "$PFW_DIR")
    if [ "$current" = "$PFW_REL" ] || [ "$current_abs" = "$target_abs" ]; then
      log "particleFileWriter symlink already points to $PFW_REL"
      return 0
    fi
    if [ "$FORCE_LINK" -eq 1 ]; then
      run_cmd rm -f "$PFW_LINK"
    else
      fail "$PFW_LINK already points to $current. Use --force-link to replace it."
    fi
  elif [ -e "$PFW_LINK" ]; then
    fail "$PFW_LINK exists and is not a symlink; refusing to replace it."
  fi

  if [ "$DRY_RUN" -eq 1 ]; then
    log "would create symlink $PFW_LINK -> $PFW_REL"
  else
    ln -s "$PFW_REL" "$PFW_LINK"
    log "created symlink $PFW_LINK -> $PFW_REL"
  fi
}

write_user_defs() {
  if [ -e "$USER_DEFS_PATH" ] && [ "$OVERWRITE_USERDEFS" -ne 1 ]; then
    log "leaving existing $USER_DEFS_PATH unchanged; use --overwrite-userdefs to replace it"
    return 0
  fi

  if [ "$DRY_RUN" -eq 1 ]; then
    log "would write $USER_DEFS_PATH"
    log "would set pfwPath = '$PFW_USER_PATH'"
    log "would set Dane geosPath = '$DANE_GEOS_USER_PATH'"
    log "would set Tuolumne geosPath = '$TUOLUMNE_GEOS_USER_PATH'"
    log "would set Dane testRunDirectory = r\"$DANE_TEST_RUN_DIR\""
    log "would set Tuolumne testRunDirectory = r\"$TUOLUMNE_TEST_RUN_DIR\""
    log "would set defaultBank = '$DEFAULT_BANK'"
    return 0
  fi

  cat > "$USER_DEFS_PATH" <<EOF_USERDEFS
# -*- coding: utf-8 -*-
# Auto-generated by setupMPM_tuolumne. Machine-local paths; do not commit.
import os
import platform

_node = platform.node().lower()
node = platform.node()
dane = 'dane' in _node
lassen = 'lassen' in _node
tuolumne = ('tuolumne' in _node) or _node.startswith('tuo')
rzhound = 'rzhound' in _node
tioga = 'tioga' in _node

# Paths used to copy dependencies. Shared by Dane and Tuolumne.
pfwPath = '$PFW_USER_PATH'

# Optional escape hatch for login nodes or unusual node names:
#   export GEOS_MPM_MACHINE=dane
#   export GEOS_MPM_MACHINE=tuolumne
_machine = os.environ.get('GEOS_MPM_MACHINE', '').strip().lower()
if not _machine:
  if dane:
    _machine = 'dane'
  elif tuolumne:
    _machine = 'tuolumne'

if _machine == 'dane':
  geosPath = '$DANE_GEOS_USER_PATH'
  testRunDirectory = r"$DANE_TEST_RUN_DIR"
  defaultRunDirectory = r"$DANE_DEFAULT_RUN_DIR_USER"
  defaultBank = '$DEFAULT_BANK'
  defaultPythonCommand = r"$PYTHON_CMD"
  pythonCommand = defaultPythonCommand
  defaultPython = defaultPythonCommand  # backward-compatible alias

  # Dane/Slurm convenience defaults. Existing PFW inputs can ignore these.
  defaultScheduler = 'slurm'
  defaultSlurmPartition = '$DANE_PARTITION'
  defaultFluxQueue = '$DANE_PARTITION'
  defaultDeviceRanksPerNode = 112
  defaultMpiRanksPerNode = 112

elif _machine == 'tuolumne':
  geosPath = '$TUOLUMNE_GEOS_USER_PATH'
  testRunDirectory = r"$TUOLUMNE_TEST_RUN_DIR"
  defaultRunDirectory = r"$TUOLUMNE_DEFAULT_RUN_DIR_USER"
  defaultBank = '$DEFAULT_BANK'
  defaultPythonCommand = r"$PYTHON_CMD"
  pythonCommand = defaultPythonCommand
  defaultPython = defaultPythonCommand  # backward-compatible alias

  # Tuolumne/Flux convenience defaults. Existing PFW inputs can ignore these.
  defaultScheduler = 'flux'
  defaultFluxQueue = '$DEFAULT_QUEUE'
  defaultSlurmPartition = '$DANE_PARTITION'
  defaultDeviceRanksPerNode = 4
  defaultMpiRanksPerNode = 4

else:
  raise RuntimeError(
    "Could not identify Dane or Tuolumne from host '%s'. "
    "Set GEOS_MPM_MACHINE=dane or GEOS_MPM_MACHINE=tuolumne."
    % node
  )
EOF_USERDEFS
  log "wrote $USER_DEFS_PATH"
}

write_runclean() {
  if [ -e "$RUNCLEAN_PATH" ] && [ "$OVERWRITE_RUNCLEAN" -ne 1 ]; then
    log "leaving existing $RUNCLEAN_PATH unchanged; use --overwrite-runclean to replace it"
    return 0
  fi

  local slurm_account_line flux_account_line
  if [ -n "$DEFAULT_BANK" ]; then
    slurm_account_line="#SBATCH -A $DEFAULT_BANK"
    flux_account_line="#flux: -B $DEFAULT_BANK"
  else
    slurm_account_line="#SBATCH -A CHANGE_ME"
    flux_account_line="#flux: -B CHANGE_ME"
  fi

  if [ "$DRY_RUN" -eq 1 ]; then
    log "would write $RUNCLEAN_PATH"
    return 0
  fi

  cat > "$RUNCLEAN_PATH" <<EOF_RUNCLEAN
#!/bin/bash
#SBATCH -J mpm-pfw-clean
#SBATCH -t $SLURM_TIME
#SBATCH -N 1
@@SLURM_ACCOUNT_LINE@@
#SBATCH -p $DANE_PARTITION
#flux: --job-name=mpm-pfw-clean
#flux: -N 1
#flux: -t $FLUX_TIME
@@FLUX_ACCOUNT_LINE@@
#flux: -q $DEFAULT_QUEUE
#flux: -l

set -euo pipefail

hostName="@@DOLLAR@@(hostname -s 2>/dev/null || hostname)"
hostLower="@@DOLLAR@@(printf '%s' "@@DOLLAR@@hostName" | tr '[:upper:]' '[:lower:]')"
case "@@DOLLAR@@{GEOS_MPM_MACHINE:-}" in
  dane|DANE)
    mpmMachine="dane"
    ;;
  tuolumne|TUOLUMNE)
    mpmMachine="tuolumne"
    ;;
